---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { id } = Astro.params;
const { data: pkg, error } = await supabase.from('absl_packages').select('*').eq('id', id).single();

if (error || !pkg) return Astro.redirect('/services');
---

<Layout title={`${pkg.title} - ABSL`}>
  <div class="container" style="padding: 80px 24px; max-width: 800px;">
    <a href="/services" style="font-family:var(--mono); font-size:12px; color:var(--ink-muted); text-decoration:none;">&larr; Back to Services</a>
    
    <div style="margin-top:32px; background:var(--card-bg); border:1px solid var(--card-border); border-radius:var(--r-lg); padding:48px;">
      <div style="font-family:var(--mono); font-size:11px; text-transform:uppercase; color:var(--violet); margin-bottom:16px;">{pkg.category}</div>
      <h1 style="font-family:var(--display); font-size:3rem; color:var(--ink); margin-bottom:24px; line-height:1.1;">{pkg.title}</h1>
      <p style="color:var(--ink-muted); font-size:1.1rem; line-height:1.8; margin-bottom:48px;">{pkg.description}</p>
      
      <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--line-soft); padding-top:32px; flex-wrap:wrap; gap:24px;">
        <div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--ink-muted); text-transform:uppercase; margin-bottom:4px;">Total Price</div>
          <div style="font-family:var(--mono); font-size:2rem; font-weight:700; color:var(--gold);">₦{Number(pkg.price).toLocaleString()}</div>
        </div>
        
        <button id="add-btn" class="btn btn-primary" style="padding:16px 48px; font-size:1.1rem; background: var(--green); color: white;">
          Add to Cart
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ pkg }}>
    import { addToCart } from '../../scripts/cart';

    document.getElementById('add-btn').addEventListener('click', () => {
      addToCart({
        id: String(pkg.id),
        title: pkg.title,
        price: Number(pkg.price),
        category: pkg.category,
        maxQty: 99
      }, 1);
      
      const btn = document.getElementById('add-btn');
      btn.textContent = '✓ Added to Cart';
      btn.style.background = 'var(--green)';
      setTimeout(() => {
        btn.textContent = 'Add to Cart';
        btn.style.background = 'var(--green)';
      }, 1500);
    });
  </script>
</Layout>