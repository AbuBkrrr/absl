---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

const { data: requests } = await supabase.from('absl_warehouse_requests').select('*').order('created_at', { ascending: false });
const { data: inventory } = await supabase.from('absl_inventory').select('*').order('created_at', { ascending: false });
const { data: profiles } = await supabase.from('absl_profiles').select('id, email');

const reqRows = requests || [];
const invRows = inventory || [];
const userMap = {};
profiles?.forEach(p => userMap[p.id] = p.email);
---

<Layout title="Warehouse Admin - ABSL">
  <AdminGuard />
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Warehouse Manager</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage client requests and assign stored inventory.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <!-- Assign Inventory Form -->
    <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; margin-bottom:32px;">
      <h2 style="font-size:1.2rem; color:var(--gold); margin-bottom:16px;">Assign New Inventory</h2>
      <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:16px; margin-bottom:16px;">
        <div>
          <label style="font-size:11px; color:var(--text-muted);">CLIENT EMAIL</label>
          <select id="f-user" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
            <option value="">Select Client...</option>
            {profiles?.map(p => <option value={p.id}>{p.email}</option>)}
          </select>
        </div>
        <div>
          <label style="font-size:11px; color:var(--text-muted);">SKU / ITEM</label>
          <input id="f-sku" type="text" placeholder="e.g. Cement Bags" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div>
          <label style="font-size:11px; color:var(--text-muted);">QUANTITY</label>
          <input id="f-qty" type="number" placeholder="e.g. 500" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div>
          <label style="font-size:11px; color:var(--text-muted);">LOCATION</label>
          <input id="f-loc" type="text" placeholder="e.g. Warehouse A" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
      </div>
      <button id="assign-btn" class="btn btn-primary">Assign Inventory</button>
    </div>

    <!-- Warehouse Requests Table -->
    <h2 style="font-size:1.5rem; color:var(--white); margin-bottom:16px;">Client Space Requests</h2>
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; margin-bottom:40px;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Client</th>
            <th style="padding:16px; color:var(--gold);">SQM</th>
            <th style="padding:16px; color:var(--gold);">Duration</th>
            <th style="padding:16px; color:var(--gold);">Notes</th>
            <th style="padding:16px; color:var(--gold);">Status</th>
          </tr>
        </thead>
        <tbody>
          {reqRows.map(r => (
            <tr style="border-top:1px solid var(--line-light);">
              <td style="padding:16px; color:var(--white);">{r.customer_email}</td>
              <td style="padding:16px; color:var(--white); font-weight:700;">{r.requested_sqm}</td>
              <td style="padding:16px; color:var(--text-muted);">{r.duration}</td>
              <td style="padding:16px; color:var(--text-muted);">{r.description}</td>
              <td style="padding:16px;"><span style="color:#F59E0B; text-transform:uppercase; font-weight:700;">{r.status}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Current Inventory Table -->
    <h2 style="font-size:1.5rem; color:var(--white); margin-bottom:16px;">Current Stored Inventory</h2>
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Client</th>
            <th style="padding:16px; color:var(--gold);">SKU</th>
            <th style="padding:16px; color:var(--gold);">Qty</th>
            <th style="padding:16px; color:var(--gold);">Location</th>
          </tr>
        </thead>
        <tbody>
          {invRows.map(i => (
            <tr style="border-top:1px solid var(--line-light);">
              <td style="padding:16px; color:var(--white);">{userMap[i.user_id] || 'Unknown'}</td>
              <td style="padding:16px; color:var(--white); font-weight:700;">{i.sku}</td>
              <td style="padding:16px; color:var(--white);">{i.quantity}</td>
              <td style="padding:16px; color:var(--text-muted);">{i.location}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    document.getElementById('assign-btn').addEventListener('click', async () => {
      const btn = document.getElementById('assign-btn');
      const user_id = document.getElementById('f-user').value;
      const sku = document.getElementById('f-sku').value;
      const quantity = Number(document.getElementById('f-qty').value);
      const location = document.getElementById('f-loc').value;

      if (!user_id || !sku || !quantity) return alert('Please fill all fields');
      
      btn.textContent = 'Assigning...'; btn.disabled = true;
      const { error } = await supabase.from('absl_inventory').insert({ user_id, sku, quantity, location });
      
      if (error) { alert(error.message); btn.textContent = 'Assign Inventory'; btn.disabled = false; }
      else { window.location.reload(); }
    });
  </script>
</Layout>