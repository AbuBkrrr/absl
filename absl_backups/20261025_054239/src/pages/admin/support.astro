---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

const { data: messages } = await supabase
  .from('absl_contact_messages')
  .select('*')
  .order('created_at', { ascending: false });

const rows = messages || [];
---

<Layout title="Support Messages - ABSL Admin">
  <AdminGuard />
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Support Messages</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage inquiries from the Contact Us page.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px; min-width: 800px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Date</th>
            <th style="padding:16px; color:var(--gold);">Sender</th>
            <th style="padding:16px; color:var(--gold);">Subject</th>
            <th style="padding:16px; color:var(--gold);">Message</th>
            <th style="padding:16px; color:var(--gold);">Status</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Action</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr><td colspan="6" style="padding:32px; text-align:center; color:var(--text-muted);">No messages yet.</td></tr>
          ) : (
            rows.map(m => (
              <tr style="border-top:1px solid var(--line-light);">
                <td style="padding:16px; color:var(--text-muted); white-space:nowrap;">
                  {new Date(m.created_at).toLocaleDateString()}
                </td>
                <td style="padding:16px;">
                  <div style="color:var(--white); font-weight:600;">{m.full_name}</div>
                  <a href={`mailto:${m.email}`} style="color:var(--gold); font-size:11px; display:block; margin-bottom:4px;">{m.email}</a>
                  {m.whatsapp_number && (
                    <a href={`https://wa.me/${m.whatsapp_number.replace(/[^0-9]/g, '')}`} target="_blank" style="color:#25D366; font-size:11px; font-weight:600;">WhatsApp</a>
                  )}
                </td>
                <td style="padding:16px; color:var(--text-muted);">{m.subject || 'No Subject'}</td>
                <td style="padding:16px; color:var(--text-light); max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={m.message}>
                  {m.message}
                </td>
                <td style="padding:16px;">
                  <span style={`font-size:10px; padding:4px 10px; border-radius:4px; font-weight:700; text-transform:uppercase; background:${m.status === 'read' ? 'rgba(16, 185, 129, 0.15)' : 'rgba(245, 158, 11, 0.15)'}; color:${m.status === 'read' ? '#10B981' : '#F59E0B'};`}>
                    {m.status || 'unread'}
                  </span>
                </td>
                <td style="padding:16px; text-align:right; white-space:nowrap;">
                  <div style="display:flex; gap:8px; justify-content:flex-end; align-items:center;">
                    <button data-email={m.email} data-subject={`Re: ${m.subject || 'Inquiry'}`} data-name={m.full_name} data-message={m.message} class="reply-btn" style="background:rgba(197, 160, 89, 0.15); border:1px solid var(--gold); color:var(--gold); padding:6px 12px; border-radius:4px; font-size:11px; font-weight:600; cursor:pointer;">Reply</button>
                    {m.status !== 'read' ? (
                      <button data-id={m.id} class="mark-read-btn" style="background:transparent; border:1px solid var(--green); color:var(--green); padding:6px 12px; border-radius:4px; cursor:pointer; font-size:11px;">Mark as Read</button>
                    ) : (
                      <span style="color:var(--text-muted); font-size:11px;">✓ Read</span>
                    )}
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Reply Modal -->
  <div id="reply-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; width:100%; max-width:600px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h2 style="color:var(--white); margin:0;">Reply to <span id="reply-to-name" style="color:var(--gold);"></span></h2>
        <button id="close-modal" style="background:none; border:none; color:var(--text-muted); font-size:24px; cursor:pointer;">&times;</button>
      </div>
      
      <div style="margin-bottom:16px;">
        <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">TO</label>
        <input id="reply-email" type="text" readonly style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--text-muted); border-radius:4px;" />
      </div>

      <div style="margin-bottom:16px;">
        <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">SUBJECT</label>
        <input id="reply-subject" type="text" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
      </div>

      <div style="margin-bottom:24px;">
        <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">MESSAGE</label>
        <textarea id="reply-message" rows="6" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;"></textarea>
      </div>

      <div id="reply-error" style="display:none; color:#EF4444; font-size:0.9rem; margin-bottom:16px;"></div>

      <button id="send-reply-btn" class="btn btn-primary" style="width:100%;">Send Email</button>
    </div>
  </div>

  <script>
    let currentOriginalMessage = '';

    document.addEventListener('click', async (e) => {
      const target = e.target;

      // Mark as Read Logic
      if (target.classList.contains('mark-read-btn')) {
        const id = target.dataset.id;
        target.textContent = 'Updating...';
        target.disabled = true;
        try {
          const res = await fetch('/api/contact/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: 'read' })
          });
          if (res.ok) window.location.reload();
        } catch (err) { alert('Error connecting to server.'); }
      }

      // Open Reply Modal
      if (target.classList.contains('reply-btn')) {
        document.getElementById('reply-email').value = target.dataset.email;
        document.getElementById('reply-subject').value = target.dataset.subject;
        document.getElementById('reply-to-name').textContent = target.dataset.name;
        document.getElementById('reply-message').value = `Hi ${target.dataset.name.split(' ')[0]},\n\n`;
        currentOriginalMessage = target.dataset.message;
        
        document.getElementById('reply-modal').style.display = 'flex';
        document.getElementById('reply-error').style.display = 'none';
        document.getElementById('send-reply-btn').textContent = 'Send Email';
        document.getElementById('send-reply-btn').disabled = false;
      }
    });

    // Close Modal
    document.getElementById('close-modal').addEventListener('click', () => {
      document.getElementById('reply-modal').style.display = 'none';
    });

    // Send Reply
    document.getElementById('send-reply-btn').addEventListener('click', async () => {
      const to = document.getElementById('reply-email').value;
      const subject = document.getElementById('reply-subject').value;
      const message = document.getElementById('reply-message').value;
      const btn = document.getElementById('send-reply-btn');
      const errorBox = document.getElementById('reply-error');

      if (!message.trim()) return;

      btn.textContent = 'Sending...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/contact/reply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ to, subject, message, originalMessage: currentOriginalMessage })
        });

        if (!res.ok) throw new Error(await res.text());

        alert('Email sent successfully via Resend!');
        document.getElementById('reply-modal').style.display = 'none';
      } catch (err) {
        errorBox.textContent = 'Failed to send email: ' + err.message;
        errorBox.style.display = 'block';
        btn.textContent = 'Send Email';
        btn.disabled = false;
      }
    });
  </script>
</Layout>