<script>
  import { supabase } from '../lib/supabase';
  (async () => {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { window.location.href = '/login'; return; }
    
    const { data: profile } = await supabase.from('absl_profiles').select('role, is_admin').eq('id', user.id).single();
    
    // If profile is null OR they are a customer, block them
    if (!profile || (profile.role === 'customer' && !profile.is_admin)) {
      alert('Access Denied: You do not have admin privileges.');
      window.location.href = '/';
    }
  })();
</script>