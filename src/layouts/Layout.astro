---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Allstates Business Solutions & Logistics Ltd',
  description = 'Global travel, secure logistics, and premium construction services.'
} = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --bg-main: #0A1128;
            --bg-surface: #121C3E;
            --bg-card: #0F1731;
            --gold: #1E5F9E; /* Logo Royal Blue */
            --gold-hover: #2A73BD;
            --gold-soft: rgba(30, 95, 158, 0.15);
            --white: #FFFFFF;
            --text-muted: #9CA3AF;
            --text-light: #E5E7EB;
            --line: rgba(30, 95, 158, 0.2);
            --line-light: rgba(255, 255, 255, 0.08);
            --font-display: 'Playfair Display', serif;
            --font-body: 'Inter', sans-serif;
            --r-sharp: 2px;
            --r-sm: 4px;
            --r-md: 6px;
            --green: #0F7B4A; /* Logo Emerald Green */
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            overflow-x: hidden;
            background-color: var(--bg-main);
            color: var(--text-light);
            font-family: var(--font-body);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, h5 { font-family: var(--font-display); color: var(--white); font-weight: 600; }
        a { text-decoration: none; color: inherit; transition: 0.2s; }
        .container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

        .btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 32px; font-family: var(--font-body); font-weight: 500; font-size: 0.95rem; letter-spacing: 0.5px; cursor: pointer; border-radius: var(--r-sharp); transition: 0.3s; border: none; }
        .btn-primary { background: var(--gold); color: var(--white); text-transform: uppercase; font-weight: 600; font-size: 0.85rem; letter-spacing: 1px; }
        .btn-primary:hover { background: var(--gold-hover); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(30, 95, 158, 0.2); }
        .btn-outline { background: transparent; color: var(--white); border: 1px solid var(--gold); }
        .btn-outline:hover { background: var(--gold-soft); }

        /* Top Bar */
        .top-bar { background: #050914; padding: 8px 0; border-bottom: 1px solid var(--line-light); font-size: 0.8rem; color: var(--text-muted); }
        .top-bar .container { display: flex; justify-content: space-between; }

        /* Navbar */
        .navbar { position: sticky; top: 0; z-index: 100; background: rgba(10, 17, 40, 0.95); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line-light); padding: 20px 0; }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
        
        .logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
        .logo img { height: 90px; width: auto; object-fit: contain; }
        
        .nav-links { display: flex; gap: 24px; align-items: center; font-size: 0.9rem; font-weight: 500; }
        .nav-links a { color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem; white-space: nowrap; }
        .nav-links a:hover { color: var(--gold); }
        
        .cart-icon { position: relative; display: flex; align-items: center; gap: 8px; color: var(--gold); font-weight: 600; font-size: 0.9rem; white-space: nowrap; flex-shrink: 0; }
        .cart-badge { background: var(--gold); color: var(--white); width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; }

        /* Hamburger Menu */
        .menu-toggle { display: none; }
        .hamburger { display: none; cursor: pointer; font-size: 28px; color: var(--white); }

        /* Footer */
        .footer { background: #050914; border-top: 1px solid var(--line-light); padding: 60px 0 30px; margin-top: 80px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
        .footer h4 { color: var(--gold); font-family: var(--font-body); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 20px; }
        .footer p, .footer a { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 12px; display: block; }
        .footer a:hover { color: var(--gold); }
        .footer-bottom { border-top: 1px solid var(--line-light); padding-top: 24px; text-align: center; color: var(--text-muted); font-size: 0.8rem; }

        /* Responsive Media Queries */
        @media (max-width: 768px) {
            .nav-inner { flex-wrap: wrap; }
            .logo { flex: 1; }
            .logo img { height: 50px; }
            .hamburger { display: block; order: 2; }
            .cart-icon { order: 3; margin-left: 16px; }
            .nav-links { 
                display: none; 
                order: 4; 
                width: 100%; 
                flex-direction: column; 
                align-items: flex-start; 
                gap: 16px; 
                padding: 20px 0; 
                border-top: 1px solid var(--line-light); 
                margin-top: 16px; 
            }
            .menu-toggle:checked ~ .nav-links { display: flex; }
            .footer-grid { grid-template-columns: 1fr; }
            .top-bar .container { flex-direction: column; text-align: center; gap: 8px; }
        }
            /* Mobile Form Overrides */
        @media (max-width: 768px) {
            .hero-search-form {
                flex-direction: column !important;
            }
            .hero-search-form > div {
                border-right: none !important;
                border-bottom: 1px solid var(--line-light);
                width: 100% !important;
            }
            .btn {
                width: 100%;
                max-width: 100%;
                box-sizing: border-box;
            }
        }
            /* ========================================== */
        /* GLOBAL MOBILE RESPONSIVENESS OVERRIDES     */
        /* ========================================== */
        @media (max-width: 768px) {
            /* Force container padding to be smaller */
            .container { padding: 0 16px !important; }

            /* Force ALL inline grids to stack vertically */
            [style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
            }

            /* Ensure flex containers wrap instead of overflowing */
            [style*="display: flex"] {
                flex-wrap: wrap !important;
            }

            /* Fix inputs, textareas, and selects */
            input, textarea, select {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }

            /* Fix huge headings */
            h1 { font-size: clamp(2rem, 6vw, 2.5rem) !important; }
            h2 { font-size: clamp(1.5rem, 5vw, 2rem) !important; }

            /* Force buttons to wrap text and not overflow */
            .btn, button, a[class*="btn"] {
                white-space: normal !important;
                word-wrap: break-word !important;
                max-width: 100% !important;
            }
            
            /* Hide horizontal overflow on wrappers */
            div, section, main {
                max-width: 100vw !important;
                overflow-x: hidden !important;
            }
        }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <div>📍 Lagos • Abuja • London</div>
            <div>📞 +2348033355060 &nbsp;|&nbsp; ✉️ info@absl.com.ng</div>
        </div>
    </div>

    <nav class="navbar">
        <div class="container nav-inner">
            <a href="/" class="logo">
                <img src="/absl-logo.png" alt="ABSL Logo" />
            </a>
            
            <input type="checkbox" id="menu-toggle" class="menu-toggle" />
            <label for="menu-toggle" class="hamburger">☰</label>

                        <div class="nav-links">
                <a href="/">Home</a>
                <a href="/travel">Travel & Tours</a>
                <a href="/logistics">Logistics</a>
                <a href="/construction">Construction</a>
                <a href="/contact">Contact</a>
                <a id="nav-auth-btn" href="/login" style="font-weight: 600; color: var(--gold);">Login</a>
            </div>
            
            <a id="nav-auth-btn" href="/login" style="font-weight:600; font-size:0.9rem; color:var(--gold); white-space:nowrap; margin-right: 16px;">Login</a>`n            <a href="/checkout" class="cart-icon">
                🛒 My Cart
                <span id="cart-badge" class="cart-badge" style="display:none;">0</span>
            </a>
        </div>
    </nav>

    <main><slot /></main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <img src="/absl-logo.png" alt="ABSL Logo" style="height: 60px; width: auto; object-fit: contain; margin-bottom: 16px; border-radius: 4px;" />
                    <p style="margin-top:16px; max-width:300px;">Allstates Business Solutions and Logistics Ltd. Delivering excellence in global travel, secure freight, and infrastructure development.</p>
                </div>
                <div>
                    <h4>Services</h4>
                    <a href="/travel">Travel & Tours</a>
                    <a href="/logistics">Global Logistics</a>
                    <a href="/construction">Building Construction</a>
                    <a href="/services">General Contracts</a>
                </div>
                        <div>
            <h4>Contact</h4>
            <div style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
                <p style="margin-bottom: 16px;">
                    <strong style="color: var(--white);">Head Office:</strong><br>
                    Plot 107/108 Adamu Sidi Ali Street,<br>
                    Idu Industrial Layout, Cadastral Zone C16, Abuja.
                </p>
                <p style="margin-bottom: 16px;">
                    <strong style="color: var(--white);">Branch Office:</strong><br>
                    No 390 Muhammad Buhari Way,<br>
                    Central Business District, Abuja.
                </p>
                <p style="margin-bottom: 8px;">
                    <a href="mailto:info@absl.com.ng" style="color: var(--text-muted);">info@absl.com.ng</a>
                </p>
                <p>
                    <a href="tel:+2348033355060" style="color: var(--text-muted);">+234 803 335 5060</a>
                </p>
            </div>
        </div>
            </div>
            <div class="footer-bottom">
                &copy; {year} Allstates Business Solutions and Logistics Ltd. RC 768315. All rights reserved.
            </div>
        </div>
    </footer>

    <script is:inline>
        function updateBadge() {
            const b = document.getElementById('cart-badge');
            if (!b) return;
            try {
                const cart = JSON.parse(localStorage.getItem('absl_cart') || '[]');
                const n = Math.round(cart.reduce((s, i) => s + Number(i.qty), 0));
                b.textContent = n;
                b.style.display = n > 0 ? 'flex' : 'none';
            } catch (e) {}
        }
        updateBadge();
        window.addEventListener('absl-cart-updated', updateBadge);
    </script>
    <Analytics />
    <script>
      import { supabase } from '../lib/supabase';
      async function updateAuthUI() {
        const { data: { session } } = await supabase.auth.getSession();
        const btn = document.getElementById('nav-auth-btn');
        if (!btn) return;
        if (session) {
          btn.textContent = 'Logout';
          btn.href = '#';
          btn.onclick = async (e) => {
            e.preventDefault();
            await supabase.auth.signOut();
            window.location.href = '/';
          };
        } else {
          btn.textContent = 'Login';
          btn.href = '/login';
          btn.onclick = null;
        }
      }
      updateAuthUI();
    </script>
</body>
</html>