---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}
const { 
  title = 'Allstates Business Solutions & Logistics Ltd', 
  description = 'Global travel, secure logistics, and premium construction services.' 
} = Astro.props;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --bg-main: #0A1128;
            --bg-surface: #121C3E;
            --bg-card: #0F1731;
            --gold: #1E5F9E; 
            --gold-hover: #2A73BD;
            --gold-soft: rgba(30, 95, 158, 0.15);
            --white: #FFFFFF;
            --text-muted: #9CA3AF;
            --text-light: #E5E7EB;
            --line: rgba(30, 95, 158, 0.2);
            --line-light: rgba(255, 255, 255, 0.08);
            --font-display: 'Playfair Display', serif;
            --font-body: 'Inter', sans-serif;
            --r-sharp: 2px;
            --r-sm: 4px;
            --r-md: 6px;
            --green: #0F7B4A;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            background-color: var(--bg-main);
            color: var(--text-light);
            font-family: var(--font-body);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, h4, h5 { font-family: var(--font-display); color: var(--white); font-weight: 600; }
        a { text-decoration: none; color: inherit; transition: 0.2s; }
        .container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
        
        .btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 32px; font-family: var(--font-body); font-weight: 500; font-size: 0.95rem; letter-spacing: 0.5px; cursor: pointer; border-radius: var(--r-sharp); transition: 0.3s; border: none; }
        .btn-primary { background: var(--gold); color: var(--white); text-transform: uppercase; font-weight: 600; font-size: 0.85rem; letter-spacing: 1px; }
        .btn-primary:hover { background: var(--gold-hover); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(30, 95, 158, 0.2); }
        .btn-outline { background: transparent; color: var(--white); border: 1px solid var(--gold); }
        .btn-outline:hover { background: var(--gold-soft); }

        /* Top Bar */
        .top-bar { background: #050914; padding: 8px 0; border-bottom: 1px solid var(--line-light); font-size: 0.8rem; color: var(--text-muted); }
        .top-bar .container { display: flex; justify-content: space-between; }
        
        /* Navbar */
        .navbar { position: sticky; top: 0; z-index: 100; background: rgba(10, 17, 40, 0.95); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line-light); padding: 20px 0; }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
        
        .logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
        .logo img { height: 45px; width: auto; object-fit: contain; }
        
        .nav-links { display: flex; gap: 24px; align-items: center; font-size: 0.9rem; font-weight: 500; }
        .nav-links a { color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem; white-space: nowrap; }
        .nav-links a:hover { color: var(--gold); }
        
        .cart-icon { position: relative; display: flex; align-items: center; gap: 8px; color: var(--gold); font-weight: 600; font-size: 0.9rem; white-space: nowrap; flex-shrink: 0; }
        .cart-badge { background: var(--gold); color: var(--white); width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 700; }

        /* Footer */
        .footer { background: #050914; border-top: 1px solid var(--line-light); padding: 60px 0 30px; margin-top: 80px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
        .footer h4 { color: var(--gold); font-family: var(--font-body); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 20px; }
        .footer p, .footer a { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 12px; display: block; }
        .footer a:hover { color: var(--gold); }
        .footer-bottom { border-top: 1px solid var(--line-light); padding-top: 24px; text-align: center; color: var(--text-muted); font-size: 0.8rem; }
        
                /* Mobile Navigation Drawer */
        .mobile-menu-btn { display: none; background: none; border: none; color: var(--white); font-size: 24px; cursor: pointer; padding: 0; margin-left: 16px; }
        .mobile-drawer { position: fixed; top: 0; right: -100%; width: 280px; height: 100vh; background: var(--bg-surface); z-index: 1000; transition: 0.3s ease-in-out; padding: 24px; display: flex; flex-direction: column; gap: 16px; border-left: 1px solid var(--line-light); box-shadow: -10px 0 30px rgba(0,0,0,0.5); overflow-y: auto; }
        .mobile-drawer.active { right: 0; }
        .mobile-drawer a { color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; font-size: 0.9rem; padding: 12px 0; border-bottom: 1px solid var(--line-light); font-weight: 600; }
        .mobile-drawer a:hover { color: var(--gold); }
        .close-menu { background: none; border: none; color: var(--gold); font-size: 28px; align-self: flex-end; cursor: pointer; margin-bottom: 16px; }

        @media (max-width: 768px) {
            .mobile-menu-btn { display: block; }
            .nav-links { display: none; }
            .footer-grid { grid-template-columns: 1fr; }
            .logo img { height: 36px; }
            .top-bar .container { flex-direction: column; text-align: center; gap: 8px; }
        }
    </style>
</head>
<body>
    <div class="top-bar">
        <div class="container">
            <div>📍 Lagos • Abuja • London</div>
            <div>📞 08033355060 &nbsp;|&nbsp; ✉️ info@absl.com.ng</div>
        </div>
    </div>

    <nav class="navbar">
        <div class="container nav-inner">
            <a href="/" class="logo">
                <img src="/absl-logo.png" alt="ABSL Logo" />
            </a>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/travel">Travel & Tours</a>
                <a href="/logistics">Logistics</a>
                <a href="/construction">Construction</a>
                <a href="/rewards" style="color: var(--gold);">MileageMall</a>
                <a href="/contact">Contact</a>
            </div>
            <button id="menu-btn" class="mobile-menu-btn" aria-label="Open Menu">☰</button>
            <a href="/checkout" class="cart-icon">
                🛒 My Cart
                <span id="cart-badge" class="cart-badge" style="display:none;">0</span>
            </a>
        </div>
    </nav>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-drawer" class="mobile-drawer">
        <button id="close-menu-btn" class="close-menu">✕</button>
        <a href="/">Home</a>
        <a href="/travel">Travel & Tours</a>
        <a href="/logistics">Logistics</a>
        <a href="/construction">Construction</a>
        <a href="/rewards" style="color: var(--gold);">MileageMall Rewards</a>
        <a href="/contact">Contact</a>
    </div>

    <main><slot /></main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <img src="/absl-logo.png" alt="ABSL Logo" style="height: 60px; width: auto; object-fit: contain; margin-bottom: 16px; border-radius: 4px;" />
                    <p style="margin-top:16px; max-width:300px;">Allstates Business Solutions and Logistics Ltd. Delivering excellence in global travel, secure freight, and infrastructure development.</p>
                </div>
                <div>
                    <h4>Services</h4>
                    <a href="/travel">Travel & Tours</a>
                    <a href="/logistics">Global Logistics</a>
                    <a href="/construction">Building Construction</a>
                    <a href="/services">General Contracts</a>
                </div>
                <div>
                    <h4>Contact</h4>
                    <p>Plot 105, Gidan Dan Asabe,<br>Zoo Road, Kano, Nigeria.</p>
                    <p>info@absl.com.ng</p>
                    <p>08033355060</p>
                </div>
            </div>
            <div class="footer-bottom">
                <a href="/admin" title="Admin Access" style="color: var(--text-muted);">&copy; {year} Allstates Business Solutions and Logistics Ltd. RC1855641. All rights reserved.</a>
            </div>
        </div>
    </footer>

    <script>
        import { cartCount } from '../scripts/cart';
        function updateBadge() {
            const b = document.getElementById('cart-badge');
            if (!b) return;
            const n = cartCount();
            b.textContent = n;
            b.style.display = n > 0 ? 'flex' : 'none';
        }
        updateBadge();
        window.addEventListener('absl-cart-updated', updateBadge);

        // Mobile Menu Logic
        const menuBtn = document.getElementById('menu-btn');
        const closeMenuBtn = document.getElementById('close-menu-btn');
        const mobileDrawer = document.getElementById('mobile-drawer');

        if (menuBtn && mobileDrawer && closeMenuBtn) {
            menuBtn.addEventListener('click', () => {
                mobileDrawer.classList.add('active');
                document.body.style.overflow = 'hidden'; // Prevent background scrolling
            });

            closeMenuBtn.addEventListener('click', () => {
                mobileDrawer.classList.remove('active');
                document.body.style.overflow = '';
            });
        }
    </script>
    <Analytics />
</body>
</html>