---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

const { data: messages } = await supabase
  .from('absl_contact_messages')
  .select('*')
  .order('created_at', { ascending: false });

const rows = messages || [];
---

<Layout title="Support Messages - ABSL Admin">
  <AdminGuard />
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Support Messages</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage inquiries from the Contact Us page.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px; min-width: 800px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Date</th>
            <th style="padding:16px; color:var(--gold);">Sender</th>
            <th style="padding:16px; color:var(--gold);">Subject</th>
            <th style="padding:16px; color:var(--gold);">Message</th>
            <th style="padding:16px; color:var(--gold);">Status</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Action</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr><td colspan="6" style="padding:32px; text-align:center; color:var(--text-muted);">No messages yet.</td></tr>
          ) : (
            rows.map(m => (
              <tr style="border-top:1px solid var(--line-light);">
                <td style="padding:16px; color:var(--text-muted); white-space:nowrap;">
                  {new Date(m.created_at).toLocaleDateString()}
                </td>
                <td style="padding:16px;">
                  <div style="color:var(--white); font-weight:600;">{m.full_name}</div>
                  <a href={`mailto:${m.email}`} style="color:var(--gold); font-size:11px; display:block; margin-bottom:4px;">{m.email}</a>
                  {m.whatsapp_number && (
                    <a href={`https://wa.me/${m.whatsapp_number.replace(/[^0-9]/g, '')}?text=Hi ${encodeURIComponent(m.full_name)}, thanks for reaching out to ABSL. How can we help?`} target="_blank" style="color:#25D366; font-size:11px; display:inline-flex; align-items:center; gap:4px; font-weight:600;">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                      WhatsApp
                    </a>
                  )}
                </td>
                <td style="padding:16px; color:var(--text-muted);">{m.subject || 'No Subject'}</td>
                <td style="padding:16px; color:var(--text-light); max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title={m.message}>
                  {m.message}
                </td>
                <td style="padding:16px;">
                  <span style={`font-size:10px; padding:4px 10px; border-radius:4px; font-weight:700; text-transform:uppercase; background:${m.status === 'read' ? 'rgba(16, 185, 129, 0.15)' : 'rgba(245, 158, 11, 0.15)'}; color:${m.status === 'read' ? '#10B981' : '#F59E0B'};`}>
                    {m.status || 'unread'}
                  </span>
                </td>
                <td style="padding:16px; text-align:right; white-space:nowrap;">
                  <div style="display:flex; gap:8px; justify-content:flex-end; align-items:center;">
                    <!-- Reply Button -->
                    <a href={`mailto:${m.email}?subject=Re: ${encodeURIComponent(m.subject || 'Inquiry from ABSL')}&body=Hi ${encodeURIComponent(m.full_name)},%0D%0A%0D%0A`} style="background:rgba(197, 160, 89, 0.15); border:1px solid var(--gold); color:var(--gold); padding:6px 12px; border-radius:4px; font-size:11px; text-decoration:none; font-weight:600; transition: 0.2s;" onmouseover="this.style.background='var(--gold)'; this.style.color='var(--white)'" onmouseout="this.style.background='rgba(197, 160, 89, 0.15)'; this.style.color='var(--gold)'">Reply</a>
                    
                    <!-- Mark as Read Button -->
                    {m.status !== 'read' ? (
                      <button data-id={m.id} class="mark-read-btn" style="background:transparent; border:1px solid var(--green); color:var(--green); padding:6px 12px; border-radius:4px; cursor:pointer; font-size:11px;">Mark as Read</button>
                    ) : (
                      <span style="color:var(--text-muted); font-size:11px;">✓ Read</span>
                    )}
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    document.addEventListener('click', async (e) => {
      const target = e.target;
      if (target.classList.contains('mark-read-btn')) {
        const id = target.dataset.id;
        target.textContent = 'Updating...';
        target.disabled = true;

        try {
          const res = await fetch('/api/contact/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: 'read' })
          });
          
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to update status.');
            target.textContent = 'Mark as Read';
            target.disabled = false;
          }
        } catch (err) {
          alert('Error connecting to server.');
          target.textContent = 'Mark as Read';
          target.disabled = false;
        }
      }
    });
  </script>
</Layout>