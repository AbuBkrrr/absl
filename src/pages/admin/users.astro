---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

// Fetch all profiles and their related bookings to calculate spend
const { data: profiles } = await supabase.from('absl_profiles').select('*');
const { data: bookings } = await supabase.from('absl_bookings').select('customer_email, total_amount');

const rows = (profiles || []).map(p => {
  const userBookings = (bookings || []).filter(b => b.customer_email === p.email);
  const totalSpend = userBookings.reduce((sum, b) => sum + Number(b.total_amount || 0), 0);
  return { ...p, bookingCount: userBookings.length, totalSpend };
});

const roles = [
  { value: 'customer', label: 'Customer (No Access)' },
  { value: 'admin_travel', label: 'Admin: Travel & Tours' },
  { value: 'admin_logistics', label: 'Admin: Logistics' },
  { value: 'admin_construction', label: 'Admin: Construction' },
  { value: 'admin_accounts', label: 'Admin: Accounts' },
  { value: 'admin_support', label: 'Admin: Support' },
  { value: 'admin_tech', label: 'Admin: Tech' },
  { value: 'admin_hr', label: 'Admin: HR' },
  { value: 'admin_warehousing', label: 'Admin: Warehousing' },
  { value: 'manager', label: 'Manager (Full Access)' }
];
---

<Layout title="Registered Users - ABSL Admin">
  <AdminGuard />
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Registered Users</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage customer accounts and department-level admin privileges.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <!-- Summary Cards -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:32px;">
      <div style="background:var(--bg-surface); padding:24px; border-radius:var(--r-md); border:1px solid var(--line-light);">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase;">Total Accounts</div>
        <div style="font-size:2rem; color:var(--white); font-weight:700;">{rows.length}</div>
      </div>
      <div style="background:var(--bg-surface); padding:24px; border-radius:var(--r-md); border:1px solid var(--line-light);">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase;">Admins / Staff</div>
        <div style="font-size:2rem; color:var(--green); font-weight:700;">{rows.filter(r => r.role !== 'customer').length}</div>
      </div>
      <div style="background:var(--bg-surface); padding:24px; border-radius:var(--r-md); border:1px solid var(--line-light);">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase;">Customers</div>
        <div style="font-size:2rem; color:var(--gold); font-weight:700;">{rows.filter(r => !r.role || r.role === 'customer').length}</div>
      </div>
    </div>

    <!-- Users Table -->
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow-x:auto;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px; min-width: 800px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Email</th>
            <th style="padding:16px; color:var(--gold);">Name</th>
            <th style="padding:16px; color:var(--gold); text-align:center;">Bookings</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Spend (₦)</th>
            <th style="padding:16px; color:var(--gold);">Role / Department</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(u => (
            <tr style="border-top:1px solid var(--line-light);">
              <td style="padding:16px; color:var(--white);">{u.email}</td>
              <td style="padding:16px; color:var(--text-muted);">{u.full_name || '—'}</td>
              <td style="padding:16px; text-align:center; color:var(--text-light);">{u.bookingCount}</td>
              <td style="padding:16px; text-align:right; color:var(--gold);">{u.totalSpend.toLocaleString()}</td>
              <td style="padding:16px;">
                <select 
                  data-id={u.id} 
                  class="role-select" 
                  style={`padding:6px 12px; border-radius:4px; background:var(--bg-surface); border:1px solid var(--line-light); color:${u.role && u.role !== 'customer' ? 'var(--green)' : 'var(--text-muted)'}; font-weight:600; cursor:pointer; width:100%; max-width:220px;`}
                >
                  {roles.map(r => (
                    <option value={r.value} selected={(u.role || 'customer') === r.value}>{r.label}</option>
                  ))}
                </select>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    document.querySelectorAll('.role-select').forEach(select => {
      select.addEventListener('change', async (e) => {
        const id = e.target.dataset.id;
        const newRole = e.target.value;
        
        const originalColor = e.target.style.color;
        e.target.style.color = '#F59E0B'; // Orange while saving
        
        // Use browser client for simplicity here
        const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
        const supabase = createClient(
          import.meta.env.PUBLIC_SUPABASE_URL,
          import.meta.env.PUBLIC_SUPABASE_ANON_KEY
        );

        const { error } = await supabase.from('absl_profiles').update({ role: newRole }).eq('id', id);

        if (error) {
          alert('Failed to update role: ' + error.message);
          e.target.style.color = originalColor;
        } else {
          e.target.style.color = newRole === 'customer' ? 'var(--text-muted)' : 'var(--green)';
        }
      });
    });
  </script>
</Layout>