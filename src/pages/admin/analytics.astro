---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

// Fetch all data needed for analytics
const { data: bookings } = await supabase.from('absl_bookings').select('*').order('created_at', { ascending: false });
const { data: packages } = await supabase.from('absl_packages').select('*');
const { data: profiles } = await supabase.from('absl_profiles').select('id, email');

const allBookings = bookings || [];
const allPackages = packages || [];
const allProfiles = profiles || [];

// ---------- Core KPIs ----------
const totalBookings = allBookings.length;
const totalRevenue = allBookings.reduce((s, b) => s + Number(b.total_amount || 0), 0);
const confirmedRevenue = allBookings
  .filter(b => b.booking_status === 'confirmed' || b.booking_status === 'completed')
  .reduce((s, b) => s + Number(b.total_amount || 0), 0);
const pendingRevenue = allBookings
  .filter(b => b.booking_status === 'pending')
  .reduce((s, b) => s + Number(b.total_amount || 0), 0);
const paidRevenue = allBookings
  .filter(b => b.payment_status === 'paid')
  .reduce((s, b) => s + Number(b.total_amount || 0), 0);
const avgOrderValue = totalBookings > 0 ? totalRevenue / totalBookings : 0;

// ---------- Status breakdown ----------
const statusCounts = {
  pending: allBookings.filter(b => b.booking_status === 'pending').length,
  confirmed: allBookings.filter(b => b.booking_status === 'confirmed').length,
  completed: allBookings.filter(b => b.booking_status === 'completed').length,
  cancelled: allBookings.filter(b => b.booking_status === 'cancelled').length,
};
const statusTotal = Object.values(statusCounts).reduce((s, v) => s + v, 0) || 1;

// ---------- Category + service aggregation ----------
const categoryStats: Record<string, { count: number; revenue: number; qty: number }> = {};
const serviceStats: Record<string, { qty: number; revenue: number; title: string; category: string }> = {};

allBookings.forEach((b: any) => {
  const items = Array.isArray(b.items) ? b.items : [];
  items.forEach((item: any) => {
    const cat = (item.category || 'unknown').toLowerCase();
    const title = item.title || 'Unknown Service';
    const qty = Number(item.qty || 0);
    const lineTotal = qty * Number(item.price || 0);

    if (!categoryStats[cat]) categoryStats[cat] = { count: 0, revenue: 0, qty: 0 };
    categoryStats[cat].count += 1;
    categoryStats[cat].revenue += lineTotal;
    categoryStats[cat].qty += qty;

    if (!serviceStats[title]) serviceStats[title] = { qty: 0, revenue: 0, title, category: cat };
    serviceStats[title].qty += qty;
    serviceStats[title].revenue += lineTotal;
  });
});

const categoryRows = Object.keys(categoryStats)
  .map(cat => ({ cat, ...categoryStats[cat] }))
  .sort((a, b) => b.revenue - a.revenue);

const totalCategoryRevenue = categoryRows.reduce((s, r) => s + r.revenue, 0) || 1;

const topServices = Object.values(serviceStats)
  .sort((a, b) => b.revenue - a.revenue)
  .slice(0, 8);

// ---------- 7-day trend ----------
const today = new Date();
const last7 = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(today);
  d.setDate(d.getDate() - (6 - i));
  return d.toISOString().split('T')[0];
});

const dailyStats = last7.map(day => {
  const dayBookings = allBookings.filter(b => typeof b.created_at === 'string' && b.created_at.startsWith(day));
  return {
    day,
    label: new Date(day).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }),
    count: dayBookings.length,
    revenue: dayBookings.reduce((s, b) => s + Number(b.total_amount || 0), 0)
  };
});

const maxDailyRevenue = Math.max(...dailyStats.map(d => d.revenue), 1);

// ---------- Customers / catalog ----------
const uniqueCustomers = new Set(allBookings.map(b => b.customer_email).filter(Boolean)).size;
const registeredUsers = allProfiles.length;
const activePackages = allPackages.filter(p => p.status === 'active').length;
const totalPackages = allPackages.length;

// ---------- Helpers ----------
const fmt = (n: number) => '₦' + Math.round(n).toLocaleString();
const pct = (n: number, total: number) => total > 0 ? Math.round((n / total) * 100) : 0;

const catColors: Record<string, string> = {
  travel: '#1E5F9E',
  logistics: '#0F7B4A',
  construction: '#C5A059',
  unknown: '#6B7280'
};
const catLabels: Record<string, string> = {
  travel: 'Travel & Tours',
  logistics: 'Logistics & Freight',
  construction: 'Construction',
  unknown: 'Other'
};
const statusColors: Record<string, string> = {
  pending: '#C5A059',
  confirmed: '#1E5F9E',
  completed: '#0F7B4A',
  cancelled: '#EF4444'
};
---

<Layout title="Analytics - ABSL Admin">
  <AdminGuard />

  <!-- Header -->
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:2.5rem; margin:0;">Services Rendered — Global Report</h1>
        <p style="color:var(--text-muted); margin-top:8px;">All-time performance across travel, logistics, and construction.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>
  </div>

  <div class="container" style="padding: 40px 24px 80px;">

    <!-- KPI Grid -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:20px; margin-bottom:32px;">

      <div style="background:var(--bg-card); border:1px solid var(--gold); border-radius:var(--r-md); padding:28px;">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Total Revenue (All-time)</div>
        <div style="font-family:var(--font-display); font-size:2rem; color:var(--gold); font-weight:700; line-height:1.1;">{fmt(totalRevenue)}</div>
        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;">{totalBookings} booking{totalBookings === 1 ? '' : 's'}</div>
      </div>

      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:28px;">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Confirmed / Completed Revenue</div>
        <div style="font-family:var(--font-display); font-size:2rem; color:var(--green); font-weight:700; line-height:1.1;">{fmt(confirmedRevenue)}</div>
        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;">{pct(confirmedRevenue, totalRevenue)}% of total</div>
      </div>

      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:28px;">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Pending Revenue</div>
        <div style="font-family:var(--font-display); font-size:2rem; color:var(--gold); font-weight:700; line-height:1.1;">{fmt(pendingRevenue)}</div>
        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;">{statusCounts.pending} awaiting action</div>
      </div>

      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:28px;">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Average Booking Value</div>
        <div style="font-family:var(--font-display); font-size:2rem; color:var(--white); font-weight:700; line-height:1.1;">{fmt(avgOrderValue)}</div>
        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;">per booking</div>
      </div>

      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:28px;">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Paid Revenue</div>
        <div style="font-family:var(--font-display); font-size:2rem; color:var(--green); font-weight:700; line-height:1.1;">{fmt(paidRevenue)}</div>
        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;">{pct(paidRevenue, totalRevenue)}% settled</div>
      </div>

      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:28px;">
        <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Unique Customers</div>
        <div style="font-family:var(--font-display); font-size:2rem; color:var(--white); font-weight:700; line-height:1.1;">{uniqueCustomers}</div>
        <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;">{registeredUsers} registered accounts</div>
      </div>

    </div>

    <!-- 7-Day Trend -->
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; margin-bottom:32px;">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:24px;">
        <div>
          <h2 style="font-size:1.3rem; color:var(--white); margin:0;">Revenue — Last 7 Days</h2>
          <p style="color:var(--text-muted); font-size:0.85rem; margin-top:4px;">Daily booking revenue</p>
        </div>
        <div style="font-family:var(--mono); font-size:12px; color:var(--gold);">
          Peak: {fmt(Math.max(...dailyStats.map(d => d.revenue)))}
        </div>
      </div>

      <div style="display:flex; align-items:flex-end; gap:12px; height:220px; padding-top:20px;">
        {dailyStats.map(d => (
          <div style="flex:1; display:flex; flex-direction:column; align-items:center; height:100%; justify-content:flex-end;">
            <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); margin-bottom:6px;">{d.revenue > 0 ? fmt(d.revenue) : ''}</div>
            <div style={`width:100%; background:linear-gradient(180deg, var(--gold) 0%, #2A73BD 100%); border-radius:4px 4px 0 0; height:${Math.max((d.revenue / maxDailyRevenue) * 100, 2)}%; min-height:4px; transition:0.3s;`} title={`${d.label}: ${fmt(d.revenue)} (${d.count} bookings)`}></div>
            <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); margin-top:8px; text-align:center;">{d.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Status + Category -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px; margin-bottom:32px;">

      <!-- Status breakdown -->
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px;">
        <h2 style="font-size:1.3rem; color:var(--white); margin:0 0 8px;">Booking Status</h2>
        <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:24px;">Across all {totalBookings} bookings</p>

        {Object.entries(statusCounts).map(([status, count]) => (
          <div style="margin-bottom:18px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
              <span style="font-family:var(--mono); font-size:12px; color:var(--text-light); text-transform:uppercase; letter-spacing:1px;">{status}</span>
              <span style="font-family:var(--mono); font-size:12px; color:var(--white); font-weight:700;">{count} · {pct(count, statusTotal)}%</span>
            </div>
            <div style="height:6px; background:var(--bg-surface); border-radius:4px; overflow:hidden;">
              <div style={`height:100%; width:${pct(count, statusTotal)}%; background:${statusColors[status] || '#666'}; border-radius:4px;`}></div>
            </div>
          </div>
        ))}

        {totalBookings === 0 && (
          <div style="text-align:center; padding:20px; color:var(--text-muted); font-size:0.9rem;">No bookings recorded yet.</div>
        )}
      </div>

      <!-- Category breakdown -->
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px;">
        <h2 style="font-size:1.3rem; color:var(--white); margin:0 0 8px;">Revenue by Service Pillar</h2>
        <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:24px;">Split across travel, logistics, construction</p>

        {categoryRows.length === 0 && (
          <div style="text-align:center; padding:20px; color:var(--text-muted); font-size:0.9rem;">No line items yet.</div>
        )}

        {categoryRows.map(row => (
          <div style="margin-bottom:18px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
              <span style="font-family:var(--mono); font-size:12px; color:var(--text-light); text-transform:uppercase; letter-spacing:1px;">{catLabels[row.cat] || row.cat}</span>
              <span style="font-family:var(--mono); font-size:12px; color:var(--gold); font-weight:700;">{fmt(row.revenue)}</span>
            </div>
            <div style="height:6px; background:var(--bg-surface); border-radius:4px; overflow:hidden;">
              <div style={`height:100%; width:${pct(row.revenue, totalCategoryRevenue)}%; background:${catColors[row.cat] || '#666'}; border-radius:4px;`}></div>
            </div>
            <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); margin-top:4px;">{row.qty} units · {row.count} line items</div>
          </div>
        ))}
      </div>

    </div>

    <!-- Top Services -->
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; margin-bottom:32px;">
      <h2 style="font-size:1.3rem; color:var(--white); margin:0 0 8px;">Top Services by Revenue</h2>
      <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:24px;">Most profitable services rendered</p>

      {topServices.length === 0 ? (
        <div style="text-align:center; padding:40px; color:var(--text-muted);">No service line items recorded yet.</div>
      ) : (
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
            <thead>
              <tr style="background:var(--bg-surface); text-align:left;">
                <th style="padding:14px; color:var(--gold);">#</th>
                <th style="padding:14px; color:var(--gold);">Service</th>
                <th style="padding:14px; color:var(--gold);">Pillar</th>
                <th style="padding:14px; color:var(--gold); text-align:right;">Qty Sold</th>
                <th style="padding:14px; color:var(--gold); text-align:right;">Revenue</th>
              </tr>
            </thead>
            <tbody>
              {topServices.map((s, i) => (
                <tr style="border-top:1px solid var(--line-light);">
                  <td style="padding:14px; color:var(--text-muted);">{i + 1}</td>
                  <td style="padding:14px; color:var(--white); font-weight:600;">{s.title}</td>
                  <td style="padding:14px;">
                    <span style={`font-size:10px; padding:3px 10px; border-radius:4px; background:${(catColors[s.category] || '#666')}22; color:${catColors[s.category] || '#999'}; text-transform:uppercase; font-weight:700;`}>{catLabels[s.category] || s.category}</span>
                  </td>
                  <td style="padding:14px; text-align:right; color:var(--text-light);">{s.qty}</td>
                  <td style="padding:14px; text-align:right; color:var(--gold); font-weight:700;">{fmt(s.revenue)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Catalog summary -->
    <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px; display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:20px;">
      <div>
        <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Active Services</div>
        <div style="font-family:var(--font-display); font-size:1.8rem; color:var(--gold); font-weight:700;">{activePackages}</div>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Total Services in Catalog</div>
        <div style="font-family:var(--font-display); font-size:1.8rem; color:var(--white); font-weight:700;">{totalPackages}</div>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Registered Users</div>
        <div style="font-family:var(--font-display); font-size:1.8rem; color:var(--white); font-weight:700;">{registeredUsers}</div>
      </div>
      <div>
        <div style="font-family:var(--mono); font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Bookings Recorded</div>
        <div style="font-family:var(--font-display); font-size:1.8rem; color:var(--white); font-weight:700;">{totalBookings}</div>
      </div>
    </div>

  </div>
</Layout>