---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: bookings } = await supabase
  .from('absl_bookings')
  .select('*')
  .order('created_at', { ascending: false });

const rows = bookings || [];
---

<Layout title="Bookings - ABSL Admin">
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Client Bookings</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage all incoming travel and logistics requests.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Date</th>
            <th style="padding:16px; color:var(--gold);">Client</th>
            <th style="padding:16px; color:var(--gold);">Contact</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Total (₦)</th>
            <th style="padding:16px; color:var(--gold);">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr><td colspan="5" style="padding:32px; text-align:center; color:var(--text-muted);">No bookings yet.</td></tr>
          ) : (
            rows.map(b => (
              <tr style="border-top:1px solid var(--line-light);">
                <td style="padding:16px; color:var(--text-muted);">{new Date(b.created_at).toLocaleDateString()}</td>
                <td style="padding:16px; color:var(--white); font-weight:600;">{b.client_name}</td>
                <td style="padding:16px; color:var(--text-muted);">
                  {b.client_phone}<br/>
                  <span style="font-size:10.5px;">{b.client_email || 'No email'}</span>
                </td>
                <td style="padding:16px; text-align:right; color:var(--gold); font-weight:700;">{Number(b.total_amount).toLocaleString()}</td>
                <td style="padding:16px;">
                  <span style="font-size:10px; padding:4px 10px; border-radius:4px; background:rgba(197,160,89,0.15); color:var(--gold); text-transform:uppercase; font-weight:700;">
                    {b.booking_status}
                  </span>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</Layout>