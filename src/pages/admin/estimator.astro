---
import Layout from '../../layouts/Layout.astro';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Estimator Settings - ABSL Admin">
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:2.5rem; margin:0;">Estimator Settings</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Update base rates for the construction calculator.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>
  </div>

  <div class="container" style="padding: 40px 24px 80px;">
    <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; margin-bottom:32px;">
      
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; border-bottom:1px solid var(--line-light); padding-bottom:16px;">
        <h2 style="font-size:1.4rem; color:var(--gold); margin:0;">Configuration Data</h2>
        <button id="publish-btn" class="btn btn-primary" style="background:var(--gold); color:var(--bg-main); font-weight:700;">🚀 Publish Updates</button>
      </div>

      <div id="settings-form">
        
        <!-- Phase 1 Materials -->
        <h3 style="font-size:1.2rem; color:var(--white); margin-bottom:16px;">Phase 1: Materials</h3>
        <div style="overflow-x:auto; margin-bottom:32px;">
          <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
            <thead>
              <tr style="text-align:left; background:var(--bg-card);">
                <th style="padding:12px; color:var(--text-muted);">Material</th>
                <th style="padding:12px; color:var(--text-muted);">Qty/SQM</th>
                <th style="padding:12px; color:var(--text-muted);">Base Price (₦)</th>
              </tr>
            </thead>
            <tbody id="materials-body"></tbody>
          </table>
        </div>

        <!-- Phase 2 Handover -->
        <h3 style="font-size:1.2rem; color:var(--white); margin-bottom:16px;">Phase 2: Finishing & Handover</h3>
        <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:16px; margin-bottom:32px;">
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Cleaning Rate (₦/sqm)</label>
            <input type="number" id="p2-clean" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Living Room Set (₦)</label>
            <input type="number" id="p2-living" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Bedroom Set (₦)</label>
            <input type="number" id="p2-bedroom" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Kitchen Appliances (₦)</label>
            <input type="number" id="p2-kitchen" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Curtains Rate (₦/sqm)</label>
            <input type="number" id="p2-curtains" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Labor Multiplier (e.g. 0.4)</label>
            <input type="number" step="0.01" id="p2-labor" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Arch Fee Multiplier (e.g. 0.1)</label>
            <input type="number" step="0.01" id="p2-arch" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
        </div>

        <!-- Phase 3 Utilities -->
        <h3 style="font-size:1.2rem; color:var(--white); margin-bottom:16px;">Phase 3: Monthly Utilities</h3>
        <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:16px;">
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Electricity (₦/kWh)</label>
            <input type="number" id="u-elec" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Water (₦/m³)</label>
            <input type="number" id="u-water" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Gas Cylinder (₦)</label>
            <input type="number" id="u-gas" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-size:11px; color:var(--text-muted); margin-bottom:4px;">Waste Disposal (₦)</label>
            <input type="number" id="u-waste" class="setting-input" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
        </div>

      </div>
    </div>
  </div>

  <div id="toast-container" style="position:fixed; bottom:24px; right:24px; z-index:9999; display:flex; flex-direction:column; gap:10px;"></div>

  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    let supabaseClient = null;
    
    // Default fallback data in case DB is empty
    let globalSettings = {
      materials: [
        { id: 'cement', name: 'Cement', unit: 'bags', qtyPerSqm: 0.45, basePrice: 12500 },
        { id: 'rebar', name: 'Rebar', unit: 'tons', qtyPerSqm: 0.018, basePrice: 1250000 },
        { id: 'sand', name: 'Sand', unit: 'tons', qtyPerSqm: 0.040, basePrice: 45000 },
        { id: 'gravel', name: 'Gravel', unit: 'tons', qtyPerSqm: 0.035, basePrice: 55000 },
        { id: 'blocks', name: 'Blocks', unit: 'pcs', qtyPerSqm: 9.5, basePrice: 650 },
        { id: 'roofing', name: 'Roofing Sheets', unit: 'sheets', qtyPerSqm: 0.18, basePrice: 8500 },
        { id: 'timber', name: 'Timber', unit: 'planks', qtyPerSqm: 0.25, basePrice: 4500 },
        { id: 'tiles', name: 'Tiles', unit: 'sqm', qtyPerSqm: 1.08, basePrice: 6500 },
        { id: 'paint', name: 'Paint', unit: 'buckets', qtyPerSqm: 0.045, basePrice: 45000 },
        { id: 'doors', name: 'Doors', unit: 'units', qtyPerSqm: 0.018, basePrice: 85000 },
        { id: 'windows', name: 'Windows', unit: 'units', qtyPerSqm: 0.035, basePrice: 65000 },
        { id: 'electrical', name: 'Electrical Wiring', unit: 'm', qtyPerSqm: 2.8, basePrice: 850 },
        { id: 'plumbing', name: 'Plumbing', unit: 'sqm', qtyPerSqm: 1, basePrice: 12000 }
      ],
      phase2: { cleaningRate: 1500, livingRoomSet: 850000, bedroomSet: 650000, kitchenAppliances: 950000, curtainsRate: 8500, laborMultiplier: 0.40, archFeeMultiplier: 0.10 },
      utilities: { electricityPerKwh: 225, waterPerM3: 350, gasCylinder: 15500, wasteDisposal: 5000 }
    };

    async function getSupabase() {
      if (supabaseClient) return supabaseClient;
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      supabaseClient = createClient(supabaseUrl, supabaseAnonKey);
      return supabaseClient;
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const bgColor = type === 'success' ? 'var(--green)' : (type === 'error' ? '#ef4444' : 'var(--gold)');
      toast.style.cssText = `background: var(--bg-card); border: 1px solid ${bgColor}; color: var(--white); padding: 16px 24px; border-radius: var(--r-md); font-family: var(--font-body); font-weight: 600; box-shadow: 0 10px 30px rgba(0,0,0,0.5);`;
      toast.innerHTML = message;
      container.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }

    function renderForm() {
      const s = globalSettings;
      
      // Render Materials
      const tbody = document.getElementById('materials-body');
      tbody.innerHTML = s.materials.map((m, idx) => `
        <tr style="border-top:1px solid var(--line-light);">
          <td style="padding:12px; color:var(--white);">${m.name}</td>
          <td style="padding:12px;">
            <input type="number" step="0.001" data-index="${idx}" data-field="qtyPerSqm" class="mat-input" value="${m.qtyPerSqm}" style="width:100px; padding:6px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </td>
          <td style="padding:12px;">
            <input type="number" data-index="${idx}" data-field="basePrice" class="mat-input" value="${m.basePrice}" style="width:120px; padding:6px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </td>
        </tr>
      `).join('');

      // Populate Phase 2 & 3
      document.getElementById('p2-clean').value = s.phase2.cleaningRate;
      document.getElementById('p2-living').value = s.phase2.livingRoomSet;
      document.getElementById('p2-bedroom').value = s.phase2.bedroomSet;
      document.getElementById('p2-kitchen').value = s.phase2.kitchenAppliances;
      document.getElementById('p2-curtains').value = s.phase2.curtainsRate;
      document.getElementById('p2-labor').value = s.phase2.laborMultiplier;
      document.getElementById('p2-arch').value = s.phase2.archFeeMultiplier;

      document.getElementById('u-elec').value = s.utilities.electricityPerKwh;
      document.getElementById('u-water').value = s.utilities.waterPerM3;
      document.getElementById('u-gas').value = s.utilities.gasCylinder;
      document.getElementById('u-waste').value = s.utilities.wasteDisposal;
    }

    document.addEventListener('DOMContentLoaded', async () => {
      const supabase = await getSupabase();
      const { data, error } = await supabase.from('absl_estimator_settings').select('*').eq('id', 'default').single();

      if (data && data.settings) {
        globalSettings = data.settings;
      }
      
      renderForm();
    });

    document.getElementById('publish-btn').addEventListener('click', async () => {
      const btn = document.getElementById('publish-btn');
      btn.textContent = 'Publishing...'; btn.disabled = true;

      // Update Materials in memory
      document.querySelectorAll('.mat-input').forEach(input => {
        const idx = input.dataset.index;
        const field = input.dataset.field;
        globalSettings.materials[idx][field] = Number(input.value);
      });

      // Update Phase 2 in memory
      globalSettings.phase2.cleaningRate = Number(document.getElementById('p2-clean').value);
      globalSettings.phase2.livingRoomSet = Number(document.getElementById('p2-living').value);
      globalSettings.phase2.bedroomSet = Number(document.getElementById('p2-bedroom').value);
      globalSettings.phase2.kitchenAppliances = Number(document.getElementById('p2-kitchen').value);
      globalSettings.phase2.curtainsRate = Number(document.getElementById('p2-curtains').value);
      globalSettings.phase2.laborMultiplier = Number(document.getElementById('p2-labor').value);
      globalSettings.phase2.archFeeMultiplier = Number(document.getElementById('p2-arch').value);

      // Update Utilities in memory
      globalSettings.utilities.electricityPerKwh = Number(document.getElementById('u-elec').value);
      globalSettings.utilities.waterPerM3 = Number(document.getElementById('u-water').value);
      globalSettings.utilities.gasCylinder = Number(document.getElementById('u-gas').value);
      globalSettings.utilities.wasteDisposal = Number(document.getElementById('u-waste').value);

      const supabase = await getSupabase();
      
      // Use UPSERT to create the row if it doesn't exist, or update it if it does
      const { error } = await supabase.from('absl_estimator_settings').upsert({ 
        id: 'default', 
        settings: globalSettings,
        updated_at: new Date().toISOString()
      });

      if (error) {
        showToast('Failed to publish: ' + error.message, 'error');
        btn.textContent = '🚀 Publish Updates'; btn.disabled = false;
      } else {
        showToast('✅ Successfully published to Construction page!');
        btn.textContent = '🚀 Publish Updates'; btn.disabled = false;
      }
    });
  </script>
</Layout>