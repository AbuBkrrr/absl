---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

const { data: rates } = await supabase.from('absl_estimator_rates').select('*');
const getVal = (key) => rates?.find(r => r.key === key)?.value || 0;
---

<Layout title="Estimator Rates - ABSL Admin">
  <AdminGuard />
  <div class="container" style="padding: 80px 24px; max-width: 900px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Estimator Rates</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage the live material prices and construction rates.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px;">
      
      <h2 style="font-size:1.2rem; color:var(--gold); margin-bottom:16px;">Material Prices (₦)</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:32px;">
        <div><label style="font-size:11px; color:var(--text-muted);">Cement (per bag)</label><input id="cement_price" type="number" value={getVal('cement_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Rebar (per ton)</label><input id="rebar_price" type="number" value={getVal('rebar_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Sand (per ton)</label><input id="sand_price" type="number" value={getVal('sand_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Gravel (per ton)</label><input id="gravel_price" type="number" value={getVal('gravel_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Blocks (per piece)</label><input id="blocks_price" type="number" value={getVal('blocks_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Roofing (per sheet)</label><input id="roofing_price" type="number" value={getVal('roofing_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Timber (per plank)</label><input id="timber_price" type="number" value={getVal('timber_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Tiles (per sqm)</label><input id="tiles_price" type="number" value={getVal('tiles_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Paint (per bucket)</label><input id="paint_price" type="number" value={getVal('paint_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Doors (per unit)</label><input id="doors_price" type="number" value={getVal('doors_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Windows (per unit)</label><input id="windows_price" type="number" value={getVal('windows_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Electrical (per meter)</label><input id="electrical_price" type="number" value={getVal('electrical_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Plumbing (per unit)</label><input id="plumbing_price" type="number" value={getVal('plumbing_price')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
      </div>

      <h2 style="font-size:1.2rem; color:var(--gold); margin-bottom:16px;">Labor Rates (₦ per sqm)</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:32px;">
        <div><label style="font-size:11px; color:var(--text-muted);">Basic Build</label><input id="rate_basic" type="number" value={getVal('rate_basic')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Mid-Range Build</label><input id="rate_mid" type="number" value={getVal('rate_mid')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div><label style="font-size:11px; color:var(--text-muted);">Luxury Build</label><input id="rate_luxury" type="number" value={getVal('rate_luxury')} style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
      </div>

      <button id="save-rates-btn" class="btn btn-primary">Save All Rates</button>
      <div id="rates-msg" style="display:none; margin-top:16px; padding:12px; text-align:center; border-radius:4px; font-size:0.9rem;"></div>
    </div>
  </div>

  <script>
    document.getElementById('save-rates-btn').addEventListener('click', async () => {
      const btn = document.getElementById('save-rates-btn');
      const msg = document.getElementById('rates-msg');
      btn.textContent = 'Saving...';
      btn.disabled = true;

      const keys = ['cement_price', 'rebar_price', 'sand_price', 'gravel_price', 'blocks_price', 'roofing_price', 'timber_price', 'tiles_price', 'paint_price', 'doors_price', 'windows_price', 'electrical_price', 'plumbing_price', 'rate_basic', 'rate_mid', 'rate_luxury'];
      
      const updates = keys.map(key => ({
        key: key,
        value: Number(document.getElementById(key).value)
      }));

      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

      const { error } = await supabase.from('absl_estimator_rates').upsert(updates);

      if (error) {
        msg.style.display = 'block';
        msg.style.background = 'rgba(239, 68, 68, 0.1)';
        msg.style.color = '#EF4444';
        msg.style.border = '1px solid #EF4444';
        msg.textContent = 'Error: ' + error.message;
        btn.textContent = 'Save All Rates';
        btn.disabled = false;
      } else {
        msg.style.display = 'block';
        msg.style.background = 'rgba(16, 185, 129, 0.1)';
        msg.style.color = '#10B981';
        msg.style.border = '1px solid #10B981';
        msg.textContent = 'Rates updated successfully!';
        btn.textContent = 'Save All Rates';
        btn.disabled = false;
      }
    });
  </script>
</Layout>