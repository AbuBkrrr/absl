---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
import { supabase } from '../../lib/supabase';

const { data: projects } = await supabase.from('absl_projects').select('*').order('created_at', { ascending: false });
const rows = projects || [];
---

<Layout title="Manage Portfolio - ABSL Admin">
  <AdminGuard />
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Manage Portfolio</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Add and manage your recent construction projects.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <!-- Add Project Form -->
    <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; margin-bottom:32px;">
      <h2 style="font-size:1.2rem; color:var(--gold); margin-bottom:16px;">Add New Project</h2>
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:16px;">
        <input id="f-title" type="text" placeholder="Project Title (e.g. Lekki Penthouse)" style="padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        <select id="f-category" style="padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
          <option value="Residential">Residential</option>
          <option value="Commercial">Commercial</option>
          <option value="Infrastructure">Infrastructure</option>
        </select>
      </div>
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:16px;">
        <input id="f-team" type="text" placeholder="Team Members (comma separated)" style="padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        <input id="f-date" type="text" placeholder="Date (e.g. Oct 2026)" style="padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
      </div>
      <div style="margin-bottom:16px;">
        <input id="f-img" type="text" placeholder="Image URL (e.g. https://images.unsplash.com/photo-...)" style="width:100%; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
      </div>
      <textarea id="f-desc" placeholder="Project Description" style="width:100%; margin-bottom:16px; padding:10px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px; min-height:80px;"></textarea>
      
      <button id="save-btn" class="btn btn-primary">Add Project</button>
    </div>

    <!-- Projects List -->
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:24px;">
      {rows.map(p => (
        <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
          <img src={p.image_url || 'https://via.placeholder.com/400x200'} style="width:100%; height:180px; object-fit:cover;" />
          <div style="padding:20px;">
            <div style="font-size:10px; color:var(--gold); text-transform:uppercase; font-weight:700;">{p.category}</div>
            <h3 style="font-size:1.2rem; color:var(--white); margin:8px 0;">{p.title}</h3>
            <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:16px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">{p.description}</p>
            <button data-del={p.id} class="del-btn" style="background:transparent; border:1px solid #ef4444; color:#ef4444; padding:6px 12px; border-radius:4px; cursor:pointer; font-size:11px; width:100%;">Delete Project</button>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    document.getElementById('save-btn').addEventListener('click', async () => {
      const title = document.getElementById('f-title').value;
      const category = document.getElementById('f-category').value;
      const team_members = document.getElementById('f-team').value;
      const project_date = document.getElementById('f-date').value;
      const image_url = document.getElementById('f-img').value;
      const description = document.getElementById('f-desc').value;

      if (!title || !description) return alert('Title and Description are required.');

      const btn = document.getElementById('save-btn');
      btn.textContent = 'Saving...';
      btn.disabled = true;

      // Using the browser client directly for simplicity in admin
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const { error } = await supabase.from('absl_projects').insert({
        title, category, team_members, project_date, image_url, description
      });

      if (error) {
        alert(error.message);
        btn.textContent = 'Add Project';
        btn.disabled = false;
      } else {
        window.location.reload();
      }
    });

    document.addEventListener('click', async (e) => {
      if (e.target.classList.contains('del-btn')) {
        if (!confirm('Delete this project?')) return;
        const id = e.target.dataset.del;
        const res = await fetch('/api/portfolio/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        if (res.ok) window.location.reload();
      }
    });
  </script>
</Layout>