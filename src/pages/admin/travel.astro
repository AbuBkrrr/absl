---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: bookings } = await supabase.from('absl_travel_bookings').select('*').order('created_at', { ascending: false });
const rows = bookings || [];
---

<Layout title="Travel Bookings - ABSL Admin">
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:2.5rem; margin:0;">Travel & Tour Requests</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage incoming flight, hotel, visa, and car hire requests.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>
  </div>

  <div class="container" style="padding: 40px 24px 80px;">
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Date</th>
            <th style="padding:16px; color:var(--gold);">Service</th>
            <th style="padding:16px; color:var(--gold);">Customer</th>
            <th style="padding:16px; color:var(--gold);">Contact</th>
            <th style="padding:16px; color:var(--gold);">Details</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr><td colspan="6" style="padding:32px; text-align:center; color:var(--text-muted);">No travel requests yet.</td></tr>
          ) : (
            rows.map(b => (
              <tr style="border-top:1px solid var(--line-light);">
                <td style="padding:16px; color:var(--text-muted);">{new Date(b.created_at).toLocaleDateString()}</td>
                <td style="padding:16px; color:var(--gold); font-weight:600;">{b.service_type}</td>
                <td style="padding:16px; color:var(--white);">{b.customer_name}</td>
                <td style="padding:16px; color:var(--text-muted);">
                  {b.customer_email}<br/>
                  <span style="font-size:11px;">{b.customer_phone}</span>
                </td>
                <td style="padding:16px; color:var(--text-light); font-size:11px; max-width: 250px; white-space: pre-wrap;">
                  {Object.entries(b.details).map(([key, val]) => `${key}: ${val}`).join('\n')}
                </td>
                <td style="padding:16px; text-align:right;">
                  <span style="font-size:10px; padding:4px 10px; border-radius:4px; background:var(--bg-surface); color:var(--gold); text-transform:uppercase; font-weight:700;">
                    {b.status}
                  </span>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</Layout>