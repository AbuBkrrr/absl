---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: packages } = await supabase
  .from('absl_packages')
  .select('*')
  .order('created_at', { ascending: false });

const rows = packages || [];
---

<Layout title="Services - ABSL Admin">
  <div class="container" style="padding: 80px 24px;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:32px;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Manage Services</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage travel, logistics, and construction packages.</p>
      </div>
      <a href="/admin" class="btn btn-outline" style="padding:10px 24px;">&larr; Back to Admin</a>
    </div>

    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">Category</th>
            <th style="padding:16px; color:var(--gold);">Title</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Price (₦)</th>
            <th style="padding:16px; color:var(--gold);">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr><td colspan="4" style="padding:32px; text-align:center; color:var(--text-muted);">No services found.</td></tr>
          ) : (
            rows.map(p => (
              <tr style="border-top:1px solid var(--line-light);">
                <td style="padding:16px; color:var(--gold); text-transform:uppercase; font-size:10px;">{p.category}</td>
                <td style="padding:16px; color:var(--white); font-weight:600;">{p.title}</td>
                <td style="padding:16px; text-align:right; color:var(--white); font-weight:700;">{Number(p.price).toLocaleString()}</td>
                <td style="padding:16px;">
                  <span style="font-size:10px; padding:4px 10px; border-radius:4px; background:var(--bg-surface); color:var(--text-muted); text-transform:uppercase;">
                    {p.status}
                  </span>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</Layout>