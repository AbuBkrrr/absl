---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
---

<Layout title="Admin Dashboard - ABSL">
  <AdminGuard />
  
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display:flex; justify-content:space-between; align-items:flex-end;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Admin Control Center</h1>
        <p id="welcome-text" style="color:var(--text-muted); margin-top:8px;">Loading dashboard...</p>
      </div>
      <a href="/" class="btn btn-outline" style="padding:10px 24px;">&larr; View Site</a>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px;">
    <div id="admin-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:24px; opacity: 0; transition: opacity 0.3s;">
      
      <!-- ANALYTICS -->
      <a href="/admin/analytics" data-tab="analytics" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">📊</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Analytics</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Global report of services rendered: revenue, service mix, and status breakdown.</p>
      </a>

      <!-- BOOKINGS -->
      <a href="/admin/bookings" data-tab="bookings" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">📦</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Manage Bookings</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">View all travel & logistics bookings. Update statuses.</p>
      </a>

      <!-- SERVICES -->
      <a href="/admin/services" data-tab="services" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">✈️</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Manage Services</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Add new packages (travel, logistics, construction) to the catalog.</p>
      </a>

      <!-- PORTFOLIO -->
      <a href="/admin/portfolio" data-tab="portfolio" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏗️</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Portfolio CMS</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Add, edit, or delete construction project cards shown on /construction.</p>
      </a>

      <!-- SUPPORT -->
      <a href="/admin/support" data-tab="support" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">📬</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Support Messages</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">View inquiries and messages submitted via the Contact Us page.</p>
      </a>

      <!-- USERS -->
      <a href="/admin/users" data-tab="users" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">👥</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Users & Admins</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">List registered customers, view their lifetime spend, and manage roles.</p>
      </a>

      <!-- LOYALTY -->
      <a href="/admin/loyalty" data-tab="loyalty" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏆</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Loyalty Manager</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Manually add airline miles for clients by email address.</p>
      </a>

      <!-- ESTIMATOR -->
      <a href="/admin/estimator" data-tab="estimator" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">📐</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Estimator Rates</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Update base material prices, labor multipliers, and utility rates.</p>
      </a>

      <!-- SETTINGS -->
      <a href="/admin/settings" data-tab="settings" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">⚙️</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Platform Settings</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Manage calculator rates, shipping multipliers, and global variables.</p>
      </a>

      <!-- WAREHOUSE -->
      <a href="/admin/warehouse" data-tab="warehouse" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--gold); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold-hover)'" onmouseout="this.style.borderColor='var(--gold)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏭</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Warehouse</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Approve client requests and assign inventory to their accounts.</p>
      </a>

      <!-- SHIPMENTS -->
      <a href="/admin/shipments" data-tab="shipments" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🚢</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Shipment Tracking</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Create tracking numbers and update the live status timeline.</p>
      </a>

      <!-- TRAVEL -->
      <a href="/admin/travel" data-tab="travel" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">✈️</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Travel & Tours</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Manage incoming flight bookings, hotel reservations, and visa applications.</p>
      </a>

      <!-- REWARDS -->
      <a href="/admin/rewards" data-tab="rewards" class="admin-card" style="display:none; background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 32px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏆</div>
        <h2 style="font-size: 1.3rem; color: var(--white); margin-bottom: 8px;">Rewards Manager</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Update MileageMall multipliers, add new airline partners.</p>
      </a>

    </div>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    async function loadDashboard() {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return; // AdminGuard will handle redirect

      const { data: profile } = await supabase.from('absl_profiles').select('role, is_admin').eq('id', user.id).single();
      
      const role = profile?.role || (profile?.is_admin ? 'manager' : 'customer');
      
      const welcomeEl = document.getElementById('welcome-text');
      if (welcomeEl) {
        welcomeEl.textContent = `Welcome back, ${role.replace('admin_', '').replace('_', ' ').toUpperCase()}`;
      }

      let allowedTabs = [];
      if (role === 'manager' || role === 'admin') {
        allowedTabs = ['analytics', 'bookings', 'services', 'loyalty', 'users', 'portfolio', 'support', 'shipments', 'warehouse', 'travel', 'rewards', 'estimator', 'settings'];
      } else if (role !== 'customer') {
        const { data: perms } = await supabase.from('absl_role_permissions').select('allowed_tabs').eq('role_name', role).single();
        allowedTabs = perms?.allowed_tabs || ['analytics', 'bookings', 'services', 'loyalty', 'users', 'portfolio', 'support', 'shipments', 'warehouse', 'travel', 'rewards', 'estimator', 'settings'];
      }

      document.querySelectorAll('.admin-card').forEach(card => {
        const tabName = card.getAttribute('data-tab');
        if (allowedTabs.includes(tabName)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });

      const grid = document.getElementById('admin-grid');
      if (grid) grid.style.opacity = '1';
    }

    loadDashboard();
  </script>
</Layout>