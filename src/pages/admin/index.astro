---
import Layout from '../../layouts/Layout.astro';
import AdminGuard from '../../components/AdminGuard.astro';
---
<Layout title="Admin Dashboard - ABSL">
  <AdminGuard />
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;">
      <div>
        <h1 style="font-size:2.5rem; margin:0;">Admin Control Center</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Manage ABSL bookings, services, loyalty, and analytics.</p>
      </div>
      <a href="/" class="btn btn-outline" style="padding:10px 24px;">&larr; View Site</a>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:24px;">

      <a href="/admin/analytics" style="background: var(--bg-card); border: 1px solid var(--gold); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold-hover)'" onmouseout="this.style.borderColor='var(--gold)'">
        <div style="font-size: 32px; margin-bottom: 16px;">📊</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Analytics</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Global report of services rendered: revenue, service mix, status breakdown, top sellers.</p>
        <span style="display:inline-block; margin-top:16px; font-size:0.8rem; color:var(--gold); font-weight:700; text-transform:uppercase; letter-spacing:1px;">View Report &rarr;</span>
      </a>

      <a href="/admin/bookings" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">📦</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Manage Bookings</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">View all travel & logistics bookings. Update status: pending, confirmed, completed, or cancelled.</p>
      </a>

      <a href="/admin/services" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">✈️</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Manage Services</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Add new packages (travel, logistics, construction) or delete existing ones from the catalog.</p>
      </a>

      <a href="/admin/loyalty" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏆</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Loyalty Manager</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Manually add airline miles for clients by email address. View all reward records.</p>
      </a>

          <a href="/admin/users" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">👥</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Users & Admins</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">List registered customers, view their lifetime spend, promote/demote admins.</p>
      </a>

      <a href="/admin/portfolio" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏗️</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Portfolio CMS</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Add, edit, or delete construction project cards shown on /construction.</p>
      </a>

      <a href="/admin/shipments" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🚢</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Shipment Tracking</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Create tracking numbers and update the live status timeline for customers.</p>
      </a>
      <a href="/admin/warehouse" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏢</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Warehouse</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Add inbound stock, manage SKUs, and fulfill customer orders from the 3PL inventory.</p>
      </a>
      <a href="/admin/travel" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">✈️</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Travel & Tours</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Manage incoming flight bookings, hotel reservations, and visa applications.</p>
      </a>
      <a href="/admin/rewards" style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 40px; text-decoration: none; transition: 0.2s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
        <div style="font-size: 32px; margin-bottom: 16px;">🏆</div>
        <h2 style="font-size: 1.5rem; color: var(--white); margin-bottom: 8px;">Rewards Manager</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">Update MileageMall multipliers, add new airline partners, and manage deals.</p>
      </a>
</div>
  </div>
</Layout>