---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Booking Submitted - ABSL">
  <div class="container" style="padding: 80px 24px; text-align: center; max-width: 560px;">
    <div style="font-size: 64px; margin-bottom: 16px;">✅</div>
    <h1 style="font-family: var(--display); font-size: 2rem; margin: 0 0 12px 0;">Order Received</h1>
    <p style="color: var(--ink-muted); line-height: 1.6; margin-bottom: 24px;">
      ABSL will contact you within 24 hours to confirm your booking and arrange payment. Keep your phone nearby.
    </p>
    <a href="/products" class="btn btn-primary">Continue Shopping</a>
  </div>
</Layout>