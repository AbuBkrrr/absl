---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Checkout - ABSL">
  <div class="container" style="padding: 60px 24px; max-width: 1000px;">
    <h1 style="font-size:2.5rem; color:var(--white); margin-bottom:8px;">Checkout</h1>
    <p style="color:var(--text-muted); margin-bottom:40px;">Review your order and submit. ABSL Admin will contact you to complete payment.</p>

    <!-- Cart Items Container -->
    <div id="cart-items" style="display:flex; flex-direction:column; gap:16px; margin-bottom:40px;">
      <!-- Rendered by JS -->
    </div>

    <!-- Empty State -->
    <div id="empty-cart" style="display:none; text-align:center; padding:60px; background:var(--bg-card); border:1px dashed var(--line); border-radius:var(--r-md);">
      <p style="color:var(--text-muted); margin-bottom:16px;">Your cart is empty.</p>
      <a href="/" class="btn btn-primary">Return to Homepage</a>
    </div>

    <!-- Checkout Form -->
    <div id="checkout-form" style="display:none; background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:40px;">
      <h2 style="font-size:1.5rem; color:var(--gold); margin-bottom:24px;">Customer Details</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
        <div>
          <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">FULL NAME *</label>
          <input id="f-name" type="text" required style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div>
          <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">PHONE *</label>
          <input id="f-phone" type="tel" required style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
        <div>
          <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">EMAIL</label>
          <input id="f-email" type="email" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div>
          <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">DELIVERY LOCATION</label>
          <input id="f-location" type="text" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
      </div>
      <div style="margin-bottom:24px;">
        <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">NOTES / SPECIAL INSTRUCTIONS</label>
        <textarea id="f-notes" rows="3" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;"></textarea>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--line-light); padding-top:24px;">
        <div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--text-muted); text-transform:uppercase;">Total</div>
          <div id="cart-total" style="font-family:var(--mono); font-size:2rem; font-weight:700; color:var(--gold);">₦0</div>
        </div>
        <button id="submit-btn" class="btn btn-primary" style="padding:16px 48px; font-size:1.1rem;">Submit Booking</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseAnonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
        window.removeItem = function(id) {
      let cart = JSON.parse(localStorage.getItem('absl_cart') || '[]');
      cart = cart.filter(item => String(item.id) !== String(id));
      localStorage.setItem('absl_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('absl-cart-updated'));
      window.location.reload();
    };
    (() => {
      let cart = [];
      try {
        const rawCart = localStorage.getItem('absl_cart');
        const parsed = JSON.parse(rawCart || '[]');
        cart = Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        cart = [];
      }
      const itemsContainer = document.getElementById('cart-items');
      const emptyCart = document.getElementById('empty-cart');
      const checkoutForm = document.getElementById('checkout-form');
      const totalEl = document.getElementById('cart-total');

      if (cart.length === 0) {
        emptyCart.style.display = 'block';
        checkoutForm.style.display = 'none';
        return;
      }

      emptyCart.style.display = 'none';
      checkoutForm.style.display = 'block';

      let total = 0;
              itemsContainer.innerHTML = cart.map(item => {
          const cleanQty = Math.round(Number(item.qty) * 100) / 100; // Round to 2 decimals
          const subtotal = Number(item.price) * cleanQty;
          total += subtotal;
          return `
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:16px;">
              <div style="display:flex; align-items:flex-start; gap:12px; flex:1; min-width:200px;">
                <button onclick="removeItem('${item.id}')" style="background:rgba(239, 68, 68, 0.1); border:1px solid #EF4444; color:#EF4444; padding:8px; border-radius:4px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:0.2s; flex-shrink:0;" title="Remove Item">
                  🗑️
                </button>
                <div>
                  <div style="font-weight:600; color:var(--white); font-size:0.95rem; line-height:1.3;">${item.title}</div>
                  <div style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">Qty: ${cleanQty} × ₦${Number(item.price).toLocaleString()}</div>
                </div>
              </div>
              <div style="font-weight:700; color:var(--gold); font-size:1.1rem; text-align:right; flex-shrink:0; width:100%; margin-top:8px;">
                ₦${subtotal.toLocaleString()}
              </div>
            </div>
          `;
        }).join('');

      totalEl.textContent = '₦' + total.toLocaleString();

      // === BOOKING FOR EMPLOYEE ===
      const bookingForEmployee = localStorage.getItem('absl_booking_for_employee') === 'true';
      const checkoutFormEl = document.getElementById('checkout-form');
      if (bookingForEmployee && checkoutFormEl && !document.getElementById('employee-booking-section')) {
        checkoutFormEl.insertAdjacentHTML('afterbegin', `
          <div id="employee-booking-section" style="background: rgba(30, 95, 158, 0.15); border: 1px solid var(--gold); border-radius: var(--r-md); padding: 20px; margin-bottom: 24px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 14px;">
              <div style="font-weight: 700; color: var(--gold); font-size: 0.95rem;">📝 Booking on behalf of an employee</div>
              <button id="cancel-employee-btn" style="background:none; border:none; color: var(--text-muted); cursor:pointer; font-size: 0.8rem; text-decoration: underline;">Cancel</button>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label style="display:block; font-family: var(--mono); font-size: 10px; color: var(--gold); margin-bottom: 4px;">EMPLOYEE FULL NAME *</label>
                <input id="f-employee-name" type="text" placeholder="John Doe" style="width:100%; padding:10px; background: var(--bg-surface); border: 1px solid var(--line-light); color: var(--white); border-radius: 4px;" />
              </div>
              <div>
                <label style="display:block; font-family: var(--mono); font-size: 10px; color: var(--gold); margin-bottom: 4px;">EMPLOYEE EMAIL (confirmation goes here)</label>
                <input id="f-employee-email" type="email" placeholder="john@company.com" style="width:100%; padding:10px; background: var(--bg-surface); border: 1px solid var(--line-light); color: var(--white); border-radius: 4px;" />
              </div>
            </div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 10px;">The booking will be billed to your corporate account. The traveler above will receive the confirmation.</div>
          </div>
        `);
        document.getElementById('cancel-employee-btn').addEventListener('click', () => {
          localStorage.removeItem('absl_booking_for_employee');
          window.location.reload();
        });
      }

      // Submit handler
      document.getElementById('submit-btn').addEventListener('click', async () => {
        const name = document.getElementById('f-name').value.trim();
        const phone = document.getElementById('f-phone').value.trim();
        const email = document.getElementById('f-email').value.trim();
        const location = document.getElementById('f-location').value.trim();
        const notes = document.getElementById('f-notes').value.trim();

        // Employee booking data
        let booking_for = 'self';
        let employee_name = null;
        let employee_email = null;
        if (bookingForEmployee) {
          const empNameEl = document.getElementById('f-employee-name');
          const empEmailEl = document.getElementById('f-employee-email');
          if (!empNameEl || !empNameEl.value.trim()) {
            alert('Please enter the employee name.');
            if (empNameEl) empNameEl.focus();
            return;
          }
          booking_for = 'employee';
          employee_name = empNameEl.value.trim();
          employee_email = empEmailEl ? empEmailEl.value.trim() : null;
        }

        if (!name || !phone) {
          alert('Please fill in your name and phone number.');
          return;
        }

        const btn = document.getElementById('submit-btn');
        btn.textContent = 'Submitting...';
        btn.disabled = true;

        try {
          const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
          const sbClient = createClient(supabaseUrl, supabaseAnonKey);
          const { data: { session } } = await sbClient.auth.getSession();
          const authHeader = session?.access_token ? `Bearer ${session.access_token}` : '';

          const res = await fetch('/api/bookings/create', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': authHeader
            },
            body: JSON.stringify({ name, phone, email, location, notes, cart, booking_for, employee_name, employee_email })
          });

          if (!res.ok) {
            const err = await res.text();
            throw new Error(err);
          }

          localStorage.removeItem('absl_cart');
          localStorage.removeItem('absl_booking_for_employee');
          window.dispatchEvent(new Event('absl-cart-updated'));
          alert('Booking submitted successfully! We will contact you shortly.');
          window.location.href = bookingForEmployee ? '/account' : '/';
        } catch (err) {
          alert('Failed to submit: ' + err.message);
          btn.textContent = 'Submit Booking';
          btn.disabled = false;
        }
      });
    })();
  </script>
  <script is:inline define:vars={{ supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL, supabaseAnonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
    // Clean up old floating point issues in localStorage
    const rawCart = localStorage.getItem('absl_cart');
    if (rawCart) {
      try {
        let cart = JSON.parse(rawCart);
        let changed = false;
        cart = cart.map(item => {
          const num = Number(item.qty);
          if (isNaN(num)) return item;
          const rounded = Math.round(num * 100) / 100;
          if (rounded !== num) changed = true;
          return { ...item, qty: rounded };
        });
        if (changed) {
          localStorage.setItem('absl_cart', JSON.stringify(cart));
        }
      } catch (e) {}
    }
  </script>
</Layout>