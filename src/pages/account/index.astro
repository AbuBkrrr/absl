---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '../../lib/supabase';

// Initialize SSR client with cookies
const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

// Check if admin
const { data: profile } = await supabase.from('absl_profiles').select('*').eq('id', user.id).single();
if (profile && (profile.role !== 'customer' || profile.is_admin)) {
  return Astro.redirect('/admin');
}

// Fetch Customer Bookings
const { data: bookings } = await supabase
  .from('absl_bookings')
  .select('*')
  .eq('customer_email', user.email)
  .order('created_at', { ascending: false });

const rows = bookings || [];
---

<Layout title="My Account - ABSL">
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Client Dashboard</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Welcome back, {profile?.full_name || user.email}</p>
      </div>
      <a href="/" class="btn btn-outline" style="padding:10px 24px;">&larr; View Site</a>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px;">
    <h2 style="font-size:1.8rem; color:var(--white); margin-bottom:24px;">My Bookings</h2>
    {rows.length === 0 ? (
      <div style="background:var(--bg-card); border:1px dashed var(--line); padding:40px; text-align:center; border-radius:var(--r-md);">
        <p style="color:var(--text-muted); margin-bottom:16px;">You have no active bookings yet.</p>
        <a href="/travel" class="btn btn-primary">Start Booking</a>
      </div>
    ) : (
      <div style="display:flex; flex-direction:column; gap:16px;">
        {rows.map(b => (
          <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
            <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
              <div style="color:var(--gold); font-family:var(--mono);">ORDER #{b.id.slice(0, 8).toUpperCase()}</div>
              <div style="color:var(--white); font-weight:700;">₦{Number(b.total_amount).toLocaleString()}</div>
            </div>
            <div style="color:var(--text-muted); font-size:0.9rem;">Status: {b.booking_status}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>