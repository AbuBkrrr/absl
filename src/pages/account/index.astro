---
import Layout from '../../layouts/Layout.astro';
import { createClient } from '../../lib/supabase';

const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

// Fetch Profile
const { data: profile } = await supabase.from('absl_profiles').select('*').eq('id', user.id).single();
if (profile && (profile.role !== 'customer' || profile.is_admin)) {
  return Astro.redirect('/admin');
}

// Fetch Bookings
const { data: bookings } = await supabase
  .from('absl_bookings')
  .select('*')
  .eq('customer_email', user.email)
  .order('created_at', { ascending: false });

// Fetch Inventory (Warehouse)
const { data: inventory } = await supabase
  .from('absl_inventory')
  .select('*')
  .eq('user_id', user.id)
  .order('created_at', { ascending: false });

const rows = bookings || [];
const inventoryItems = inventory || [];
---

<Layout title="Client Dashboard - ABSL">
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <h1 style="font-size:2.5rem; color:var(--white); margin:0;">Client Dashboard</h1>
        <p style="color:var(--text-muted); margin-top:8px;">Welcome back, {profile?.full_name || user.email}</p>
      </div>
      <a href="/" class="btn btn-outline" style="padding:10px 24px;">&larr; View Site</a>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px;">
    
    <!-- ========================================== -->
    <!-- MY BOOKINGS SECTION                        -->
    <!-- ========================================== -->
    <h2 style="font-size:1.8rem; color:var(--white); margin-bottom:24px;">My Bookings & Orders</h2>
    
    {rows.length === 0 ? (
      <div style="background:var(--bg-card); border:1px dashed var(--line); padding:40px; text-align:center; border-radius:var(--r-md); margin-bottom: 60px;">
        <p style="color:var(--text-muted); margin-bottom:16px;">You have no active bookings yet.</p>
        <a href="/travel" class="btn btn-primary">Start Booking</a>
      </div>
    ) : (
      <div style="display:flex; flex-direction:column; gap:24px; margin-bottom: 60px;">
        {rows.map(b => (
          <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
            
            <!-- Order Header -->
            <div style="background:var(--bg-surface); padding:16px 24px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line-light);">
              <div>
                <div style="color:var(--gold); font-family:var(--mono); font-size:0.85rem;">ORDER #{b.id.slice(0, 8).toUpperCase()}</div>
                <div style="color:var(--text-muted); font-size:0.8rem; margin-top:4px;">{new Date(b.created_at).toLocaleDateString()}</div>
              </div>
              <div style="display:flex; align-items:center; gap:16px;">
                <span style={`font-size:10px; padding:4px 10px; border-radius:4px; font-weight:700; text-transform:uppercase; background:${b.booking_status === 'completed' ? 'rgba(16, 185, 129, 0.15)' : 'rgba(245, 158, 11, 0.15)'}; color:${b.booking_status === 'completed' ? '#10B981' : '#F59E0B'};`}>
                  {b.booking_status}
                </span>
                <div style="color:var(--white); font-weight:700; font-size:1.1rem;">₦{Number(b.total_amount).toLocaleString()}</div>
              </div>
            </div>

            <!-- Order Items -->
            <div style="padding:24px;">
              <h4 style="font-size:0.9rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Items Purchased</h4>
              <div style="display:flex; flex-direction:column; gap:12px;">
                {Array.isArray(b.items) && b.items.map((item: any) => (
                  <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--line-light); padding-bottom:12px;">
                    <div>
                      <div style="color:var(--white); font-weight:600;">{item.title}</div>
                      <div style="color:var(--text-muted); font-size:0.85rem;">Qty: {item.qty} × ₦{Number(item.price).toLocaleString()}</div>
                    </div>
                    <div style="color:var(--gold); font-family:var(--mono);">
                      ₦{(Number(item.qty) * Number(item.price)).toLocaleString()}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- ========================================== -->
    <!-- INVENTORY DASHBOARD SECTION                -->
    <!-- ========================================== -->
    <h2 style="font-size:1.8rem; color:var(--white); margin-bottom:8px;">My Inventory</h2>
    <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:24px;">Real-time stock levels stored at our 140,000 SQM facilities.</p>

    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      {inventoryItems.length === 0 ? (
        <div style="padding:40px; text-align:center;">
          <p style="color:var(--text-muted);">You currently have no inventory stored with ABSL.</p>
        </div>
      ) : (
        <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
          <thead>
            <tr style="background:var(--bg-surface); text-align:left;">
              <th style="padding:16px; color:var(--gold);">SKU / Item</th>
              <th style="padding:16px; color:var(--gold); text-align:center;">Quantity</th>
              <th style="padding:16px; color:var(--gold);">Location</th>
              <th style="padding:16px; color:var(--gold);">Status</th>
            </tr>
          </thead>
          <tbody>
            {inventoryItems.map(item => (
              <tr style="border-top:1px solid var(--line-light);">
                <td style="padding:16px; color:var(--white);">
                  <div style="font-weight:600;">{item.sku}</div>
                  <div style="font-size:11px; color:var(--text-muted);">{item.description}</div>
                </td>
                <td style="padding:16px; text-align:center; color:var(--white); font-weight:700;">{item.quantity}</td>
                <td style="padding:16px; color:var(--text-muted);">{item.location || 'Warehouse A'}</td>
                <td style="padding:16px;">
                  <span style="font-size:10px; padding:4px 10px; border-radius:4px; background:rgba(16, 185, 129, 0.15); color:#10B981; text-transform:uppercase; font-weight:700;">
                    {item.status || 'In Stock'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

  </div>
</Layout>