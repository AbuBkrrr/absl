---
import Layout from '../layouts/Layout.astro';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Travel & Tours - ABSL">
  <!-- HERO SECTION -->
  <section style="position:relative; padding: 100px 0 100px; background: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.95)), url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop'); background-size: cover; background-position: center; border-bottom: 1px solid var(--line);">
    <div class="container" style="position:relative; z-index:2;">
      <div style="text-align:center; max-width: 800px; margin: 0 auto 48px;">
        <h1 style="font-size: 4rem; line-height: 1.1; margin-bottom: 24px;">Your Gateway to the World.</h1>
        <p style="font-size: 1.15rem; color: var(--text-muted);">Book flights, reserve hotels, apply for visas, and arrange premium car hires — all in one place.</p>
      </div>

      <!-- SEARCH WIDGET -->
      <div style="background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px; max-width: 900px; margin: 0 auto;">
        
        <!-- Tabs -->
        <div style="display:flex; gap:8px; margin-bottom:24px; flex-wrap:wrap; border-bottom:1px solid var(--line-light); padding-bottom:16px;">
          <button class="travel-tab active" data-target="flights" style="background:none; border:none; color:var(--gold); font-family:var(--mono); font-size:13px; font-weight:600; cursor:pointer; padding:8px 16px; border-radius:4px; transition:0.2s;">✈️ Flights</button>
          <button class="travel-tab" data-target="hotels" style="background:none; border:none; color:var(--text-muted); font-family:var(--mono); font-size:13px; font-weight:600; cursor:pointer; padding:8px 16px; border-radius:4px; transition:0.2s;">🏨 Hotels</button>
          <button class="travel-tab" data-target="visas" style="background:none; border:none; color:var(--text-muted); font-family:var(--mono); font-size:13px; font-weight:600; cursor:pointer; padding:8px 16px; border-radius:4px; transition:0.2s;">📋 Visas</button>
          <button class="travel-tab" data-target="tours" style="background:none; border:none; color:var(--text-muted); font-family:var(--mono); font-size:13px; font-weight:600; cursor:pointer; padding:8px 16px; border-radius:4px; transition:0.2s;">🌍 Tours</button>
          <button class="travel-tab" data-target="cars" style="background:none; border:none; color:var(--text-muted); font-family:var(--mono); font-size:13px; font-weight:600; cursor:pointer; padding:8px 16px; border-radius:4px; transition:0.2s;">🚗 Car Hire</button>
        </div>

        <!-- FLIGHTS PANEL -->
        <div id="panel-flights" class="travel-panel" style="display:block;">
          <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">FROM</label>
              <input type="text" placeholder="Lagos (LOS)" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">TO</label>
              <input type="text" placeholder="London (LHR)" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">DEPARTURE</label>
              <input type="date" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">PASSENGERS</label>
              <select class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
                <option>1 Adult</option><option>2 Adults</option><option>3 Adults</option><option>Family</option>
              </select>
            </div>
          </div>
          <button class="btn btn-primary search-btn" data-service="Flight" style="width:100%; margin-top:16px; padding:14px;">Search Flights</button>
        </div>

        <!-- HOTELS PANEL -->
        <div id="panel-hotels" class="travel-panel" style="display:none;">
          <div style="display:grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">DESTINATION / CITY</label>
              <input type="text" placeholder="Dubai, UAE" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">CHECK-IN</label>
              <input type="date" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">CHECK-OUT</label>
              <input type="date" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">GUESTS</label>
              <select class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
                <option>1 Room, 1 Guest</option><option>1 Room, 2 Guests</option><option>2 Rooms, 4 Guests</option>
              </select>
            </div>
          </div>
          <button class="btn btn-primary search-btn" data-service="Hotel" style="width:100%; margin-top:16px; padding:14px;">Search Hotels</button>
        </div>

        <!-- VISAS PANEL -->
        <div id="panel-visas" class="travel-panel" style="display:none;">
          <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">DESTINATION COUNTRY</label>
              <select class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
                <option>UK</option><option>USA</option><option>Canada</option><option>Schengen</option><option>UAE</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">PURPOSE OF TRAVEL</label>
              <select class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
                <option>Tourism</option><option>Business</option><option>Study</option><option>Work</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">NATIONALITY</label>
              <input type="text" placeholder="Nigerian" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
          </div>
          <button class="btn btn-primary search-btn" data-service="Visa Application" style="width:100%; margin-top:16px; padding:14px;">Apply for Visa</button>
        </div>

        <!-- TOURS PANEL -->
        <div id="panel-tours" class="travel-panel" style="display:none;">
          <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">DESTINATION</label>
              <input type="text" placeholder="Cape Town, South Africa" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">START DATE</label>
              <input type="date" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">GROUP SIZE</label>
              <input type="number" placeholder="2" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
          </div>
          <button class="btn btn-primary search-btn" data-service="Tour Package" style="width:100%; margin-top:16px; padding:14px;">Request Tour Guide</button>
        </div>

        <!-- CARS PANEL -->
        <div id="panel-cars" class="travel-panel" style="display:none;">
          <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">PICK-UP LOCATION</label>
              <input type="text" placeholder="Abuja Airport" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">PICK-UP DATE</label>
              <input type="date" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">DROP-OFF DATE</label>
              <input type="date" class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:6px;">VEHICLE TYPE</label>
              <select class="t-input" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
                <option>SUV (With Driver)</option><option>Sedan (With Driver)</option><option>Luxury Bus</option><option>Self-Drive</option>
              </select>
            </div>
          </div>
          <button class="btn btn-primary search-btn" data-service="Car Hire" style="width:100%; margin-top:16px; padding:14px;">Reserve Vehicle</button>
        </div>

      </div>
    </div>
  </section>

  <!-- Booking Modal -->
  <div id="booking-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px);">
    <div style="background:var(--bg-card); border:1px solid var(--gold); border-radius:var(--r-md); width:100%; max-width:500px; padding:32px;">
      <h3 style="font-size:1.5rem; color:var(--gold); margin-bottom:8px;">Complete Your Request</h3>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:24px;">Please provide your contact details so our travel desk can confirm your <span id="modal-service-name" style="color:var(--white); font-weight:bold;"></span> booking.</p>
      
      <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:24px;">
        <div>
          <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:4px;">FULL NAME</label>
          <input id="m-name" type="text" placeholder="John Doe" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div>
          <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:4px;">EMAIL ADDRESS</label>
          <input id="m-email" type="email" placeholder="john@company.com" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div>
          <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:4px;">PHONE NUMBER</label>
          <input id="m-phone" type="tel" placeholder="+234 800 000 0000" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
      </div>

      <div style="display:flex; gap:12px;">
        <button id="cancel-modal" class="btn btn-outline" style="flex:1;">Cancel</button>
        <button id="submit-booking" class="btn btn-primary" style="flex:1;">Submit Request</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    let supabaseClient = null;
    let currentService = "";
    let currentDetails = {};

    async function getSupabase() {
      if (supabaseClient) return supabaseClient;
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      supabaseClient = createClient(supabaseUrl, supabaseAnonKey);
      return supabaseClient;
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Tab Switching Logic
      const tabs = document.querySelectorAll('.travel-tab');
      const panels = document.querySelectorAll('.travel-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => { t.classList.remove('active'); t.style.background = 'none'; t.style.color = 'var(--text-muted)'; });
          panels.forEach(p => p.style.display = 'none');

          tab.classList.add('active');
          tab.style.background = 'rgba(197, 160, 89, 0.1)';
          tab.style.color = 'var(--gold)';
          
          document.getElementById(`panel-${tab.dataset.target}`).style.display = 'block';
        });
      });

      // Set first tab active style
      if(tabs.length > 0) {
        tabs[0].style.background = 'rgba(197, 160, 89, 0.1)';
        tabs[0].style.color = 'var(--gold)';
      }

      // Modal Logic
      const modal = document.getElementById('booking-modal');
      const cancelBtn = document.getElementById('cancel-modal');
      const submitBtn = document.getElementById('submit-booking');

      document.querySelectorAll('.search-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          currentService = e.target.dataset.service;
          document.getElementById('modal-service-name').textContent = currentService;

          // Capture the inputs from the active panel
          const activePanel = e.target.closest('.travel-panel');
          const inputs = activePanel.querySelectorAll('.t-input');
          currentDetails = {};
          
          inputs.forEach((input, index) => {
            currentDetails[input.previousElementSibling.textContent.trim()] = input.value;
          });

          modal.style.display = 'flex';
        });
      });

      cancelBtn.addEventListener('click', () => modal.style.display = 'none');

      submitBtn.addEventListener('click', async () => {
        const name = document.getElementById('m-name').value.trim();
        const email = document.getElementById('m-email').value.trim();
        const phone = document.getElementById('m-phone').value.trim();

        if (!name || !email || !phone) return alert('Please fill all contact fields.');

        submitBtn.textContent = 'Submitting...'; submitBtn.disabled = true;

        try {
          const supabase = await getSupabase();
          const { error } = await supabase.from('absl_travel_bookings').insert({
            service_type: currentService,
            customer_name: name,
            customer_email: email,
            customer_phone: phone,
            details: currentDetails
          });

          if (error) throw error;

          alert(`Request submitted successfully!\n\nOur travel desk will contact you shortly regarding your ${currentService} request.`);
          modal.style.display = 'none';
          
          // Clear fields
          document.getElementById('m-name').value = '';
          document.getElementById('m-email').value = '';
          document.getElementById('m-phone').value = '';
          submitBtn.textContent = 'Submit Request'; submitBtn.disabled = false;

        } catch (err) {
          alert('Error: ' + err.message);
          submitBtn.textContent = 'Submit Request'; submitBtn.disabled = false;
        }
      });
    });
  </script>
</Layout>