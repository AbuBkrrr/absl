---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: projects } = await supabase
  .from('absl_projects')
  .select('*')
  .eq('status', 'active')
  .order('order_index', { ascending: true })
  .order('created_at', { ascending: false });

const portfolio = projects || [];
---

<Layout title="Construction & Remodeling - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <h1 style="font-size:3rem; margin-bottom:16px;">Construction & Remodeling</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px;">Design your build. Watch it come to life in 2D and get an instant Bill of Quantities.</p>
    </div>
  </div>

  <div class="container" style="padding: 40px 24px 80px;">
    
    <div style="display:grid; grid-template-columns: 1fr 1.2fr; gap:40px; margin-bottom:80px;">
      
      <!-- INPUTS COLUMN -->
      <div style="background:var(--bg-card); border:1px solid var(--line); border-radius:var(--r-lg); padding:32px;">
        <h2 style="font-size:1.8rem; color:var(--gold); margin-bottom:24px;">Project Parameters</h2>

        <h3 style="font-family:var(--display); font-size:1.1rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">1. Land & Structure</h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">BUILDING TYPE</label>
            <select id="calc-template" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
              <option value="home">Standard Home</option>
              <option value="villa">Luxury Villa</option>
              <option value="office">Corporate Office</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">BUILD QUALITY</label>
            <select id="calc-quality" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
              <option value="basic">Basic</option>
              <option value="mid" selected>Mid-Range</option>
              <option value="luxury">Luxury</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">LAND SIZE (SQM)</label>
            <input type="number" id="calc-sqm" value="400" min="100" max="5000" step="10" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">FLOORS</label>
            <input type="number" id="calc-floors" value="1" min="1" max="5" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
        </div>

        <h3 style="font-family:var(--display); font-size:1.1rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">2. Finishes</h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">ROOF TYPE</label>
            <select id="opt-roof" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
              <option value="15000">Long Span Aluminum</option>
              <option value="25000">Stone Coated</option>
              <option value="35000">Flat Concrete</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">FLOORING</label>
            <select id="opt-floor" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
              <option value="6000">Standard Tiles</option>
              <option value="15000">Porcelain / Marble</option>
              <option value="22000">Italian Marble</option>
            </select>
          </div>
        </div>

        <h3 style="font-family:var(--display); font-size:1.1rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">3. Extras</h3>
        <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:24px;">
          <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light); cursor:pointer;">
            <input type="checkbox" id="opt-solar" style="width:16px; height:16px;" /> Solar Power Setup
          </label>
          <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light); cursor:pointer;">
            <input type="checkbox" id="opt-pool" style="width:16px; height:16px;" /> Swimming Pool
          </label>
          <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light); cursor:pointer;">
            <input type="checkbox" id="opt-landscape" style="width:16px; height:16px;" /> Landscaping & Fencing
          </label>
        </div>
      </div>

      <!-- RIGHT COLUMN: VISUALIZER & BOQ -->
      <div>
        
        <!-- 2D VISUALIZER -->
        <div style="background:#0A1128; border-radius:12px; overflow:hidden; margin-bottom:24px; border:2px solid var(--gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
          <div style="background:var(--bg-surface); padding:10px 16px; color:var(--gold); font-family:var(--mono); font-size:12px; border-bottom:1px solid var(--line-light); display:flex; justify-content:space-between;">
            <span>LIVE 2D PREVIEW</span>
            <span id="svg-label" style="color:var(--text-muted);">Standard Home · 1 Floor · 400 SQM Land</span>
          </div>
          
          <div style="padding: 20px; display:flex; justify-content:center; align-items:center; height: 350px; background: #e0f2fe; position: relative;">
            <svg id="build-svg" width="100%" height="100%" viewBox="0 0 500 350" xmlns="http://www.w3.org/2000/svg" style="overflow:visible;">
              <!-- Land / Ground -->
              <rect id="svg-ground" x="50" y="270" width="400" height="80" fill="#78350f" />
              
              <!-- Landscaping Trees -->
              <g id="svg-trees" style="display:none;">
                <circle cx="90" cy="240" r="25" fill="#166534" />
                <circle cx="110" cy="250" r="20" fill="#14532d" />
                <rect x="86" y="260" width="8" height="25" fill="#451a03" />
                <circle cx="410" cy="245" r="30" fill="#166534" />
                <circle cx="390" cy="255" r="25" fill="#14532d" />
                <rect x="406" y="270" width="8" height="25" fill="#451a03" />
              </g>

              <!-- Swimming Pool -->
              <g id="svg-pool" style="display:none;">
                <ellipse cx="400" cy="310" rx="45" ry="25" fill="#0ea5e9" stroke="#0284c7" stroke-width="3" />
                <path d="M 370 310 Q 380 305 390 310 T 410 310 T 430 310" stroke="#38bdf8" stroke-width="2" fill="none" />
              </g>

              <!-- Foundation -->
              <rect id="svg-foundation" x="140" y="260" width="220" height="20" fill="#64748b" />

              <!-- Structure (Floors) -->
              <rect id="svg-structure" x="140" y="120" width="220" height="140" fill="#cbd5e1" stroke="#475569" stroke-width="2" />

              <!-- Roof (Polygon) -->
              <polygon id="svg-roof" points="120,120 250,40 380,120" fill="#ef4444" stroke="#7f1d1d" stroke-width="2" />

              <!-- Solar Panels -->
              <g id="svg-solar" style="display:none;">
                <rect x="210" y="75" width="40" height="25" fill="#1e3a8a" stroke="#0f172a" stroke-width="2" transform="rotate(-25 230 85)" />
                <rect x="260" y="65" width="40" height="25" fill="#1e3a8a" stroke="#0f172a" stroke-width="2" transform="rotate(-25 280 75)" />
              </g>

              <!-- Door -->
              <rect id="svg-door" x="230" y="200" width="40" height="60" fill="#78350f" stroke="#451a03" stroke-width="2" />
              <circle cx="260" cy="230" r="3" fill="#fbbf24" />

              <!-- Windows -->
              <g id="svg-windows">
                <rect x="160" y="150" width="35" height="35" fill="#60a5fa" stroke="#1e3a8a" stroke-width="2" />
                <line x1="177.5" y1="150" x2="177.5" y2="185" stroke="#1e3a8a" stroke-width="2" />
                <line x1="160" y1="167.5" x2="195" y2="167.5" stroke="#1e3a8a" stroke-width="2" />

                <rect x="305" y="150" width="35" height="35" fill="#60a5fa" stroke="#1e3a8a" stroke-width="2" />
                <line x1="322.5" y1="150" x2="322.5" y2="185" stroke="#1e3a8a" stroke-width="2" />
                <line x1="305" y1="167.5" x2="340" y2="167.5" stroke="#1e3a8a" stroke-width="2" />
              </g>
            </svg>
          </div>
        </div>

        <!-- DETAILED BOQ RESULTS -->
        <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
          <h3 style="font-family:var(--display); font-size:1.4rem; color:var(--gold); border-bottom:1px solid var(--line-light); padding-bottom:12px; margin-bottom:16px;">Bill of Quantities</h3>
          
          <div id="results-list" style="display:flex; flex-direction:column; gap:12px; font-size:0.95rem; max-height:500px; overflow-y:auto;">
            <!-- Populated by JS -->
          </div>
        </div>

      </div>
    </div>

  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      // INPUTS
      const templateInput = document.getElementById('calc-template');
      const qualityInput = document.getElementById('calc-quality');
      const sqmInput = document.getElementById('calc-sqm');
      const floorsInput = document.getElementById('calc-floors');
      const roofInput = document.getElementById('opt-roof');
      const floorInput = document.getElementById('opt-floor');
      const solarInput = document.getElementById('opt-solar');
      const poolInput = document.getElementById('opt-pool');
      const landscapeInput = document.getElementById('opt-landscape');
      const svgLabel = document.getElementById('svg-label');

      // SVG ELEMENTS
      const svgGround = document.getElementById('svg-ground');
      const svgStructure = document.getElementById('svg-structure');
      const svgFoundation = document.getElementById('svg-foundation');
      const svgRoof = document.getElementById('svg-roof');
      const svgDoor = document.getElementById('svg-door');
      const svgWindows = document.getElementById('svg-windows');
      const svgSolar = document.getElementById('svg-solar');
      const svgPool = document.getElementById('svg-pool');
      const svgTrees = document.getElementById('svg-trees');
      const resultsList = document.getElementById('results-list');

      function updateVisualsAndCosts() {
        // 1. GET VALUES
        const sqm = Number(sqmInput.value) || 100;
        const floors = Number(floorsInput.value) || 1;
        const template = templateInput.value;
        const quality = qualityInput.value;
        const roofType = roofInput.value;
        const floorType = floorInput.value;

        // 2. UPDATE SVG VISUALS
        // Ground (Land Size)
        const landWidth = Math.min(450, 150 + (sqm / 4)); // Scale land width
        svgGround.setAttribute('width', landWidth);
        svgGround.setAttribute('x', 250 - (landWidth / 2));

        // Building Structure
        let baseWidth = 220;
        let baseHeight = 140;
        if (template === 'villa') { baseWidth = 280; baseHeight = 140; }
        if (template === 'office') { baseWidth = 320; baseHeight = 160; }
        
        // Height based on floors
        const totalHeight = baseHeight * (floors * 0.7 + 0.3); 
        const newY = 260 - totalHeight;

        svgStructure.setAttribute('width', baseWidth);
        svgStructure.setAttribute('height', totalHeight);
        svgStructure.setAttribute('x', 250 - (baseWidth / 2));
        svgStructure.setAttribute('y', newY);

        // Foundation
        svgFoundation.setAttribute('width', baseWidth + 20);
        svgFoundation.setAttribute('x', 250 - ((baseWidth + 20) / 2));

        // Roof
        const roofHeight = template === 'office' ? 20 : 80;
        svgRoof.setAttribute('points', `${250 - (baseWidth/2) - 20},${newY} 250,${newY - roofHeight} ${250 + (baseWidth/2) + 20},${newY}`);
        
        // Roof Color
        if (roofType === '15000') svgRoof.setAttribute('fill', '#ef4444'); // Red Aluminum
        else if (roofType === '25000') svgRoof.setAttribute('fill', '#475569'); // Grey Stone
        else svgRoof.setAttribute('fill', '#d1d5db'); // Concrete

        // Windows & Doors positioning based on new height
        svgDoor.setAttribute('y', 260 - 60);
        svgDoor.setAttribute('x', 250 - 20);

        // Extras
        svgSolar.style.display = solarInput.checked ? 'block' : 'none';
        if(solarInput.checked) {
          svgSolar.innerHTML = `
            <rect x="${250-40}" y="${newY+10}" width="30" height="20" fill="#1e3a8a" stroke="#0f172a" stroke-width="1" />
            <rect x="${250+10}" y="${newY+10}" width="30" height="20" fill="#1e3a8a" stroke="#0f172a" stroke-width="1" />
          `;
        }
        
        svgPool.style.display = poolInput.checked ? 'block' : 'none';
        svgTrees.style.display = landscapeInput.checked ? 'block' : 'none';

        // Update Label
        svgLabel.textContent = `${templateInput.options[templateInput.selectedIndex].text} · ${floors} Floor(s) · ${sqm} SQM Land`;

        // 3. CALCULATE COSTS
        const qualityRates = { basic: 65000, mid: 95000, luxury: 140000 };
        const buildArea = sqm * floors;
        const baseCost = buildArea * qualityRates[quality];

        // Breakdown percentages (approximate for realistic detailed estimate)
        const prelims = baseCost * 0.05;
        const foundation = baseCost * 0.15;
        const structure = baseCost * 0.25;
        
        const roofCost = buildArea * Number(roofType);
        const flooringCost = buildArea * Number(floorType);
        const windowsDoors = baseCost * 0.10;
        
        let extrasCost = 0;
        if (solarInput.checked) extrasCost += 4500000;
        if (poolInput.checked) extrasCost += 8000000;
        if (landscapeInput.checked) extrasCost += 1200000;

        const subtotal = prelims + foundation + structure + roofCost + flooringCost + windowsDoors + extrasCost;
        const profFees = subtotal * 0.05;
        const contingency = subtotal * 0.10;
        const grandTotal = subtotal + profFees + contingency;

        const fmt = (num) => '₦' + Math.round(num).toLocaleString();

        // 4. RENDER RESULTS
        resultsList.innerHTML = `
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Total Build Area</span>
            <span style="color:var(--white); font-family:var(--mono);">${buildArea.toLocaleString()} SQM</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Preliminaries & Permits</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(prelims)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Foundation & Excavation</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(foundation)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Core Structure (Blocks, Concrete)</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(structure)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Roofing</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(roofCost)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Flooring Finishes</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(flooringCost)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Windows, Doors & Plumbing</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(windowsDoors)}</span>
          </div>
          
          ${extrasCost > 0 ? `
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--gold); font-weight:600;">Extras</span>
            <span style="color:var(--gold); font-family:var(--mono); font-weight:600;">${fmt(extrasCost)}</span>
          </div>` : ''}

          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light); margin-top:8px;">
            <span style="color:var(--text-muted);">Professional Fees (5%)</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(profFees)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Contingency Fund (10%)</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(contingency)}</span>
          </div>

          <div style="display:flex; justify-content:space-between; margin-top:20px; padding-top:16px; border-top:2px solid var(--gold);">
            <span style="color:var(--gold); font-weight:700; font-size:1.2rem;">Grand Total</span>
            <span style="color:var(--gold); font-weight:700; font-size:1.4rem; font-family:var(--mono);">${fmt(grandTotal)}</span>
          </div>
          <div style="text-align:center; margin-top:16px;">
             <a href="/contact" class="btn btn-outline" style="font-size:0.8rem; padding:8px 16px;">Request Formal Quote</a>
          </div>
        `;
      }

      // Attach listeners to all inputs for live updates
      document.querySelectorAll('input, select').forEach(el => {
        el.addEventListener('change', updateVisualsAndCosts);
        el.addEventListener('input', updateVisualsAndCosts);
      });

      // Initial run on page load
      updateVisualsAndCosts();
    });
  </script>
</Layout>