---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: projects } = await supabase
  .from('absl_projects')
  .select('*')
  .eq('status', 'active')
  .order('order_index', { ascending: true })
  .order('created_at', { ascending: false });

const portfolio = projects || [];
---

<Layout title="Construction Estimator - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <h1 style="font-size:3rem; margin-bottom:16px;">Professional Construction Estimator</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px;">Generate a detailed Bill of Quantities (BOQ) instantly. Select your parameters below to calculate precise material, labor, and finishing costs.</p>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px 80px;">
    
    <!-- MASTER ESTIMATOR GRID -->
    <div style="display:grid; grid-template-columns: 1fr 1.2fr; gap:40px; margin-bottom:80px; align-items:start;">
      
      <!-- LEFT COLUMN: INPUTS -->
      <div style="background:var(--bg-card); border:1px solid var(--line); border-radius:var(--r-lg); padding:40px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <h2 style="font-size:1.8rem; color:var(--gold); margin-bottom:32px;">Project Parameters</h2>

        <!-- SECTION 1 -->
        <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">1. Core Structure</h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:32px;">
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">BUILDING TYPE</label>
            <select id="calc-template" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
              <option value="home">Standard Home</option>
              <option value="villa">Luxury Villa / Duplex</option>
              <option value="office">Corporate Office</option>
              <option value="school">Educational Facility</option>
              <option value="shop">Market Shops / Plaza</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">BUILD QUALITY</label>
            <select id="calc-quality" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
              <option value="basic">Standard / Basic</option>
              <option value="mid" selected>Mid-Range</option>
              <option value="luxury">Luxury / High-End</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">TOTAL SQM (Per Floor)</label>
            <input type="number" id="calc-sqm" value="150" min="20" max="10000" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">NUMBER OF FLOORS</label>
            <input type="number" id="calc-floors" value="1" min="1" max="10" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;" />
          </div>
        </div>

        <!-- SECTION 2 -->
        <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">2. Finishes & Materials</h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:32px;">
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">ROOFING TYPE</label>
            <select id="opt-roof" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
              <option value="15000">Long Span Aluminum</option>
              <option value="25000">Stone Coated</option>
              <option value="35000">Flat Concrete Roof</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">WINDOWS</label>
            <select id="opt-windows" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
              <option value="8000">Aluminum Sliding</option>
              <option value="15000">UPVC Casement</option>
              <option value="28000">Double Glazed</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">DOORS</label>
            <select id="opt-doors" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
              <option value="5000">Flush Doors</option>
              <option value="12000">Solid Wood</option>
              <option value="25000">Security / Steel</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">FLOORING</label>
            <select id="opt-floor" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px; outline:none;">
              <option value="6000">Standard Tiles</option>
              <option value="15000">Porcelain / Marble</option>
              <option value="22000">Italian Marble</option>
            </select>
          </div>
        </div>

        <!-- SECTION 3 -->
        <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">3. Extras & Utilities</h3>
        <div style="display:flex; flex-direction:column; gap:16px;">
          <label style="display:flex; align-items:center; gap:12px; font-size:0.95rem; color:var(--text-light); cursor:pointer;">
            <input type="checkbox" id="opt-solar" style="width:18px; height:18px; accent-color:var(--gold);" /> 
            <span>Solar Power Setup <span style="color:var(--text-muted); font-size:0.8rem;">(+₦4,500,000)</span></span>
          </label>
          <label style="display:flex; align-items:center; gap:12px; font-size:0.95rem; color:var(--text-light); cursor:pointer;">
            <input type="checkbox" id="opt-pool" style="width:18px; height:18px; accent-color:var(--gold);" /> 
            <span>Swimming Pool <span style="color:var(--text-muted); font-size:0.8rem;">(+₦8,000,000)</span></span>
          </label>
          <label style="display:flex; align-items:center; gap:12px; font-size:0.95rem; color:var(--text-light); cursor:pointer;">
            <input type="checkbox" id="opt-landscape" style="width:18px; height:18px; accent-color:var(--gold);" /> 
            <span>Landscaping & Fencing <span style="color:var(--text-muted); font-size:0.8rem;">(+₦1,200,000)</span></span>
          </label>
        </div>
      </div>

      <!-- RIGHT COLUMN: DETAILED BOQ -->
      <div style="position: sticky; top: 100px;">
        <div style="background:var(--bg-surface); border:1px solid var(--line); border-radius:var(--r-md); padding:40px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
          <div style="display:flex; justify-content:space-between; align-items:flex-end; border-bottom:1px solid var(--line-light); padding-bottom:16px; margin-bottom:24px;">
            <h3 style="font-family:var(--display); font-size:1.6rem; color:var(--gold); margin:0;">Bill of Quantities</h3>
            <span id="total-area-label" style="font-family:var(--mono); font-size:12px; color:var(--text-muted);">150 SQM</span>
          </div>
          
          <div id="results-list" style="display:flex; flex-direction:column; gap:12px; font-size:0.95rem;">
            <!-- Populated by JS -->
          </div>
        </div>
      </div>

    </div>

    <!-- PORTFOLIO -->
    <h2 style="font-size:2.5rem; margin-bottom:32px; text-align:center;">Our Recent Projects</h2>
    {portfolio.length === 0 ? (
      <div style="text-align:center; padding:60px; background:var(--bg-card); border:1px dashed var(--line); border-radius:var(--r-md);">
        <p style="color:var(--text-muted);">No portfolio projects yet. Check back soon.</p>
      </div>
    ) : (
      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(350px, 1fr)); gap:40px;">
        {portfolio.map(p => (
          <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; background:var(--bg-card);">
            <div style={`height:280px; background:url('${p.image_url}') center/cover;`}></div>
            <div style="padding:32px;">
              <div style="font-size:10px; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">{p.category}</div>
              <h3 style="font-size:1.4rem; margin-bottom:12px;">{p.title}</h3>
              <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.7; margin-bottom:16px;">{p.description}</p>
              {p.budget && (
                <div style="font-family:var(--mono); font-size:11px; color:var(--gold); border-top:1px solid var(--line-light); padding-top:12px;">BUDGET: {p.budget}</div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const inputs = document.querySelectorAll('input, select');
      const resultsList = document.getElementById('results-list');
      const totalAreaLabel = document.getElementById('total-area-label');

      function calculateCosts() {
        // Get values
        const sqm = Number(document.getElementById('calc-sqm').value) || 0;
        const floors = Number(document.getElementById('calc-floors').value) || 1;
        const quality = document.getElementById('calc-quality').value;
        const roofType = document.getElementById('opt-roof').value;
        const windowType = document.getElementById('opt-windows').value;
        const doorType = document.getElementById('opt-doors').value;
        const floorType = document.getElementById('opt-floor').value;

        const solar = document.getElementById('opt-solar').checked;
        const pool = document.getElementById('opt-pool').checked;
        const landscape = document.getElementById('opt-landscape').checked;

        const totalSQM = sqm * floors;
        totalAreaLabel.textContent = `${totalSQM.toLocaleString()} SQM Total`;

        // Rates
        const qualityRates = { basic: 65000, mid: 95000, luxury: 140000 };
        const baseRate = qualityRates[quality];

        // Core Breakdown
        const prelims = (totalSQM * baseRate) * 0.05;
        const foundation = (totalSQM * baseRate) * 0.15;
        const structure = (totalSQM * baseRate) * 0.25;
        
        // Finishes Breakdown
        const roofing = totalSQM * Number(roofType);
        const flooring = totalSQM * Number(floorType);
        const windows = totalSQM * Number(windowType);
        const doors = totalSQM * Number(doorType);
        
        // Extras
        let extrasCost = 0;
        const extrasList = [];
        if (solar) { extrasCost += 4500000; extrasList.push('Solar'); }
        if (pool) { extrasCost += 8000000; extrasList.push('Pool'); }
        if (landscape) { extrasCost += 1200000; extrasList.push('Landscaping'); }

        // Totals
        const subtotal = prelims + foundation + structure + roofing + flooring + windows + doors + extrasCost;
        const profFees = subtotal * 0.05;
        const contingency = subtotal * 0.10;
        const grandTotal = subtotal + profFees + contingency;

        const fmt = (num) => '₦' + Math.round(num).toLocaleString();

        // Render HTML
        resultsList.innerHTML = `
          <div style="font-family:var(--mono); font-size:11px; color:var(--gold); text-transform:uppercase; margin-bottom:4px; margin-top:8px;">Core Structure & Labor</div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Preliminaries & Permits</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(prelims)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Foundation & Excavation</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(foundation)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Blockwork & Concrete</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(structure)}</span>
          </div>

          <div style="font-family:var(--mono); font-size:11px; color:var(--gold); text-transform:uppercase; margin-bottom:4px; margin-top:16px;">Finishes & Materials</div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Roofing</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(roofing)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Flooring</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(flooring)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Windows</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(windows)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Doors</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(doors)}</span>
          </div>

          ${extrasCost > 0 ? `
          <div style="font-family:var(--mono); font-size:11px; color:var(--gold); text-transform:uppercase; margin-bottom:4px; margin-top:16px;">Extras</div>
          <div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">${extrasList.join(', ')}</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(extrasCost)}</span>
          </div>
          ` : ''}

          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light); margin-top:16px;">
            <span style="color:var(--text-muted);">Professional Fees (5%)</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(profFees)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
            <span style="color:var(--text-muted);">Contingency Fund (10%)</span>
            <span style="color:var(--text-light); font-family:var(--mono);">${fmt(contingency)}</span>
          </div>

          <div style="display:flex; justify-content:space-between; margin-top:24px; padding-top:16px; border-top:2px solid var(--gold);">
            <span style="color:var(--gold); font-weight:700; font-size:1.2rem;">Grand Total</span>
            <span style="color:var(--gold); font-weight:700; font-size:1.5rem; font-family:var(--mono);">${fmt(grandTotal)}</span>
          </div>
          
          <div style="margin-top:24px;">
             <a href="/contact" class="btn btn-primary" style="width:100%; text-align:center; padding:12px;">Request Formal Quote</a>
             <p style="text-align:center; font-size:0.75rem; color:var(--text-muted); margin-top:8px; font-family:var(--mono);">*Estimate only. Final costs depend on site survey.</p>
          </div>
        `;
      }

      // Attach live listeners
      inputs.forEach(el => {
        el.addEventListener('input', calculateCosts);
        el.addEventListener('change', calculateCosts);
      });

      // Initial calculation
      calculateCosts();
    });
  </script>
</Layout>