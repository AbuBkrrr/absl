---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Fetch dynamic settings from Supabase
const { data: configData } = await supabase.from('absl_estimator_settings').select('*').eq('id', 'default').single();
const settings = configData ? configData.settings : null;
const flwKey = import.meta.env.PUBLIC_FLUTTERWAVE_PUBLIC_KEY;
---

<Layout title="Construction Lifecycle Estimator - ABSL">
  <div class="bp-wrap">
    <div class="bp-container">
      
      <!-- PROJECT PARAMETERS -->
      <section class="bp-sheet">
        <div class="bp-sheet-head">
          <div>
            <div class="bp-eyebrow">Project Parameters</div>
            <div class="bp-title">Define the build</div>
          </div>
          <div class="bp-num">SHEET 00 / 03</div>
        </div>
        <div class="bp-inputs-grid">
          <div class="bp-field">
            <label>Floor Area <span class="val" id="sqmVal">120 m²</span></label>
            <input type="range" id="sqmSlider" min="50" max="5000" step="10" value="120">
            <input type="text" inputmode="numeric" class="bp-manual-input" id="sqmManual" value="120">
          </div>
          <div class="bp-field">
            <label>Floors <span class="val" id="floorsVal">1</span></label>
            <input type="range" id="floorsSlider" min="1" max="5" step="1" value="1">
            <input type="text" inputmode="numeric" class="bp-manual-input" id="floorsManual" value="1">
          </div>
          <div class="bp-field">
            <label>Build Quality</label>
            <div class="bp-segmented" id="qualitySeg">
              <button data-q="basic">Basic</button>
              <button data-q="mid" class="active">Mid</button>
              <button data-q="luxury">Luxury</button>
            </div>
          </div>
          <div class="bp-field">
            <label>Furnishing</label>
            <div class="bp-toggle-row">
              <label class="bp-switch">
                <input type="checkbox" id="furnishToggle" checked>
                <span class="bp-slider"></span>
              </label>
              <span style="font-family:var(--font-body); font-size:13px; font-weight:600;" id="furnishLabel">Included</span>
            </div>
          </div>
        </div>
      </section>

      <!-- PHASE 1 -->
      <section class="bp-sheet">
        <div class="bp-sheet-head">
          <div>
            <div class="bp-eyebrow">Phase 01 — Setup</div>
            <div class="bp-title">Bill of Quantities</div>
            <div class="bp-sub">Suggested unit prices pull from local market data. Override any price to fit your actual quotes — overrides persist automatically.</div>
          </div>
          <div class="bp-num">SHEET 01 / 03</div>
        </div>
        <div class="bp-table-scroll">
          <table class="bp-table">
            <thead>
              <tr>
                <th>Material</th><th class="num">Quantity</th><th class="num">Suggested</th><th class="num">Custom Price</th><th class="num">Subtotal</th>
              </tr>
            </thead>
            <tbody id="boqBody"></tbody>
            <tfoot>
              <tr>
                <td colspan="4">Materials Subtotal</td>
                <td class="num" id="materialsSubtotal">—</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>

      <!-- PHASE 2 -->
      <section class="bp-sheet">
        <div class="bp-sheet-head">
          <div>
            <div class="bp-eyebrow">Phase 02 — Handover</div>
            <div class="bp-title">Finishing & Furnishing</div>
            <div class="bp-sub">Cleaning, furniture, labor and professional fees applied on top of the materials subtotal.</div>
          </div>
          <div class="bp-num">SHEET 02 / 03</div>
        </div>
        <div class="bp-line-list" id="phase2List"></div>
        <div class="bp-subtotal-bar">
          <span class="label">Phase 02 Subtotal</span>
          <span class="amount" id="phase2Subtotal">—</span>
        </div>
      </section>

      <!-- PHASE 3 -->
      <section class="bp-sheet">
        <div class="bp-sheet-head">
          <div>
            <div class="bp-eyebrow">Phase 03 — Recurring</div>
            <div class="bp-title">Monthly Utility Burn</div>
            <div class="bp-sub">Ongoing running costs once the building is occupied — not included in the one-time construction total.</div>
          </div>
          <div class="bp-num">SHEET 03 / 03</div>
        </div>
        <div class="bp-line-list" id="phase3List"></div>
        <div class="bp-subtotal-bar">
          <span class="label">Total Monthly Running Cost</span>
          <span class="amount" id="monthlyTotal">—</span>
        </div>
      </section>

      <!-- SUMMARY -->
      <section class="bp-sheet">
        <div class="bp-sheet-head">
          <div>
            <div class="bp-eyebrow">Grand Summary</div>
            <div class="bp-title">Total project cost</div>
          </div>
        </div>
        <div class="bp-summary-grid">
          <div class="bp-grand-card">
            <div class="g-label">Total Construction + Furnishing Cost</div>
            <div class="g-amount" id="grandTotal">—</div>
            <div class="g-sub">Materials + Labor + Professional Fees + Finishing</div>
            <div class="bp-legend" id="legend"></div>
          </div>
          <div class="bp-chart-card" style="display:flex; flex-direction:column; justify-content:center; gap:16px;">
            <a href="/contact?subject=Professional+BOQ+Request" class="bp-btn-pdf" style="background:#0b1e3a; color:#fff; border:none; text-align:center; padding:16px; border-radius:8px; font-weight:700; text-decoration:none; font-family:var(--mono); font-size:12px;">🤝 Contact us for a more professional BOQ</a>
            <button id="supply-btn" class="bp-btn-pdf" style="background:#d97d2b; color:#fff; border:none; text-align:center; padding:16px; border-radius:8px; font-weight:700; font-family:var(--mono); font-size:12px; cursor:pointer;">🧱 Request ABSL to Supply Building Materials</button>
            <button onclick="window.print()" class="bp-btn-pdf" style="background:transparent; border:1px solid var(--gold); color:var(--gold); padding:16px; border-radius:8px; font-weight:700; font-family:var(--mono); font-size:12px; cursor:pointer;">📄 Download PDF Summary</button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- MATERIAL SUPPLY MODAL -->
  <div id="supply-modal" style="display:none; position:fixed; inset:0; background:rgba(10,17,40,0.9); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px); padding:20px;">
    <div style="background:var(--bg-surface); border:1px solid var(--gold); border-radius:16px; width:100%; max-width:700px; max-height:90vh; display:flex; flex-direction:column;">
      
      <div style="padding:24px; border-bottom:1px solid var(--line-light); display:flex; justify-content:space-between; align-items:center;">
        <div>
          <h2 style="color:var(--white); font-size:1.5rem; margin:0;">ABSL Material Supply</h2>
          <p style="color:var(--text-muted); font-size:0.9rem; margin:4px 0 0 0;">Select the materials you want ABSL to supply and pay securely.</p>
        </div>
        <button id="close-modal" style="background:none; border:none; color:var(--white); font-size:1.5rem; cursor:pointer;">✕</button>
      </div>

      <div style="padding:24px; overflow-y:auto; flex:1;">
        <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:13px;">
          <thead>
            <tr style="text-align:left; border-bottom:1px solid var(--line-light);">
              <th style="padding:12px 8px; width:40px;"><input type="checkbox" id="select-all" checked /></th>
              <th style="padding:12px 8px; color:var(--gold);">Material</th>
              <th style="padding:12px 8px; color:var(--gold); text-align:center;">Qty</th>
              <th style="padding:12px 8px; color:var(--gold); text-align:right;">Price</th>
            </tr>
          </thead>
          <tbody id="invoice-body"></tbody>
        </table>
      </div>

      <div style="padding:24px; border-top:1px solid var(--line-light); background:var(--bg-card);">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:16px;">
          <span style="color:var(--text-muted); font-size:0.9rem;">Includes 10% handling & logistics fee</span>
          <div style="text-align:right;">
            <span style="color:var(--text-muted); font-size:0.8rem; text-transform:uppercase;">Total to Pay</span>
            <div id="invoice-total" style="color:var(--gold); font-size:1.8rem; font-weight:700; font-family:var(--mono);">₦0</div>
          </div>
        </div>
        
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;">
          <input id="inv-name" type="text" placeholder="Your Full Name" style="padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          <input id="inv-email" type="email" placeholder="Email for Receipt" style="padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div style="margin-bottom:16px;">
          <input id="inv-phone" type="tel" placeholder="Phone Number (for delivery)" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>

        <button id="pay-btn" style="width:100%; padding:16px; background:#d97d2b; color:#fff; border:none; border-radius:8px; font-weight:700; font-size:1.1rem; cursor:pointer;">Pay with Flutterwave</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="settings-data" set:html={JSON.stringify(settings)} />
  <script type="application/json" id="flw-key" set:html={JSON.stringify(flwKey)} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const parsedSettings = JSON.parse(document.getElementById('settings-data').textContent);
      const flwKey = JSON.parse(document.getElementById('flw-key').textContent);
      
      // Fallback to prevent crashes if DB fails
      const settings = parsedSettings || {
        materials: [
          { id: 'cement', name: 'Cement', unit: 'bags', qtyPerSqm: 0.45, basePrice: 12500 },
          { id: 'rebar', name: 'Rebar', unit: 'tons', qtyPerSqm: 0.018, basePrice: 1250000 },
          { id: 'sand', name: 'Sand', unit: 'tons', qtyPerSqm: 0.040, basePrice: 45000 },
          { id: 'gravel', name: 'Gravel', unit: 'tons', qtyPerSqm: 0.035, basePrice: 55000 },
          { id: 'blocks', name: 'Blocks', unit: 'pcs', qtyPerSqm: 9.5, basePrice: 650 },
          { id: 'roofing', name: 'Roofing Sheets', unit: 'sheets', qtyPerSqm: 0.18, basePrice: 8500 },
          { id: 'timber', name: 'Timber', unit: 'planks', qtyPerSqm: 0.25, basePrice: 4500 },
          { id: 'tiles', name: 'Tiles', unit: 'sqm', qtyPerSqm: 1.08, basePrice: 6500 },
          { id: 'paint', name: 'Paint', unit: 'buckets', qtyPerSqm: 0.045, basePrice: 45000 },
          { id: 'doors', name: 'Doors', unit: 'units', qtyPerSqm: 0.018, basePrice: 85000 },
          { id: 'windows', name: 'Windows', unit: 'units', qtyPerSqm: 0.035, basePrice: 65000 },
          { id: 'electrical', name: 'Electrical Wiring', unit: 'm', qtyPerSqm: 2.8, basePrice: 850 },
          { id: 'plumbing', name: 'Plumbing', unit: 'sqm', qtyPerSqm: 1, basePrice: 12000 }
        ],
        phase2: { cleaningRate: 1500, livingRoomSet: 850000, bedroomSet: 650000, kitchenAppliances: 950000, curtainsRate: 8500, laborMultiplier: 0.40, archFeeMultiplier: 0.10 },
        utilities: { electricityPerKwh: 225, waterPerM3: 350, gasCylinder: 15500, wasteDisposal: 5000 }
      };

      let currentState = { area: 120, floors: 1, quality: 'mid', furnish: true, overrides: JSON.parse(localStorage.getItem('absl_budget_overrides')) || {} };
      let currentMaterials = [];

      const QUALITY_QTY_MULT = { basic: 0.85, mid: 1.0, luxury: 1.15 };
      const QUALITY_PRICE_MULT = { basic: 1.0, mid: 1.0, luxury: 1.30 };
      const QUALITY_WATTS_SQM = { basic: 35, mid: 50, luxury: 70 };

      function fmtMoney(v) { return '₦' + Math.round(v).toLocaleString(); }
      function floorMultiplier() { return 1 + (currentState.floors - 1) * 0.07; }
      function totalSqm() { return currentState.area; }

      function render() {
        if (!settings) return;

        const fMult = floorMultiplier();
        const qQty = QUALITY_QTY_MULT[currentState.quality];
        const qPrice = QUALITY_PRICE_MULT[currentState.quality];
        
        // --- RENDER BOQ ---
        const tbody = document.getElementById('boqBody');
        tbody.innerHTML = '';
        let matSubtotal = 0;
        currentMaterials = [];

        settings.materials.forEach(m => {
          const qty = m.qtyPerSqm * totalSqm() * fMult * qQty;
          const displayQty = ['bags','pcs','sheets','planks','buckets','units'].includes(m.unit) ? Math.max(1, Math.ceil(qty)) : qty;
          const basePrice = m.basePrice * qPrice;
          const override = currentState.overrides[m.id];
          const price = override !== undefined ? override : basePrice;
          const rowSub = displayQty * price;
          matSubtotal += rowSub;

          currentMaterials.push({ id: m.id, name: m.name, unit: m.unit, qty: displayQty, price: price });

          tbody.innerHTML += `
            <tr style="border-bottom:1px solid var(--line-soft);">
              <td style="padding:12px 8px; color:var(--ink);">${m.name}<br><span style="font-size:10px; color:var(--ink-muted);">${m.unit}</span></td>
              <td style="padding:12px 8px; text-align:center; color:var(--ink-muted);">${displayQty.toLocaleString()}</td>
              <td style="padding:12px 8px; text-align:right; color:var(--ink-muted);">${fmtMoney(basePrice)}</td>
              <td style="padding:12px 8px; text-align:right;">
                <input type="number" data-id="${m.id}" class="price-input" value="${price.toFixed(2)}" style="width:90px; padding:6px; background:var(--navy-800); border:1px solid var(--line); color:var(--gold); border-radius:4px; text-align:right; font-family:var(--mono); font-size:12px;" />
              </td>
              <td style="padding:12px 8px; text-align:right; color:var(--gold); font-weight:600;">${fmtMoney(rowSub)}</td>
            </tr>
          `;
        });
        document.getElementById('materialsSubtotal').textContent = fmtMoney(matSubtotal);

        // --- RENDER PHASE 2 ---
        let p2Subtotal = 0;
        const p2 = settings.phase2;
        let p2Html = '';

        const clean = totalSqm() * p2.cleaningRate;
        p2Html += `<div class="bp-line-row"><span class="bp-line-name">Post-Construction Cleaning</span><span class="bp-line-meta">${totalSqm()} m²</span><span class="bp-line-meta col-price">${fmtMoney(p2.cleaningRate)}</span><span class="bp-line-total">${fmtMoney(clean)}</span></div>`;
        p2Subtotal += clean;

        if (currentState.furnish) {
          const bedrooms = Math.max(1, Math.round(totalSqm() / 70));
          p2Html += `<div class="bp-line-row"><span class="bp-line-name">Living Room Set</span><span class="bp-line-meta">1 set</span><span class="bp-line-meta col-price">${fmtMoney(p2.livingRoomSet)}</span><span class="bp-line-total">${fmtMoney(p2.livingRoomSet)}</span></div>`;
          p2Subtotal += p2.livingRoomSet;

          const bedCost = bedrooms * p2.bedroomSet;
          p2Html += `<div class="bp-line-row"><span class="bp-line-name">Bedroom Sets</span><span class="bp-line-meta">${bedrooms} sets</span><span class="bp-line-meta col-price">${fmtMoney(p2.bedroomSet)}</span><span class="bp-line-total">${fmtMoney(bedCost)}</span></div>`;
          p2Subtotal += bedCost;

          p2Html += `<div class="bp-line-row"><span class="bp-line-name">Kitchen Appliances</span><span class="bp-line-meta">1 set</span><span class="bp-line-meta col-price">${fmtMoney(p2.kitchenAppliances)}</span><span class="bp-line-total">${fmtMoney(p2.kitchenAppliances)}</span></div>`;
          p2Subtotal += p2.kitchenAppliances;

          const curtCost = totalSqm() * p2.curtainsRate;
          p2Html += `<div class="bp-line-row"><span class="bp-line-name">Curtains</span><span class="bp-line-meta">${totalSqm()} m²</span><span class="bp-line-meta col-price">${fmtMoney(p2.curtainsRate)}</span><span class="bp-line-total">${fmtMoney(curtCost)}</span></div>`;
          p2Subtotal += curtCost;
        }

        const labor = matSubtotal * p2.laborMultiplier;
        const arch = matSubtotal * p2.archFeeMultiplier;
        p2Html += `<div class="bp-line-row"><span class="bp-line-name" style="color:var(--gold);">Labor</span><span class="bp-line-meta">${(p2.laborMultiplier*100).toFixed(0)}%</span><span class="bp-line-meta col-price"></span><span class="bp-line-total">${fmtMoney(labor)}</span></div>`;
        p2Html += `<div class="bp-line-row"><span class="bp-line-name" style="color:var(--gold);">Architect Fee</span><span class="bp-line-meta">${(p2.archFeeMultiplier*100).toFixed(0)}%</span><span class="bp-line-meta col-price"></span><span class="bp-line-total">${fmtMoney(arch)}</span></div>`;
        p2Subtotal += labor + arch;

        document.getElementById('phase2List').innerHTML = p2Html;
        document.getElementById('phase2Subtotal').textContent = fmtMoney(p2Subtotal);

        // --- RENDER PHASE 3 ---
        const watts = QUALITY_WATTS_SQM[currentState.quality];
        const kwh = (totalSqm() * watts * 6 * 30) / 1000;
        const elec = kwh * settings.utilities.electricityPerKwh;
        const waterM3 = 4 * 4;
        const water = waterM3 * settings.utilities.waterPerM3;
        const gas = 2 * settings.utilities.gasCylinder;
        const waste = settings.utilities.wasteDisposal;
        const monthlyTotal = elec + water + gas + waste;

        document.getElementById('phase3List').innerHTML = `
          <div class="bp-line-row"><span class="bp-line-name">Electricity</span><span class="bp-line-meta">${kwh.toFixed(0)} kWh</span><span class="bp-line-meta col-price">${fmtMoney(settings.utilities.electricityPerKwh)}</span><span class="bp-line-total">${fmtMoney(elec)}</span></div>
          <div class="bp-line-row"><span class="bp-line-name">Water</span><span class="bp-line-meta">${waterM3} m³</span><span class="bp-line-meta col-price">${fmtMoney(settings.utilities.waterPerM3)}</span><span class="bp-line-total">${fmtMoney(water)}</span></div>
          <div class="bp-line-row"><span class="bp-line-name">Gas</span><span class="bp-line-meta">2 cylinders</span><span class="bp-line-meta col-price">${fmtMoney(settings.utilities.gasCylinder)}</span><span class="bp-line-total">${fmtMoney(gas)}</span></div>
          <div class="bp-line-row"><span class="bp-line-name">Waste</span><span class="bp-line-meta">Flat Fee</span><span class="bp-line-meta col-price"></span><span class="bp-line-total">${fmtMoney(waste)}</span></div>
        `;
        document.getElementById('monthlyTotal').textContent = fmtMoney(monthlyTotal);

        // --- SUMMARY ---
        const grand = matSubtotal + p2Subtotal;
        document.getElementById('grandTotal').textContent = fmtMoney(grand);
        document.getElementById('legend').innerHTML = `
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#f5a623"></span> Materials <b>${fmtMoney(matSubtotal)}</b></div>
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#3ddc97"></span> Labor <b>${fmtMoney(labor)}</b></div>
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#5b8def"></span> Prof. Fees <b>${fmtMoney(arch)}</b></div>
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#ef6a5f"></span> Finishing <b>${fmtMoney(p2Subtotal - labor - arch)}</b></div>
        `;
      }

      // Input Listeners
      document.getElementById('sqmSlider').addEventListener('input', e => { currentState.area = Number(e.target.value); document.getElementById('sqmVal').textContent = currentState.area + ' m²'; render(); });
      document.getElementById('floorsSlider').addEventListener('input', e => { currentState.floors = Number(e.target.value); document.getElementById('floorsVal').textContent = currentState.floors; render(); });
      
      document.querySelectorAll('.bp-segmented button').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bp-segmented button').forEach(b => { b.classList.remove('active'); b.style.background='transparent'; b.style.color='var(--ink-muted)'; });
          btn.classList.add('active'); btn.style.background='var(--gold)'; btn.style.color='var(--navy-950)';
          currentState.quality = btn.dataset.q;
          render();
        });
      });

      document.getElementById('furnishToggle').addEventListener('change', e => {
        currentState.furnish = e.target.checked;
        document.getElementById('furnishLabel').textContent = e.target.checked ? 'Included' : 'Excluded';
        render();
      });

      document.addEventListener('change', e => {
        if (e.target.classList.contains('price-input')) {
          const id = e.target.dataset.id;
          currentState.overrides[id] = Number(e.target.value);
          localStorage.setItem('absl_budget_overrides', JSON.stringify(currentState.overrides));
          render();
        }
      });

      // Initial render
      render();

      // --- INVOICE MODAL LOGIC ---
      const modal = document.getElementById('supply-modal');
      const invBody = document.getElementById('invoice-body');
      
      document.getElementById('supply-btn').addEventListener('click', () => {
        invBody.innerHTML = currentMaterials.map((m, idx) => `
          <tr style="border-bottom:1px solid var(--line-light);">
            <td style="padding:12px 8px;"><input type="checkbox" class="mat-check" data-idx="${idx}" checked /></td>
            <td style="padding:12px 8px; color:var(--white);">${m.name}</td>
            <td style="padding:12px 8px; text-align:center; color:var(--text-muted);">${m.qty} ${m.unit}</td>
            <td style="padding:12px 8px; text-align:right; color:var(--gold);">${fmtMoney(m.price * m.qty)}</td>
          </tr>
        `).join('');
        updateInvoiceTotal();
        modal.style.display = 'flex';
      });

      document.getElementById('close-modal').onclick = () => modal.style.display = 'none';

      function updateInvoiceTotal() {
        let total = 0;
        document.querySelectorAll('.mat-check').forEach(chk => {
          if (chk.checked) {
            const m = currentMaterials[chk.dataset.idx];
            total += m.qty * m.price;
          }
        });
        total = total * 1.10; // 10% handling fee
        document.getElementById('invoice-total').textContent = fmtMoney(total);
      }

      document.getElementById('select-all').addEventListener('change', (e) => {
        document.querySelectorAll('.mat-check').forEach(chk => chk.checked = e.target.checked);
        updateInvoiceTotal();
      });

      document.addEventListener('change', (e) => {
        if (e.target.classList.contains('mat-check')) updateInvoiceTotal();
      });

      // --- FLUTTERWAVE PAYMENT ---
      document.getElementById('pay-btn').addEventListener('click', () => {
        const name = document.getElementById('inv-name').value.trim();
        const email = document.getElementById('inv-email').value.trim();
        const phone = document.getElementById('inv-phone').value.trim();

        if (!name || !email || !phone) return alert('Please fill in all contact fields.');

        const selectedItems = [];
        document.querySelectorAll('.mat-check').forEach(chk => {
          if (chk.checked) selectedItems.push(currentMaterials[chk.dataset.idx]);
        });

        if (selectedItems.length === 0) return alert('Please select at least one material.');

        let total = selectedItems.reduce((s, m) => s + (m.qty * m.price), 0);
        total = total * 1.10; // Add 10% fee
        const txRef = 'ABSL-MAT-' + Math.floor((Math.random() * 1000000000) + 1);

        FlutterwaveCheckout({
          public_key: flwKey,
          tx_ref: txRef,
          amount: total,
          currency: "NGN",
          customer: { email, phone_number: phone, name },
          customizations: {
            title: "ABSL Material Supply",
            description: "Payment for building materials",
            logo: "https://absl.com.ng/absl-logo.png"
          },
          callback: async (data) => {
            document.getElementById('pay-btn').textContent = 'Verifying...';
            document.getElementById('pay-btn').disabled = true;

            try {
              const res = await fetch('/api/material-supply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  transaction_id: data.transaction_id,
                  tx_ref: txRef,
                  amount: total,
                  customer_name: name,
                  customer_email: email,
                  customer_phone: phone,
                  items: selectedItems
                })
              });

              if (res.ok) {
                alert('Payment successful! A receipt has been sent to your email.');
                modal.style.display = 'none';
              } else {
                alert('Payment verification failed. Please contact support.');
              }
            } catch (err) {
              alert('Error verifying payment.');
            } finally {
              document.getElementById('pay-btn').textContent = 'Pay with Flutterwave';
              document.getElementById('pay-btn').disabled = false;
            }
          },
          onclose: () => {}
        });
      });
    });
  </script>

