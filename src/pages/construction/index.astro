---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Construction & Remodeling - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <h1 style="font-size:3rem; margin-bottom:16px;">Construction & Remodeling</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px;">Premium residential and commercial builds, from architectural design to project handover, with certified craftsmanship and a 10-year structural guarantee.</p>
    </div>
  </div>

  <div class="container" style="padding: 80px 0;">
    
    <!-- MASTER CONSTRUCTION ESTIMATOR -->
    <div style="background:var(--bg-card); border:1px solid var(--line); border-radius:var(--r-lg); padding:40px; margin-bottom:80px; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:2.2rem; color:var(--gold); margin-bottom:8px;">ABSL Detailed Estimator</h2>
        <p style="color:var(--text-muted);">Customize every detail of your build to generate a precise Bill of Quantities.</p>
      </div>

      <div style="display:grid; grid-template-columns: 1.2fr 1fr; gap:40px;">
        
        <!-- INPUTS COLUMN -->
        <div>
          <!-- SECTION 1: CORE STRUCTURE -->
          <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">1. Core Structure</h3>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">DESIGN TEMPLATE</label>
              <select id="calc-template" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="custom">Custom Build</option>
                <option value="home">Standard Home</option>
                <option value="villa">Luxury Villa</option>
                <option value="office">Corporate Office</option>
                <option value="school">Educational Facility</option>
                <option value="shop">Market Shops</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">BUILD QUALITY</label>
              <select id="calc-quality" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="basic">Basic</option>
                <option value="mid" selected>Mid-Range</option>
                <option value="luxury">Luxury</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">TOTAL SQM</label>
              <input type="number" id="calc-sqm" value="200" min="50" max="20000" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">NUMBER OF FLOORS</label>
              <input type="number" id="calc-floors" value="1" min="1" max="20" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
            </div>
          </div>

          <!-- SECTION 2: FINISHES & MATERIALS -->
          <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">2. Finishes & Materials</h3>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">ROOF TYPE</label>
              <select id="opt-roof" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="15000">Long Span Aluminum (+₦15k/sqm)</option>
                <option value="25000">Stone Coated (+₦25k/sqm)</option>
                <option value="35000">Flat Concrete Roof (+₦35k/sqm)</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">WINDOWS</label>
              <select id="opt-windows" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="8000">Aluminum Sliding (+₦8k/sqm)</option>
                <option value="15000">UPVC Casement (+₦15k/sqm)</option>
                <option value="28000">Double Glazed (+₦28k/sqm)</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">DOORS</label>
              <select id="opt-doors" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="5000">Flush Doors (+₦5k/sqm)</option>
                <option value="12000">Solid Wood (+₦12k/sqm)</option>
                <option value="25000">Security / Steel (+₦25k/sqm)</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">CEILING</label>
              <select id="opt-ceiling" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="4000">POP Ceiling (+₦4k/sqm)</option>
                <option value="7000">PVC Ceiling (+₦7k/sqm)</option>
                <option value="12000">Suspended Tiles (+₦12k/sqm)</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--gold); margin-bottom:6px;">FLOORING</label>
              <select id="opt-floor" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
                <option value="6000">Standard Tiles (+₦6k/sqm)</option>
                <option value="15000">Porcelain / Marble (+₦15k/sqm)</option>
                <option value="22000">Italian Marble (+₦22k/sqm)</option>
              </select>
            </div>
          </div>

          <!-- SECTION 3: UTILITIES & EXTRAS -->
          <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); margin-bottom:16px; border-bottom:1px solid var(--line-light); padding-bottom:8px;">3. Utilities & Extras</h3>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:24px;">
            <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light);">
              <input type="checkbox" id="opt-ac" style="width:16px; height:16px;" /> Central AC System (+₦1.5M)
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light);">
              <input type="checkbox" id="opt-solar" style="width:16px; height:16px;" /> Solar Power Setup (+₦4.5M)
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light);">
              <input type="checkbox" id="opt-heater" style="width:16px; height:16px;" /> Water Heaters (+₦350k)
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light);">
              <input type="checkbox" id="opt-landscape" style="width:16px; height:16px;" /> Landscaping (+₦1.2M)
            </label>
            <label style="display:flex; align-items:center; gap:8px; font-size:0.9rem; color:var(--text-light);">
              <input type="checkbox" id="opt-pool" style="width:16px; height:16px;" /> Swimming Pool (+₦8M)
            </label>
          </div>

          <button id="calc-btn" class="btn btn-primary" style="width:100%; padding:16px; font-size:1.1rem; background:var(--gold);">Generate Detailed Estimate</button>
        </div>

        <!-- RESULTS COLUMN -->
        <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; display:flex; flex-direction:column; overflow-y:auto; max-height: 800px;">
          <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); border-bottom:1px solid var(--line-light); padding-bottom:12px; margin-bottom:16px;">Bill of Quantities</h3>
          
          <div id="results-list" style="display:flex; flex-direction:column; gap:10px; font-size:0.9rem;">
            <div style="color:var(--text-muted); text-align:center; padding: 40px 20px;">Select your parameters and click Generate to view the breakdown.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Calculator Logic -->
  <script>
    const templates = {
      custom: { sqm: 150, floors: 1 },
      home: { sqm: 200, floors: 1 },
      villa: { sqm: 500, floors: 2 },
      office: { sqm: 1200, floors: 4 },
      school: { sqm: 2500, floors: 2 },
      shop: { sqm: 60, floors: 1 }
    };

    const templateSelect = document.getElementById('calc-template');
    const sqmInput = document.getElementById('calc-sqm');
    const floorsInput = document.getElementById('calc-floors');

    templateSelect.addEventListener('change', (e) => {
      const t = templates[e.target.value];
      sqmInput.value = t.sqm;
      floorsInput.value = t.floors;
    });

    document.getElementById('calc-btn').addEventListener('click', () => {
      const sqm = Number(sqmInput.value);
      const floors = Number(floorsInput.value);
      const totalSqm = sqm * floors;
      
      if (!sqm || !floors) return alert('Please enter valid square meters and floors.');

      // 1. Core Structure (Foundation, Columns, Blockwork, Labor)
      const qualityRates = { basic: 65000, mid: 95000, luxury: 140000 };
      const coreCost = totalSqm * qualityRates[document.getElementById('calc-quality').value];

      // 2. Finishes (Multiplied by total SQM)
      const roofCost = totalSqm * Number(document.getElementById('opt-roof').value);
      const windowCost = totalSqm * Number(document.getElementById('opt-windows').value);
      const doorCost = totalSqm * Number(document.getElementById('opt-doors').value);
      const ceilingCost = totalSqm * Number(document.getElementById('opt-ceiling').value);
      const floorCost = totalSqm * Number(document.getElementById('opt-floor').value);
      
      const finishesTotal = roofCost + windowCost + doorCost + ceilingCost + floorCost;

      // 3. Utilities & Extras (Fixed costs)
      let extrasTotal = 0;
      const extras = [];
      if (document.getElementById('opt-ac').checked) { extrasTotal += 1500000; extras.push('Central AC'); }
      if (document.getElementById('opt-solar').checked) { extrasTotal += 4500000; extras.push('Solar Power'); }
      if (document.getElementById('opt-heater').checked) { extrasTotal += 350000; extras.push('Water Heaters'); }
      if (document.getElementById('opt-landscape').checked) { extrasTotal += 1200000; extras.push('Landscaping'); }
      if (document.getElementById('opt-pool').checked) { extrasTotal += 8000000; extras.push('Swimming Pool'); }

      // 4. Subtotal & Fees
      const subtotal = coreCost + finishesTotal + extrasTotal;
      const professionalFees = subtotal * 0.05; // 5% Architect/Engineer
      const contingency = subtotal * 0.10; // 10% Contingency
      const grandTotal = subtotal + professionalFees + contingency;

      const fmt = (num) => '₦' + Math.round(num).toLocaleString();

      let html = `
        <div style="display:flex; justify-content:space-between; padding-bottom:8px; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--white); font-weight:600;">Core Structure & Labor</span>
          <span style="color:var(--gold); font-family:var(--mono);">${fmt(coreCost)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--text-muted);">- Roofing</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(roofCost)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--text-muted);">- Windows</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(windowCost)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--text-muted);">- Doors</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(doorCost)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--text-muted);">- Ceiling</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(ceilingCost)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--text-muted);">- Flooring</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(floorCost)}</span>
        </div>
      `;

      if (extras.length > 0) {
        html += `
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light); margin-top:8px;">
          <span style="color:var(--white); font-weight:600;">Utilities & Extras</span>
          <span style="color:var(--gold); font-family:var(--mono);">${fmt(extrasTotal)}</span>
        </div>
        <div style="padding:4px 0 8px 12px; font-size:0.8rem; color:var(--text-muted);">
          (${extras.join(', ')})
        </div>
        `;
      }

      html += `
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light); margin-top:8px;">
          <span style="color:var(--text-muted);">Professional Fees (5%)</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(professionalFees)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px dashed var(--line-light);">
          <span style="color:var(--text-muted);">Contingency (10%)</span>
          <span style="color:var(--white); font-family:var(--mono);">${fmt(contingency)}</span>
        </div>
        <div style="display:flex; justify-content:space-between; margin-top:20px; padding-top:16px; border-top:2px solid var(--gold);">
          <span style="color:var(--gold); font-weight:700; font-size:1.2rem;">Grand Total</span>
          <span style="color:var(--gold); font-weight:700; font-size:1.4rem; font-family:var(--mono);">${fmt(grandTotal)}</span>
        </div>
        <div style="text-align:center; margin-top:24px;">
          <a href="/contact" class="btn btn-outline" style="font-size:0.8rem; padding:10px 20px;">Request Formal Quote</a>
        </div>
      `;

      document.getElementById('results-list').innerHTML = html;
    });
  </script>
</Layout>