---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Construction & Remodeling - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <h1 style="font-size:3rem; margin-bottom:16px;">Construction & Remodeling</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px;">Premium residential and commercial builds, from architectural design to project handover, with certified craftsmanship and a 10-year structural guarantee.</p>
    </div>
  </div>

  <div class="container" style="padding: 80px 0;">
    
    <!-- PROFESSIONAL CONSTRUCTION ESTIMATOR -->
    <div style="background:var(--bg-card); border:1px solid var(--line); border-radius:var(--r-lg); padding:40px; margin-bottom:80px; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:2.2rem; color:var(--gold); margin-bottom:8px;">ABSL Professional Estimator</h2>
        <p style="color:var(--text-muted);">Select a design template or build custom to generate a detailed Bill of Quantities.</p>
      </div>

      <div style="display:grid; grid-template-columns: 1fr 1.2fr; gap:40px;">
        
        <!-- Inputs -->
        <div>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--mono); font-size:12px; color:var(--gold); margin-bottom:8px;">1. DESIGN TEMPLATE</label>
            <select id="calc-template" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
              <option value="custom">Custom Build</option>
              <option value="home">Standard 3-Bedroom Home</option>
              <option value="villa">Luxury Villa / Duplex</option>
              <option value="office">Corporate Office Building</option>
              <option value="school">Educational Facility</option>
              <option value="shop">Market Shops / Plaza</option>
            </select>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px;">
            <div>
              <label style="display:block; font-family:var(--mono); font-size:12px; color:var(--gold); margin-bottom:8px;">2. TOTAL SQM</label>
              <input type="number" id="calc-sqm" value="150" min="50" max="20000" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
            </div>
            <div>
              <label style="display:block; font-family:var(--mono); font-size:12px; color:var(--gold); margin-bottom:8px;">3. FLOORS</label>
              <input type="number" id="calc-floors" value="1" min="1" max="20" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
            </div>
          </div>

          <div style="margin-bottom:24px;">
            <label style="display:block; font-family:var(--mono); font-size:12px; color:var(--gold); margin-bottom:8px;">4. FINISH QUALITY</label>
            <select id="calc-quality" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
              <option value="basic">Standard / Basic (₦65,000/sqm)</option>
              <option value="mid" selected>Mid-Range (₦95,000/sqm)</option>
              <option value="luxury">Luxury / High-End (₦140,000/sqm)</option>
            </select>
          </div>

          <button id="calc-btn" class="btn btn-primary" style="width:100%; padding:16px; font-size:1.1rem; background:var(--gold);">Generate Bill of Quantities</button>
        </div>

        <!-- Results -->
        <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; display:flex; flex-direction:column; overflow-y:auto; max-height: 600px;">
          <h3 style="font-family:var(--display); font-size:1.2rem; color:var(--white); border-bottom:1px solid var(--line-light); padding-bottom:12px; margin-bottom:16px;">Cost Breakdown</h3>
          
          <div id="results-list" style="display:flex; flex-direction:column; gap:12px; font-size:0.95rem;">
            <div style="color:var(--text-muted); text-align:center; padding: 20px;">Select parameters and click Generate.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- PORTFOLIO -->
    <h2 style="font-size:2.5rem; margin-bottom:32px; text-align:center;">Our Recent Projects</h2>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(350px, 1fr)); gap:40px;">
      <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; background:var(--bg-card);">
        <div style="height:280px; background: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
        <div style="padding:32px;">
          <h3 style="font-size:1.4rem; margin-bottom:12px;">Lekki Penthouse Renovation</h3>
          <p style="color:var(--text-muted); font-size:0.9rem;">Complete structural remodel with Italian marble finishes, smart-home integration, and custom joinery.</p>
        </div>
      </div>
      <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; background:var(--bg-card);">
        <div style="height:280px; background: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
        <div style="padding:32px;">
          <h3 style="font-size:1.4rem; margin-bottom:12px;">Abuja Corporate HQ</h3>
          <p style="color:var(--text-muted); font-size:0.9rem;">5-storey office complex with LEED certification, solar integration, and smart building management.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Calculator Logic -->
  <script>
    // 1. Design Templates (Default SQM, Floors, Quality)
    const templates = {
      custom: { sqm: 150, floors: 1, quality: 'mid' },
      home: { sqm: 200, floors: 1, quality: 'mid' },
      villa: { sqm: 500, floors: 2, quality: 'luxury' },
      office: { sqm: 1200, floors: 4, quality: 'mid' },
      school: { sqm: 2500, floors: 2, quality: 'basic' },
      shop: { sqm: 60, floors: 1, quality: 'basic' }
    };

    // 2. Base Rates (per SQM)
    const rates = {
      basic: 65000,
      mid: 95000,
      luxury: 140000
    };

    // 3. Percentage Breakdown of total cost
    const breakdown = [
      { label: 'Preliminaries (Permits, Site Setup, Survey)', pct: 0.05 },
      { label: 'Substructure (Foundation, Excavation)', pct: 0.15 },
      { label: 'Superstructure (Blockwork, Concrete, Rebar)', pct: 0.25 },
      { label: 'Roofing (Trusses, Sheets, Fascia)', pct: 0.10 },
      { label: 'Plumbing & Mechanical', pct: 0.06 },
      { label: 'Electrical & IT Infrastructure', pct: 0.06 },
      { label: 'Finishes (Tiles, Paint, Doors, Windows)', pct: 0.20 },
      { label: 'External Works (Fencing, Landscaping, Driveway)', pct: 0.03 },
      { label: 'Professional Fees (Architect, Engineer, PM)', pct: 0.05 },
      { label: 'Contingency Fund (10%)', pct: 0.05 }
    ];

    const templateSelect = document.getElementById('calc-template');
    const sqmInput = document.getElementById('calc-sqm');
    const floorsInput = document.getElementById('calc-floors');
    const qualitySelect = document.getElementById('calc-quality');

    // Update inputs when template changes
    templateSelect.addEventListener('change', (e) => {
      const t = templates[e.target.value];
      sqmInput.value = t.sqm;
      floorsInput.value = t.floors;
      qualitySelect.value = t.quality;
    });

    // Calculate button
    document.getElementById('calc-btn').addEventListener('click', () => {
      const sqm = Number(sqmInput.value);
      const floors = Number(floorsInput.value);
      const quality = qualitySelect.value;

      if (!sqm || !floors) return alert('Please enter valid square meters and floors.');

      const totalBaseCost = sqm * rates[quality] * floors;
      const fmt = (num) => '₦' + Math.round(num).toLocaleString();

      let html = '';
      breakdown.forEach(item => {
        const amount = totalBaseCost * item.pct;
        html += `
          <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line-light); padding-bottom:8px;">
            <span style="color:var(--text-muted); width: 70%;">${item.label}</span>
            <span style="color:var(--white); font-family:var(--mono); font-weight:600;">${fmt(amount)}</span>
          </div>
        `;
      });

      // Grand Total
      html += `
        <div style="display:flex; justify-content:space-between; margin-top:16px; padding-top:16px; border-top:2px solid var(--gold);">
          <span style="color:var(--gold); font-weight:700; font-size:1.2rem;">Total Estimate</span>
          <span style="color:var(--gold); font-weight:700; font-size:1.4rem; font-family:var(--mono);">${fmt(totalBaseCost)}</span>
        </div>
        <div style="text-align:center; margin-top:16px;">
          <a href="/contact" class="btn btn-outline" style="font-size:0.8rem; padding:8px 16px;">Request Formal Quote</a>
        </div>
      `;

      document.getElementById('results-list').innerHTML = html;
    });
  </script>
</Layout>