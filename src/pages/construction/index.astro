---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: configData } = await supabase.from('absl_estimator_settings').select('*').eq('id', 'default').single();

const settings = (configData && configData.settings) ? configData.settings : {
  materials: [
    { id: 'cement', name: 'Cement', unit: 'bags', qtyPerSqm: 0.45, basePrice: 12500 },
    { id: 'rebar', name: 'Rebar', unit: 'tons', qtyPerSqm: 0.018, basePrice: 1250000 },
    { id: 'sand', name: 'Sand', unit: 'tons', qtyPerSqm: 0.040, basePrice: 45000 },
    { id: 'gravel', name: 'Gravel', unit: 'tons', qtyPerSqm: 0.035, basePrice: 55000 },
    { id: 'blocks', name: 'Blocks', unit: 'pcs', qtyPerSqm: 9.5, basePrice: 650 },
    { id: 'roofing', name: 'Roofing Sheets', unit: 'sheets', qtyPerSqm: 0.18, basePrice: 8500 },
    { id: 'timber', name: 'Timber', unit: 'planks', qtyPerSqm: 0.25, basePrice: 4500 },
    { id: 'tiles', name: 'Tiles', unit: 'sqm', qtyPerSqm: 1.08, basePrice: 6500 },
    { id: 'paint', name: 'Paint', unit: 'buckets', qtyPerSqm: 0.045, basePrice: 45000 },
    { id: 'doors', name: 'Doors', unit: 'units', qtyPerSqm: 0.018, basePrice: 85000 },
    { id: 'windows', name: 'Windows', unit: 'units', qtyPerSqm: 0.035, basePrice: 65000 },
    { id: 'electrical', name: 'Electrical Wiring', unit: 'm', qtyPerSqm: 2.8, basePrice: 850 },
    { id: 'plumbing', name: 'Plumbing', unit: 'sqm', qtyPerSqm: 1, basePrice: 12000 }
  ],
  finishing: [
    { id: 'cleaning', name: 'Post-Construction Cleaning', unit: 'sqm', basePrice: 1500, type: 'sqm' },
    { id: 'living', name: 'Living Room Set', unit: 'set', basePrice: 850000, type: 'set' },
    { id: 'bedroom', name: 'Bedroom Set', unit: 'set', basePrice: 650000, type: 'set' },
    { id: 'kitchen', name: 'Kitchen Appliances', unit: 'set', basePrice: 950000, type: 'set' },
    { id: 'curtains', name: 'Curtains', unit: 'sqm', basePrice: 8500, type: 'sqm' }
  ],
  laborMultiplier: 0.40,
  archFeeMultiplier: 0.10,
  utilities: [
    { id: 'elec', name: 'Electricity', unit: 'kWh', basePrice: 225, multiplier: 9 },
    { id: 'water', name: 'Water', unit: 'm3', basePrice: 350, multiplier: 16 },
    { id: 'gas', name: 'Gas', unit: 'cylinders', basePrice: 15500, multiplier: 2 },
    { id: 'waste', name: 'Waste Disposal', unit: 'flat', basePrice: 5000, multiplier: 1 }
  ]
};
const flwKey = import.meta.env.PUBLIC_FLUTTERWAVE_PUBLIC_KEY;
---

<Layout title="Construction Lifecycle Estimator - ABSL">
  <style is:global>
    .bp-wrap { --navy-950: #0a1628; --navy-900: #0e1d34; --navy-850: #11223c; --navy-800: #132846; --navy-700: #1c3358; --gold: #f5a623; --gold-soft: rgba(245, 166, 35, 0.12); --ink: #edf1f7; --ink-muted: #8a96ac; --ink-faint: #5c6883; --line: rgba(245, 166, 35, 0.16); --line-soft: rgba(255, 255, 255, 0.06); --display: "Space Grotesk", sans-serif; --body: "Inter", sans-serif; --mono: "IBM Plex Mono", monospace; font-family: var(--body); background: var(--navy-950); color: var(--ink); padding: 40px 20px 80px; border-radius: 16px; margin-top: 20px; position: relative; }
    .bp-wrap::before { content:""; position:absolute; inset:0; background-image: repeating-linear-gradient(0deg, rgba(245,166,35,.045) 0 1px, transparent 1px 40px), repeating-linear-gradient(90deg, rgba(245,166,35,.045) 0 1px, transparent 1px 40px), repeating-linear-gradient(0deg, rgba(245,166,35,.06) 0 1px, transparent 1px 200px), repeating-linear-gradient(90deg, rgba(245,166,35,.06) 0 1px, transparent 1px 200px); pointer-events:none; z-index:0; border-radius: 16px; }
    .bp-container { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }
    .bp-sheet { background:var(--navy-900); border:1px solid var(--line-soft); border-radius:14px; padding:26px; margin-bottom:24px; position:relative; overflow:hidden; }
    .bp-sheet::before { content:""; position:absolute; top:0; left:0; width:100%; height:3px; background:linear-gradient(90deg,var(--gold),transparent 70%); }
    .bp-sheet-head { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:20px; flex-wrap:wrap; gap:16px;}
    .bp-eyebrow { font-family:var(--mono); font-size:11px; letter-spacing:.12em; color:var(--gold); text-transform:uppercase; }
    .bp-title { font-family:var(--display); font-size:20px; font-weight:600; margin:4px 0 0; color:var(--ink); }
    .bp-sub { font-family:var(--body); font-size:13px; color:var(--ink-muted); margin-top:6px; max-width:520px; }
    .bp-num { font-family:var(--mono); font-size:11px; color:var(--ink-faint); border:1px solid var(--line); border-radius:20px; padding:5px 12px; white-space:nowrap; }
    .bp-inputs-grid { display:grid; grid-template-columns:1.3fr 1fr 1.2fr 1fr; gap:24px; }
    .bp-field { display:flex; flex-direction:column; gap:10px; }
    .bp-field label { font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:.07em; color:var(--ink-muted); display:flex; justify-content:space-between;}
    .bp-field label .val { color:var(--gold); font-weight:600; }
    input[type=range] { -webkit-appearance:none; width:100%; height:4px; border-radius:2px; background:var(--navy-700); outline:none; }
    input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:18px; height:18px; border-radius:50%; background:var(--gold); border:3px solid var(--navy-950); cursor:pointer; box-shadow:0 0 0 1px var(--gold); }
    .bp-manual-input { margin-top:8px; width:100%; background:var(--navy-800); border:1px solid var(--line); border-radius:6px; color:var(--gold); font-family:var(--mono); font-size:12.5px; padding:7px 9px; text-align:center; }
    .bp-segmented { display:flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
    .bp-segmented button { flex:1; background:transparent; border:none; border-right:1px solid var(--line); color:var(--ink-muted); font-family:var(--body); font-size:13px; font-weight:600; padding:10px 6px; cursor:pointer; transition:.15s; }
    .bp-segmented button:last-child { border-right:none; }
    .bp-segmented button.active { background:var(--gold); color:var(--navy-950); }
    .bp-toggle-row { display:flex; align-items:center; gap:12px; height:38px; }
    .bp-switch { position:relative; width:46px; height:26px; flex-shrink:0; }
    .bp-switch input { opacity:0; width:0; height:0; }
    .bp-slider { position:absolute; inset:0; background:var(--navy-700); border-radius:14px; cursor:pointer; transition:.2s; border:1px solid var(--line); }
    .bp-slider::before { content:""; position:absolute; width:18px; height:18px; left:3px; top:3px; background:var(--ink-muted); border-radius:50%; transition:.2s; }
    .bp-switch input:checked + .bp-slider { background:var(--gold-soft); border-color:var(--gold); }
    .bp-switch input:checked + .bp-slider::before { transform:translateX(20px); background:var(--gold); }
    .bp-table-scroll { overflow-x:auto; border:1px solid var(--line-soft); border-radius:10px; }
    .bp-table { width:100%; border-collapse:collapse; font-family:var(--mono); font-size:13px; min-width:680px; }
    .bp-table th { text-align:left; background:var(--navy-850); color:var(--ink-faint); font-size:10.5px; text-transform:uppercase; letter-spacing:.07em; padding:11px 14px; border-bottom:1px solid var(--line); font-weight:600; }
    .bp-table td { padding:10px 14px; border-bottom:1px solid var(--line-soft); color:var(--ink); vertical-align:middle; }
    .bp-table tr:hover { background:rgba(245,166,35,.035); }
    .bp-table td.mat-name { font-family:var(--body); font-weight:600; }
    .bp-table td.mat-name .unit-tag { display:block; font-family:var(--mono); font-size:10.5px; color:var(--ink-faint); font-weight:400; margin-top:2px; }
    .bp-table .num { text-align:right; }
    .bp-table tfoot td { padding:14px; font-family:var(--display); font-weight:600; font-size:15px; border-top:1px solid var(--line); }
    .bp-price-input { width:110px; background:var(--navy-800); border:1px solid var(--line); border-radius:6px; color:var(--gold); font-family:var(--mono); font-size:12.5px; padding:7px 9px; text-align:right; }
    .bp-line-list { display:flex; flex-direction:column; border:1px solid var(--line-soft); border-radius:10px; overflow:hidden; }
    .bp-line-row { display:grid; grid-template-columns:2.5fr 1fr 1fr 1fr; gap:14px; align-items:center; padding:13px 16px; border-bottom:1px solid var(--line-soft); }
    .bp-line-row:last-child { border-bottom:none; }
    .bp-line-row:nth-child(even) { background:rgba(255,255,255,.015); }
    .bp-line-name { font-family:var(--body); font-weight:600; font-size:13.5px; display:flex; align-items:center; gap:8px; }
    .bp-line-meta { font-family:var(--mono); font-size:12px; color:var(--ink-muted); text-align:right; }
    .bp-line-total { font-family:var(--mono); font-size:13.5px; color:var(--gold); text-align:right; font-weight:600; }
    .bp-subtotal-bar { display:flex; justify-content:space-between; align-items:center; margin-top:16px; padding:14px 18px; background:var(--navy-850); border:1px solid var(--line); border-radius:10px; }
    .bp-subtotal-bar .label { font-family:var(--mono); font-size:11px; text-transform:uppercase; color:var(--ink-muted); }
    .bp-subtotal-bar .amount { font-family:var(--display); font-size:19px; font-weight:700; color:var(--gold); }
    .bp-summary-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:28px; align-items:start; }
    .bp-grand-card { background:linear-gradient(160deg,var(--navy-850),var(--navy-900)); border:1px solid var(--gold); border-radius:14px; padding:30px; text-align:center; }
    .bp-grand-card .g-label { font-family:var(--mono); font-size:11.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--gold); }
    .bp-grand-card .g-amount { font-family:var(--display); font-size:44px; font-weight:700; color:var(--ink); margin:10px 0 6px; word-break:break-word; }
    .bp-grand-card .g-sub { font-family:var(--mono); font-size:12px; color:var(--ink-muted); }
    .bp-legend { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:20px; text-align:left; }
    .bp-legend-item { display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:11.5px; color:var(--ink-muted); }
    .bp-legend-dot { width:10px; height:10px; border-radius:3px; flex-shrink:0; }
    .bp-legend-item b { color:var(--ink); font-weight:600; margin-left:auto; }
    .bp-chart-card { background:var(--navy-850); border:1px solid var(--line-soft); border-radius:14px; padding:20px; }
    .bp-btn-pdf { margin-top:10px; width:100%; background:var(--gold-soft); border:1px solid var(--gold); color:var(--gold); font-family:var(--mono); font-size:11.5px; text-transform:uppercase; padding:11px; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px; transition:.15s; }
    .bp-btn-pdf:hover { background:var(--gold); color:var(--navy-950); }
    @media(max-width:900px) { .bp-inputs-grid { grid-template-columns:1fr 1fr; } .bp-summary-grid { grid-template-columns:1fr; } .bp-line-row { grid-template-columns:2fr 1fr 1fr; } .bp-line-row .col-price { display:none; } }
    @media(max-width:560px) { .bp-inputs-grid { grid-template-columns:1fr; } .bp-sheet { padding:20px 16px; } .bp-grand-card .g-amount { font-size:32px; } }
  </style>

  <div class="container" style="padding: 40px 24px;">
    <div class="bp-wrap">
      <div class="bp-container">
        
        <section class="bp-sheet">
          <div class="bp-sheet-head">
            <div><div class="bp-eyebrow">Project Parameters</div><div class="bp-title">Define the build</div></div>
            <div class="bp-num">SHEET 00 / 03</div>
          </div>
          <div class="bp-inputs-grid">
            <div class="bp-field">
              <label>Floor Area (Per Floor) <span class="val" id="sqmVal">120 m²</span></label>
              <input type="range" id="sqmSlider" min="50" max="5000" step="10" value="120">
              <input type="text" inputmode="numeric" class="bp-manual-input" id="sqmManual" value="120">
            </div>
            <div class="bp-field">
              <label>Floors <span class="val" id="floorsVal">1</span></label>
              <input type="range" id="floorsSlider" min="1" max="100" step="1" value="1">
              <input type="text" inputmode="numeric" class="bp-manual-input" id="floorsManual" value="1">
            </div>
            <div class="bp-field">
              <label>Build Quality</label>
              <div class="bp-segmented" id="qualitySeg">
                <button data-q="basic">Basic</button>
                <button data-q="mid" class="active">Mid</button>
                <button data-q="luxury">Luxury</button>
              </div>
            </div>
            <div class="bp-field">
              <label>Furnishing</label>
              <div class="bp-toggle-row">
                <label class="bp-switch">
                  <input type="checkbox" id="furnishToggle" checked>
                  <span class="bp-slider"></span>
                </label>
                <span style="font-family:var(--body); font-size:13px; font-weight:600;" id="furnishLabel">Included</span>
              </div>
            </div>
          </div>
        </section>

        <section class="bp-sheet">
          <div class="bp-sheet-head">
            <div><div class="bp-eyebrow">Phase 01 — Setup</div><div class="bp-title">Bill of Quantities</div></div>
            <div class="bp-num">SHEET 01 / 03</div>
          </div>
          <div class="bp-table-scroll">
            <table class="bp-table">
              <thead><tr><th>Material</th><th class="num">Quantity</th><th class="num">Suggested</th><th class="num">Custom Price</th><th class="num">Subtotal</th></tr></thead>
              <tbody id="boqBody"></tbody>
              <tfoot><tr><td colspan="4">Materials Subtotal</td><td class="num" id="materialsSubtotal">—</td></tr></tfoot>
            </table>
          </div>
        </section>

        <section class="bp-sheet">
          <div class="bp-sheet-head">
            <div><div class="bp-eyebrow">Phase 02 — Handover</div><div class="bp-title">Finishing & Furnishing</div></div>
            <div class="bp-num">SHEET 02 / 03</div>
          </div>
          <div class="bp-line-list" id="phase2List"></div>
          <div class="bp-subtotal-bar"><span class="label">Phase 02 Subtotal</span><span class="amount" id="phase2Subtotal">—</span></div>
        </section>

        <section class="bp-sheet">
          <div class="bp-sheet-head">
            <div><div class="bp-eyebrow">Phase 03 — Recurring</div><div class="bp-title">Monthly Utility Burn</div></div>
            <div class="bp-num">SHEET 03 / 03</div>
          </div>
          <div class="bp-line-list" id="phase3List"></div>
          <div class="bp-subtotal-bar"><span class="label">Total Monthly Running Cost</span><span class="amount" id="monthlyTotal">—</span></div>
        </section>

        <section class="bp-sheet">
          <div class="bp-sheet-head"><div><div class="bp-eyebrow">Grand Summary</div><div class="bp-title">Total project cost</div></div></div>
          <div class="bp-summary-grid">
            <div class="bp-grand-card">
              <div class="g-label">Total Construction + Furnishing Cost</div>
              <div class="g-amount" id="grandTotal">—</div>
              <div class="g-sub">Materials + Labor + Professional Fees + Finishing</div>
              <div class="bp-legend" id="legend"></div>
            </div>
            <div class="bp-chart-card" style="display:flex; flex-direction:column; justify-content:center; gap:16px;">
              <a href="/contact?subject=Professional+BOQ+Request" class="bp-btn-pdf" style="background:#0b1e3a; color:#fff; border:none; text-align:center; padding:16px; border-radius:8px; font-weight:700; text-decoration:none; font-family:var(--mono); font-size:12px;">🤝 Contact us for a more professional BOQ</a>
              <button id="supply-btn" class="bp-btn-pdf" style="background:#d97d2b; color:#fff; border:none; text-align:center; padding:16px; border-radius:8px; font-weight:700; font-family:var(--mono); font-size:12px; cursor:pointer;">🧱 Request ABSL to Supply Building Materials</button>
              <button onclick="window.print()" class="bp-btn-pdf" style="background:transparent; border:1px solid var(--gold); color:var(--gold); padding:16px; border-radius:8px; font-weight:700; font-family:var(--mono); font-size:12px; cursor:pointer;">📄 Download PDF Summary</button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <div id="supply-modal" style="display:none; position:fixed; inset:0; background:rgba(10,17,40,0.9); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px); padding:20px;">
    <div style="background:var(--bg-surface); border:1px solid var(--gold); border-radius:16px; width:100%; max-width:700px; max-height:90vh; display:flex; flex-direction:column;">
      <div style="padding:24px; border-bottom:1px solid var(--line-light); display:flex; justify-content:space-between; align-items:center;">
        <div><h2 style="color:var(--white); font-size:1.5rem; margin:0;">ABSL Material Supply</h2><p style="color:var(--text-muted); font-size:0.9rem; margin:4px 0 0 0;">Select the materials you want ABSL to supply and pay securely.</p></div>
        <button id="close-modal" style="background:none; border:none; color:var(--white); font-size:1.5rem; cursor:pointer;">✕</button>
      </div>
      <div style="padding:24px; overflow-y:auto; flex:1;">
        <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:13px;">
          <thead><tr style="text-align:left; border-bottom:1px solid var(--line-light);"><th style="padding:12px 8px; width:40px;"><input type="checkbox" id="select-all" checked /></th><th style="padding:12px 8px; color:var(--gold);">Material</th><th style="padding:12px 8px; color:var(--gold); text-align:center;">Qty</th><th style="padding:12px 8px; color:var(--gold); text-align:right;">Price</th></tr></thead>
          <tbody id="invoice-body"></tbody>
        </table>
      </div>
      <div style="padding:24px; border-top:1px solid var(--line-light); background:var(--bg-card);">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:16px;">
          <span style="color:var(--text-muted); font-size:0.9rem;">Includes 10% handling & logistics fee</span>
          <div style="text-align:right;"><span style="color:var(--text-muted); font-size:0.8rem; text-transform:uppercase;">Total to Pay</span><div id="invoice-total" style="color:var(--gold); font-size:1.8rem; font-weight:700; font-family:var(--mono);">₦0</div></div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;">
          <input id="inv-name" type="text" placeholder="Your Full Name" style="padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          <input id="inv-email" type="email" placeholder="Email for Receipt" style="padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>
        <div style="margin-bottom:16px;"><input id="inv-phone" type="tel" placeholder="Phone Number (for delivery)" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" /></div>
        <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:12px; margin-top:8px;">
          <button id="save-inv-btn" style="padding:12px; background:transparent; border:1px solid var(--gold); color:var(--gold); border-radius:8px; font-weight:700; font-family:var(--mono); font-size:11px; cursor:pointer;">📄 Save Invoice</button>
          <button type="button" id="add-cart-btn" style="padding:12px; background:transparent; border:1px solid var(--gold); color:var(--gold); border-radius:8px; font-weight:700; font-family:var(--mono); font-size:11px; cursor:pointer;">🛒 Add to Cart</button>
          <button id="pay-btn" style="padding:12px; background:#d97d2b; color:#fff; border:none; border-radius:8px; font-weight:700; font-family:var(--mono); font-size:11px; cursor:pointer;">💳 Pay Now</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ settings, flwKey }}>
    document.addEventListener('DOMContentLoaded', () => {
      let savedOverrides = JSON.parse(localStorage.getItem('absl_budget_overrides')) || {};
      for (const key in savedOverrides) { if (savedOverrides[key] <= 0) delete savedOverrides[key]; }
      let currentState = { area: 120, floors: 1, quality: 'mid', furnish: true, overrides: savedOverrides };
      
      // Custom furnishing state: { itemId: qty }
      let furnishingQtys = JSON.parse(localStorage.getItem('absl_furnishing_qtys')) || {};
      
      let currentMaterials = [];
      const QUALITY_QTY_MULT = { basic: 0.85, mid: 1.0, luxury: 1.15 };
      const QUALITY_PRICE_MULT = { basic: 1.0, mid: 1.0, luxury: 1.30 };
      const QUALITY_WATTS_SQM = { basic: 35, mid: 50, luxury: 70 };

      function fmtMoney(v) { return '₦' + Math.round(v).toLocaleString(); }
      function totalSqm() { return currentState.area * currentState.floors; }

      function render() {
        const qQty = QUALITY_QTY_MULT[currentState.quality];
        const qPrice = QUALITY_PRICE_MULT[currentState.quality];
        
        // --- RENDER BOQ ---
        const tbody = document.getElementById('boqBody');
        tbody.innerHTML = '';
        let matSubtotal = 0;
        currentMaterials = [];

        settings.materials.forEach(m => {
          // REALISTIC SCALING
          const qty = m.qtyPerSqm * totalSqm() * qQty;
          const displayQty = ['bags','pcs','sheets','planks','buckets','units'].includes(m.unit) ? Math.max(1, Math.ceil(qty)) : qty;
          const basePrice = m.basePrice * qPrice;
          const override = currentState.overrides[m.id];
          const price = (override !== undefined && override > 0) ? override : basePrice;
          const rowSub = displayQty * price;
          matSubtotal += rowSub;

          currentMaterials.push({ id: m.id, name: m.name, unit: m.unit, qty: displayQty, price: price });

          tbody.innerHTML += `
            <tr style="border-bottom:1px solid var(--line-soft);">
              <td style="padding:12px 8px; color:var(--ink);">${m.name}<br><span style="font-size:10px; color:var(--ink-muted);">${m.unit}</span></td>
              <td style="padding:12px 8px; text-align:center; color:var(--ink-muted);">${displayQty.toLocaleString()}</td>
              <td style="padding:12px 8px; text-align:right; color:var(--ink-muted);">${fmtMoney(basePrice)}</td>
              <td style="padding:12px 8px; text-align:right;"><input type="number" data-id="${m.id}" class="price-input" value="${price.toFixed(2)}" style="width:90px; padding:6px; background:var(--navy-800); border:1px solid var(--line); color:var(--gold); border-radius:4px; text-align:right; font-family:var(--mono); font-size:12px;" /></td>
              <td style="padding:12px 8px; text-align:right; color:var(--gold); font-weight:600;">${fmtMoney(rowSub)}</td>
            </tr>
          `;
        });
        document.getElementById('materialsSubtotal').textContent = fmtMoney(matSubtotal);

        // --- RENDER PHASE 2 (Dynamic Finishing) ---
        let p2Subtotal = 0;
        let p2Html = '';

        if (settings.finishing) {
          settings.finishing.forEach(f => {
            if (f.type === 'sqm') {
              const qty = totalSqm();
              const cost = qty * f.basePrice;
              p2Subtotal += cost;
              p2Html += `
                <div class="bp-line-row">
                  <span class="bp-line-name">${f.name}</span>
                  <span class="bp-line-meta">${qty} ${f.unit}</span>
                  <span class="bp-line-meta col-price">${fmtMoney(f.basePrice)}</span>
                  <span class="bp-line-total">${fmtMoney(cost)}</span>
                </div>
              `;
            } else if (f.type === 'set') {
              const currentQty = currentState.furnish ? (furnishingQtys[f.id] !== undefined ? furnishingQtys[f.id] : 1) : 0;
              const cost = currentQty * f.basePrice;
              p2Subtotal += cost;
              p2Html += `
                <div class="bp-line-row">
                  <span class="bp-line-name">
                    <input type="checkbox" class="furn-check" data-id="${f.id}" ${currentQty > 0 ? 'checked' : ''} style="cursor:pointer;" />
                    ${f.name}
                  </span>
                  <span class="bp-line-meta" style="display:flex; justify-content:flex-end; align-items:center; gap:8px;">
                    Qty: <input type="number" data-id="${f.id}" class="furn-qty" value="${currentQty}" min="0" ${!currentState.furnish ? 'disabled' : ''} style="width:60px; padding:4px; background:var(--navy-800); border:1px solid var(--line); color:var(--white); border-radius:4px; text-align:center;" />
                  </span>
                  <span class="bp-line-meta col-price">${fmtMoney(f.basePrice)} / set</span>
                  <span class="bp-line-total">${fmtMoney(cost)}</span>
                </div>
              `;
            }
          });
        }

        const labor = matSubtotal * settings.laborMultiplier;
        const arch = matSubtotal * settings.archFeeMultiplier;
        p2Html += `<div class="bp-line-row"><span class="bp-line-name" style="color:var(--gold);">Labor</span><span class="bp-line-meta">${(settings.laborMultiplier*100).toFixed(0)}%</span><span class="bp-line-meta col-price"></span><span class="bp-line-total">${fmtMoney(labor)}</span></div>`;
        p2Html += `<div class="bp-line-row"><span class="bp-line-name" style="color:var(--gold);">Architect Fee</span><span class="bp-line-meta">${(settings.archFeeMultiplier*100).toFixed(0)}%</span><span class="bp-line-meta col-price"></span><span class="bp-line-total">${fmtMoney(arch)}</span></div>`;
        p2Subtotal += labor + arch;

        document.getElementById('phase2List').innerHTML = p2Html;
        document.getElementById('phase2Subtotal').textContent = fmtMoney(p2Subtotal);

        // --- RENDER PHASE 3 ---
        let monthlyTotal = 0;
        let p3Html = '';
        if (settings.utilities) {
          settings.utilities.forEach(u => {
            let qty = 0;
            if (u.id === 'elec') qty = (totalSqm() * QUALITY_WATTS_SQM[currentState.quality] * 6 * 30) / 1000;
            else if (u.id === 'water') qty = 4 * 4;
            else qty = u.multiplier || 1;
            const cost = qty * u.basePrice;
            monthlyTotal += cost;
            p3Html += `<div class="bp-line-row"><span class="bp-line-name">${u.name}</span><span class="bp-line-meta">${qty.toFixed(u.id === 'elec' ? 0 : 1)} ${u.unit}</span><span class="bp-line-meta col-price">${fmtMoney(u.basePrice)}</span><span class="bp-line-total">${fmtMoney(cost)}</span></div>`;
          });
        }
        document.getElementById('phase3List').innerHTML = p3Html;
        document.getElementById('monthlyTotal').textContent = fmtMoney(monthlyTotal);

        // --- SUMMARY ---
        const grand = matSubtotal + p2Subtotal;
        document.getElementById('grandTotal').textContent = fmtMoney(grand);
        document.getElementById('legend').innerHTML = `
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#f5a623"></span> Materials <b>${fmtMoney(matSubtotal)}</b></div>
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#3ddc97"></span> Labor <b>${fmtMoney(labor)}</b></div>
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#5b8def"></span> Prof. Fees <b>${fmtMoney(arch)}</b></div>
          <div class="bp-legend-item"><span class="bp-legend-dot" style="background:#ef6a5f"></span> Finishing <b>${fmtMoney(p2Subtotal - labor - arch)}</b></div>
        `;
      }

      // Toggle Furnishing On/Off
      document.getElementById('furnishToggle').addEventListener('change', e => {
        currentState.furnish = e.target.checked;
        document.getElementById('furnishLabel').textContent = currentState.furnish ? 'Included' : 'Excluded';
        Object.keys(furnishingQtys).forEach(k => furnishingQtys[k] = currentState.furnish ? 1 : 0);
        localStorage.setItem('absl_furnishing_qtys', JSON.stringify(furnishingQtys));
        render();
      });

      // Furnishing Quantity Input Logic
      document.addEventListener('change', (e) => {
        if (e.target.classList.contains('furn-qty')) {
          const id = e.target.dataset.id;
          furnishingQtys[id] = Math.max(0, Number(e.target.value));
          localStorage.setItem('absl_furnishing_qtys', JSON.stringify(furnishingQtys));
          render();
        }
        if (e.target.classList.contains('furn-check')) {
          const id = e.target.dataset.id;
          furnishingQtys[id] = e.target.checked ? 1 : 0;
          localStorage.setItem('absl_furnishing_qtys', JSON.stringify(furnishingQtys));
          render();
        }
      });

      // SYNCED INPUT LISTENERS
      const sqmSlider = document.getElementById('sqmSlider'); const sqmManual = document.getElementById('sqmManual');
      const floorsSlider = document.getElementById('floorsSlider'); const floorsManual = document.getElementById('floorsManual');
      
      function updateSqm(val) { const num = Math.min(5000, Math.max(50, Number(val) || 50)); currentState.area = num; sqmSlider.value = num; sqmManual.value = num; document.getElementById('sqmVal').textContent = num + ' m²'; render(); }
      function updateFloors(val) { const num = Math.min(100, Math.max(1, Number(val) || 1)); currentState.floors = num; floorsSlider.value = num; floorsManual.value = num; document.getElementById('floorsVal').textContent = num; render(); }
      
      sqmSlider.addEventListener('input', e => updateSqm(e.target.value)); sqmManual.addEventListener('input', e => updateSqm(e.target.value));
      floorsSlider.addEventListener('input', e => updateFloors(e.target.value)); floorsManual.addEventListener('input', e => updateFloors(e.target.value));

      document.querySelectorAll('.bp-segmented button').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.bp-segmented button').forEach(b => { b.classList.remove('active'); b.style.background='transparent'; b.style.color='var(--ink-muted)'; });
          btn.classList.add('active'); btn.style.background='var(--gold)'; btn.style.color='var(--navy-950)';
          currentState.quality = btn.dataset.q;
          render();
        });
      });

      document.addEventListener('change', e => {
        if (e.target.classList.contains('price-input')) {
          currentState.overrides[e.target.dataset.id] = Number(e.target.value);
          localStorage.setItem('absl_budget_overrides', JSON.stringify(currentState.overrides));
          render();
        }
      });

      // Initial render
      render();

      // --- INVOICE MODAL LOGIC ---
      const modal = document.getElementById('supply-modal');
      const invBody = document.getElementById('invoice-body');
      
      document.getElementById('supply-btn').addEventListener('click', () => {
        invBody.innerHTML = currentMaterials.map((m, idx) => `
          <tr style="border-bottom:1px solid var(--line-light);">
            <td style="padding:12px 8px;"><input type="checkbox" class="mat-check" data-idx="${idx}" checked /></td>
            <td style="padding:12px 8px; color:var(--white);">${m.name}</td>
            <td style="padding:12px 8px; text-align:center; color:var(--text-muted);">${m.qty} ${m.unit}</td>
            <td style="padding:12px 8px; text-align:right; color:var(--gold);">${fmtMoney(m.price * m.qty)}</td>
          </tr>
        `).join('');
        updateInvoiceTotal();
        modal.style.display = 'flex';
      });

      document.getElementById('close-modal').onclick = () => modal.style.display = 'none';

      function updateInvoiceTotal() {
        let total = 0;
        document.querySelectorAll('.mat-check').forEach(chk => {
          if (chk.checked) { total += currentMaterials[chk.dataset.idx].qty * currentMaterials[chk.dataset.idx].price; }
        });
        total = total * 1.10; // 10% fee
        document.getElementById('invoice-total').textContent = fmtMoney(total);
      }

      document.getElementById('select-all').addEventListener('change', (e) => {
        document.querySelectorAll('.mat-check').forEach(chk => chk.checked = e.target.checked);
        updateInvoiceTotal();
      });

      document.addEventListener('change', (e) => {
        if (e.target.classList.contains('mat-check')) updateInvoiceTotal();
      });

      // --- SAVE INVOICE (Restored with Params) ---
      document.getElementById('save-inv-btn').addEventListener('click', () => {
        const selectedItems = [];
        document.querySelectorAll('.mat-check').forEach(chk => {
          if (chk.checked) selectedItems.push(currentMaterials[chk.dataset.idx]);
        });
        if (selectedItems.length === 0) return alert('Please select at least one material.');

        let text = "ABSL MATERIAL SUPPLY - INVOICE\n";
        text += "Date: " + new Date().toLocaleDateString() + "\n\n";
        text += "PROJECT PARAMETERS:\n";
        text += `- Floor Area: ${currentState.area} m²\n`;
        text += `- Floors: ${currentState.floors}\n`;
        text += `- Build Quality: ${currentState.quality.toUpperCase()}\n`;
        text += `- Furnishing: ${currentState.furnish ? 'Included' : 'Excluded'}\n\n`;
        text += "SELECTED MATERIALS:\n";
        text += "----------------------------------------\n";
        
        let total = 0;
        selectedItems.forEach(m => {
          const lineTotal = m.qty * m.price;
          total += lineTotal;
          text += `${m.name} (${m.qty} ${m.unit}) - ₦${lineTotal.toLocaleString()}\n`;
        });
        
        text += "----------------------------------------\n";
        text += `Subtotal: ₦${total.toLocaleString()}\n`;
        text += `Handling (10%): ₦${(total * 0.1).toLocaleString()}\n`;
        text += `TOTAL: ₦${(total * 1.1).toLocaleString()}\n\n`;
        text += "ABSL Support: +2348033355060 | accounts@absl.com.ng\n";

        const blob = new Blob([text], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `ABSL_Invoice_${Date.now()}.txt`;
        a.click();
        URL.revokeObjectURL(url);
      });

      // --- ADD TO CART (Restored with Params) ---
      document.getElementById('add-cart-btn').addEventListener('click', () => {
        const selectedItems = [];
        document.querySelectorAll('.mat-check').forEach(chk => {
          if (chk.checked) selectedItems.push(currentMaterials[chk.dataset.idx]);
        });
        if (selectedItems.length === 0) return alert('Please select at least one material.');

        let cart = JSON.parse(localStorage.getItem('absl_cart') || '[]');
        
        cart.push({
          id: 'proj-' + Date.now(),
          title: `Project Parameters: ${currentState.area}m², ${currentState.floors} Floor(s), ${currentState.quality.toUpperCase()}, Furnishing ${currentState.furnish ? 'Incl' : 'Excl'}`,
          price: 0, category: 'Project Specs', maxQty: 1, qty: 1
        });

        selectedItems.forEach(m => {
          const existingItem = cart.find(i => i.id === m.id);
          if (existingItem) { existingItem.qty = Math.round(existingItem.qty + m.qty); } 
          else { cart.push({ id: m.id, title: m.name + ' (Material)', price: m.price, category: 'Materials', maxQty: 9999, qty: m.qty }); }
        });

        localStorage.setItem('absl_cart', JSON.stringify(cart));
        window.dispatchEvent(new Event('absl-cart-updated'));
        alert('Materials added to cart!');
        window.location.href = '/checkout';
      });

      // --- FLUTTERWAVE PAYMENT (Restored with Params) ---
      document.getElementById('pay-btn').addEventListener('click', () => {
        const name = document.getElementById('inv-name').value.trim();
        const email = document.getElementById('inv-email').value.trim();
        const phone = document.getElementById('inv-phone').value.trim();
        if (!name || !email || !phone) return alert('Please fill in all contact fields.');

        const selectedItems = [];
        document.querySelectorAll('.mat-check').forEach(chk => {
          if (chk.checked) selectedItems.push(currentMaterials[chk.dataset.idx]);
        });
        if (selectedItems.length === 0) return alert('Please select at least one material.');

        let total = selectedItems.reduce((s, m) => s + (m.qty * m.price), 0);
        total = total * 1.10;
        const txRef = 'ABSL-MAT-' + Math.floor((Math.random() * 1000000000) + 1);

        FlutterwaveCheckout({
          public_key: flwKey,
          tx_ref: txRef,
          amount: total,
          currency: "NGN",
          customer: { email, phone_number: phone, name },
          customizations: {
            title: "ABSL Material Supply",
            description: `Project: ${currentState.area}m², ${currentState.floors} Floor(s), ${currentState.quality.toUpperCase()}`,
            logo: "https://absl.com.ng/absl-logo.png"
          },
          meta: { area: currentState.area, floors: currentState.floors, quality: currentState.quality, furnishing: currentState.furnish },
          callback: async (data) => {
            document.getElementById('pay-btn').textContent = 'Verifying...';
            document.getElementById('pay-btn').disabled = true;
            try {
              const res = await fetch('/api/material-supply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  transaction_id: data.transaction_id, tx_ref: txRef, amount: total,
                  customer_name: name, customer_email: email, customer_phone: phone, items: selectedItems
                })
              });
              if (res.ok) { alert('Payment successful! A receipt has been sent to your email.'); modal.style.display = 'none'; } 
              else { alert('Payment verification failed. Please contact support.'); }
            } catch (err) { alert('Error verifying payment.'); } 
            finally { document.getElementById('pay-btn').textContent = 'Pay with Flutterwave'; document.getElementById('pay-btn').disabled = false; }
          },
          onclose: () => {}
        });
      });
    });
  </script>
