---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Construction & Remodeling - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <h1 style="font-size:3rem; margin-bottom:16px;">Construction & Remodeling</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px;">Premium residential and commercial builds, from architectural design to project handover, with certified craftsmanship and a 10-year structural guarantee.</p>
    </div>
  </div>

  <div class="container" style="padding: 80px 0;">
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(350px, 1fr)); gap:40px;">
      
      <!-- Project 1 -->
      <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; background:var(--bg-card);">
        <div style="height:280px; background: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
        <div style="padding:32px;">
          <div style="font-size:0.75rem; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;">Residential Remodel</div>
          <h3 style="font-size:1.4rem; margin-bottom:12px;">Lekki Penthouse Renovation</h3>
          <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.7; margin-bottom:20px;">Complete structural remodel with Italian marble finishes, smart-home integration, and custom joinery.</p>
          <div style="display:flex; justify-content:space-between; border-top:1px solid var(--line-light); padding-top:16px;">
            <span style="color:var(--text-muted); font-size:0.85rem;">Budget: ₦45M</span>
            <span style="color:var(--gold); font-size:0.85rem; font-weight:600;">View Case Study &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Project 2 -->
      <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; background:var(--bg-card);">
        <div style="height:280px; background: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
        <div style="padding:32px;">
          <div style="font-size:0.75rem; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;">Commercial Build</div>
          <h3 style="font-size:1.4rem; margin-bottom:12px;">Abuja Corporate HQ</h3>
          <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.7; margin-bottom:20px;">5-storey office complex with LEED certification, solar integration, and smart building management.</p>
          <div style="display:flex; justify-content:space-between; border-top:1px solid var(--line-light); padding-top:16px;">
            <span style="color:var(--text-muted); font-size:0.85rem;">Budget: ₦320M</span>
            <span style="color:var(--gold); font-size:0.85rem; font-weight:600;">View Case Study &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Project 3 -->
      <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden; background:var(--bg-card);">
        <div style="height:280px; background: url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
        <div style="padding:32px;">
          <div style="font-size:0.75rem; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:12px;">Infrastructure</div>
          <h3 style="font-size:1.4rem; margin-bottom:12px;">Kano Logistics Warehouse</h3>
          <p style="color:var(--text-muted); font-size:0.9rem; line-height:1.7; margin-bottom:20px;">10,000 sqm cold-storage facility with automated racking and 24/7 security systems.</p>
          <div style="display:flex; justify-content:space-between; border-top:1px solid var(--line-light); padding-top:16px;">
            <span style="color:var(--text-muted); font-size:0.85rem;">Budget: ₦180M</span>
            <span style="color:var(--gold); font-size:0.85rem; font-weight:600;">View Case Study &rarr;</span>
          </div>
        </div>
      </div>

    </div>

    <div style="text-align:center; margin-top:64px; padding:48px; background:var(--bg-surface); border-radius:var(--r-md); border:1px solid var(--line-light);">
      <h3 style="font-size:1.8rem; margin-bottom:16px;">Have a Project in Mind?</h3>
      <p style="color:var(--text-muted); max-width:500px; margin:0 auto 24px;">Book a free consultation with our construction team. We'll provide a preliminary budget and timeline within 48 hours.</p>
      <a href="/contact" class="btn btn-primary">Book a Consultation</a>
    </div>
  </div>
</Layout>