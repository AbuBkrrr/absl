---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Track Your Shipment - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container" style="text-align:center; max-width: 800px;">
      <h1 style="font-size:3rem; margin-bottom:16px;">Track Your Cargo</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; margin-bottom:32px;">Enter your ABSL tracking number below to get real-time status updates.</p>
      
      <div style="display:flex; gap:12px; max-width:600px; margin:0 auto;">
        <input id="track-input" type="text" placeholder="e.g. ABSL-123456" style="flex:1; padding:16px; background:var(--bg-card); border:1px solid var(--line); color:var(--white); border-radius:var(--r-md); font-size:1.1rem; outline:none;" />
        <button id="track-btn" class="btn btn-primary" style="padding:0 32px; font-size:1.1rem;">Track</button>
      </div>
      <div id="error-msg" style="display:none; margin-top:16px; color:#ef4444; font-weight:600;"></div>
    </div>
  </div>

  <!-- Results Section -->
  <div class="container" style="padding: 60px 24px; min-height: 400px;">
    <div id="results-container" style="display:none; max-width: 800px; margin: 0 auto;">
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:40px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; border-bottom:1px solid var(--line-light); padding-bottom:20px; margin-bottom:24px;">
          <div>
            <div style="font-size:0.8rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Tracking Number</div>
            <div id="res-tracking" style="font-size:1.5rem; color:var(--white); font-family:var(--mono); font-weight:700;">-</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:0.8rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px;">Current Status</div>
            <div id="res-status" style="font-size:1.2rem; color:var(--gold); font-weight:700; text-transform:uppercase;">-</div>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:32px;">
          <div>
            <div style="font-size:0.8rem; color:var(--text-muted);">Origin</div>
            <div id="res-origin" style="color:var(--white); font-weight:600;">-</div>
          </div>
          <div>
            <div style="font-size:0.8rem; color:var(--text-muted);">Destination</div>
            <div id="res-dest" style="color:var(--white); font-weight:600;">-</div>
          </div>
        </div>

        <!-- Timeline -->
        <h3 style="font-size:1.2rem; color:var(--white); border-bottom:1px solid var(--line-light); padding-bottom:12px; margin-bottom:20px;">Shipment History</h3>
        <div id="timeline" style="display:flex; flex-direction:column; gap:20px;"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', async () => {
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      const supabase = createClient('https://xnlwfifnxtpsxbgmlshq.supabase.co', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhubHdmZGlmbmR0cHN4YmdtbHNocSIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzI2NTg0MDAwLCJleHAiOjIwNDIxNjAwMDB9.YOUR_ANON_KEY_HERE');

      const input = document.getElementById('track-input');
      const btn = document.getElementById('track-btn');
      const errorEl = document.getElementById('error-msg');
      const results = document.getElementById('results-container');

      // Check URL for tracking param
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('num')) {
        input.value = urlParams.get('num');
        btn.click();
      }

      btn.addEventListener('click', async () => {
        const tracking = input.value.trim();
        if (!tracking) return;

        btn.textContent = 'Searching...';
        btn.disabled = true;
        errorEl.style.display = 'none';
        results.style.display = 'none';

        const { data, error } = await supabase.from('absl_shipments').select('*').eq('tracking_number', tracking).single();

        btn.textContent = 'Track';
        btn.disabled = false;

        if (error || !data) {
          errorEl.textContent = 'Shipment not found. Please check your tracking number.';
          errorEl.style.display = 'block';
          return;
        }

        // Populate Data
        document.getElementById('res-tracking').textContent = data.tracking_number;
        document.getElementById('res-status').textContent = data.status.replace(/_/g, ' ');
        document.getElementById('res-origin').textContent = data.origin;
        document.getElementById('res-dest').textContent = data.destination;

        // Build Timeline
        const timeline = document.getElementById('timeline');
        timeline.innerHTML = '';
        
        // Reverse history so newest is on top
        const history = [...(data.history || [])].reverse();
        
        history.forEach((h, i) => {
          const isLatest = i === 0;
          timeline.innerHTML += `
            <div style="display:flex; gap:16px;">
              <div style="display:flex; flex-direction:column; align-items:center;">
                <div style="width:12px; height:12px; border-radius:50%; background:${isLatest ? 'var(--gold)' : 'var(--line-light)'}; margin-top:4px;"></div>
                ${i !== history.length - 1 ? '<div style="width:2px; flex:1; background:var(--line-light); margin:4px 0;"></div>' : ''}
              </div>
              <div style="padding-bottom:16px;">
                <div style="font-weight:700; color:${isLatest ? 'var(--gold)' : 'var(--white)'}; text-transform:uppercase; font-size:0.9rem;">${h.status.replace(/_/g, ' ')}</div>
                <div style="color:var(--text-light); font-size:0.95rem;">${h.location}</div>
                <div style="color:var(--text-muted); font-size:0.8rem; font-family:var(--mono); margin-top:4px;">${new Date(h.timestamp).toLocaleString()}</div>
              </div>
            </div>
          `;
        });

        results.style.display = 'block';
      });
    });
  </script>
</Layout>