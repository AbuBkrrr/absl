---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Client Login - ABSL">
  <div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 24px;">
    <div style="background: var(--bg-card); border: 1px solid var(--line-light); border-radius: var(--r-md); padding: 48px; width: 100%; max-width: 450px;">
      
      <div style="text-align: center; margin-bottom: 32px;">
        <h1 id="page-title" style="font-family: var(--font-display); font-size: 2rem; color: var(--gold); margin-bottom: 8px;">Client Portal</h1>
        <p id="page-sub" style="color: var(--text-muted); font-size: 0.9rem;">Sign in to manage your bookings and rewards.</p>
      </div>

      <!-- GOOGLE SIGN IN BUTTON -->
      <button id="google-btn" class="btn" style="width: 100%; padding: 12px; background: #ffffff; color: #333; border: 1px solid #ddd; border-radius: 4px; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; margin-bottom: 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Continue with Google
      </button>

      <div id="divider" style="display: flex; align-items: center; gap: 10px; margin-bottom: 24px;">
        <div style="flex: 1; height: 1px; background: var(--line-light);"></div>
        <span style="font-family: var(--mono); font-size: 10px; color: var(--text-muted);">OR EMAIL</span>
        <div style="flex: 1; height: 1px; background: var(--line-light);"></div>
      </div>

      <form id="auth-form" style="display: flex; flex-direction: column; gap: 16px;">
        <div id="name-group" style="display: none;">
          <label style="font-family: var(--mono); font-size: 11px; color: var(--text-muted);">FULL NAME</label>
          <input id="f-name" type="text" placeholder="John Doe" style="width:100%; padding:12px; margin-top:4px; background: var(--bg-surface); border:1px solid var(--line-light); border-radius: 4px; color: var(--white);" />
        </div>

        <div>
          <label style="font-family: var(--mono); font-size: 11px; color: var(--text-muted);">EMAIL ADDRESS</label>
          <input id="f-email" type="email" required placeholder="john@company.com" style="width:100%; padding:12px; margin-top:4px; background: var(--bg-surface); border:1px solid var(--line-light); border-radius: 4px; color: var(--white);" />
        </div>

        <div id="password-group">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <label style="font-family: var(--mono); font-size: 11px; color: var(--text-muted);">PASSWORD</label>
            <button type="button" id="forgot-btn" style="background:none; border:none; color:var(--gold); font-size:0.8rem; cursor:pointer; text-decoration:underline;">Forgot?</button>
          </div>
          <input id="f-password" type="password" placeholder="••••••••" style="width:100%; padding:12px; margin-top:4px; background: var(--bg-surface); border:1px solid var(--line-light); border-radius: 4px; color: var(--white);" />
        </div>

        <button type="submit" id="auth-btn" class="btn btn-primary" style="margin-top: 8px; width: 100%;">Sign In</button>
      </form>

      <div style="text-align: center; margin-top: 24px;">
        <button id="toggle-btn" style="background: none; border: none; color: var(--text-muted); font-size: 0.85rem; cursor: pointer; text-decoration: underline;">
          Don't have an account? Sign Up
        </button>
      </div>

      <div id="error-msg" style="display: none; margin-top: 16px; padding: 12px; background: rgba(239,68,68,0.1); border: 1px solid #ef4444; color: #ef4444; font-size: 0.85rem; text-align: center; border-radius: 4px;"></div>
      <div id="success-msg" style="display: none; margin-top: 16px; padding: 12px; background: rgba(16,185,129,0.1); border: 1px solid #10B981; color: #10B981; font-size: 0.85rem; text-align: center; border-radius: 4px;"></div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const authForm = document.getElementById('auth-form');
    const title = document.getElementById('page-title');
    const sub = document.getElementById('page-sub');
    const nameGroup = document.getElementById('name-group');
    const passwordGroup = document.getElementById('password-group');
    const authBtn = document.getElementById('auth-btn');
    const toggleBtn = document.getElementById('toggle-btn');
    const forgotBtn = document.getElementById('forgot-btn');
    const errorMsg = document.getElementById('error-msg');
    const successMsg = document.getElementById('success-msg');
    const googleBtn = document.getElementById('google-btn');
    const divider = document.getElementById('divider');

    let mode = 'login'; // 'login', 'signup', 'forgot'

    function resetUI() {
      errorMsg.style.display = 'none';
      successMsg.style.display = 'none';
      authBtn.disabled = false;
    }

    // 1. Google Sign In
    googleBtn.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/account' }
      });
      if (error) alert(error.message);
    });

    // 2. Toggle Sign Up / Login
    toggleBtn.addEventListener('click', () => {
      mode = mode === 'login' ? 'signup' : 'login';
      resetUI();
      
      if (mode === 'signup') {
        title.textContent = 'Create Account';
        sub.textContent = 'Join ABSL to track your corporate travel.';
        nameGroup.style.display = 'block';
        passwordGroup.style.display = 'block';
        forgotBtn.style.display = 'none';
        authBtn.textContent = 'Create Account';
        toggleBtn.textContent = "Already have an account? Sign In";
        googleBtn.style.display = 'flex';
        divider.style.display = 'flex';
        document.getElementById('f-password').required = true;
      } else {
        title.textContent = 'Client Portal';
        sub.textContent = 'Sign in to manage your bookings and rewards.';
        nameGroup.style.display = 'none';
        passwordGroup.style.display = 'block';
        forgotBtn.style.display = 'block';
        authBtn.textContent = 'Sign In';
        toggleBtn.textContent = "Don't have an account? Sign Up";
        googleBtn.style.display = 'flex';
        divider.style.display = 'flex';
        document.getElementById('f-password').required = true;
      }
    });

    // 3. Forgot Password Flow
    forgotBtn.addEventListener('click', () => {
      mode = 'forgot';
      resetUI();
      title.textContent = 'Reset Password';
      sub.textContent = 'Enter your email and we will send you a reset link.';
      nameGroup.style.display = 'none';
      passwordGroup.style.display = 'none';
      authBtn.textContent = 'Send Reset Link';
      toggleBtn.textContent = "Back to Sign In";
      googleBtn.style.display = 'none';
      divider.style.display = 'none';
      document.getElementById('f-password').required = false;
    });

    // 4. Form Submit
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      resetUI();
      
      const email = document.getElementById('f-email').value.trim();
      const password = document.getElementById('f-password').value;
      const name = document.getElementById('f-name').value.trim();

      authBtn.textContent = 'Processing...';
      authBtn.disabled = true;

      try {
        if (mode === 'login') {
          const { error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) throw error;
          window.location.href = '/account';
        } 
        else if (mode === 'signup') {
          const { error } = await supabase.auth.signUp({
            email,
            password,
            options: { data: { full_name: name } }
          });
          if (error) throw error;
          successMsg.style.display = 'block';
          successMsg.textContent = 'Account created! Check your email to verify, then sign in.';
          authBtn.textContent = 'Create Account';
          authBtn.disabled = false;
        }
        else if (mode === 'forgot') {
          const { error } = await supabase.auth.resetPasswordForEmail(email, {
            redirectTo: window.location.origin + '/reset-password',
          });
          if (error) throw error;
          successMsg.style.display = 'block';
          successMsg.textContent = 'Password reset link sent! Check your email inbox.';
          authBtn.textContent = 'Send Reset Link';
          authBtn.disabled = false;
        }
      } catch (err) {
        errorMsg.style.display = 'block';
        errorMsg.textContent = err.message;
        authBtn.textContent = mode === 'login' ? 'Sign In' : mode === 'signup' ? 'Create Account' : 'Send Reset Link';
        authBtn.disabled = false;
      }
    });
  </script>
</Layout>