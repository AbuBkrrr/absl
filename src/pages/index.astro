---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: packages } = await supabase
  .from('absl_packages')
  .select('*')
  .eq('status', 'active')
  .limit(6);
---

<Layout title="ABSL | Executive Travel, Logistics & Construction">
  
  <!-- HERO WITH AIRBNB-STYLE SEARCH -->
  <section style="position:relative; padding: 40px 0 80px; background: linear-gradient(rgba(10, 17, 40, 0.85), rgba(10, 17, 40, 0.95)), url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?q=80&w=2074&auto=format&fit=crop'); background-size: cover; background-position: center; border-bottom: 1px solid var(--line);">
    <div class="container" style="position:relative; z-index:2;">
      <div style="max-width: 800px; margin-bottom: 48px;">
        <h1 style="font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 800; line-height: 1.1; margin-top: 0; margin-bottom: 24px; color: var(--white); letter-spacing: -0.5px;">
          Allstates Business Solutions <br> and Logistics Ltd
        </h1>
        <div style="display:flex; align-items:center; gap:16px; margin-bottom: 32px;">
          <div style="width: 60px; height: 2px; background: var(--gold);"></div>
          <span style="font-size: 0.95rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--gold);">Global Business Travel & Infrastructure</span>
        </div>
        <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 600px;">
          Allstates Business Solutions and Logistics Ltd provides corporate travel management, global freight forwarding, and premium construction services — trusted by businesses and executives worldwide.
        </p>
      </div>

      
    </div>
  </section>

  <!-- TRUST STATS -->
  <section style="background: var(--bg-surface); border-bottom: 1px solid var(--line-light); padding: 32px 0;">
    <div class="container" style="display:flex; justify-content:space-around; flex-wrap:wrap; gap:24px; text-align:center;">
      <div><div style="font-family:var(--font-display); font-size:2.2rem; color:var(--gold);">170+</div><div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; color:var(--text-muted);">Destinations</div></div>
      <div><div style="font-family:var(--font-display); font-size:2.2rem; color:var(--gold);">500+</div><div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; color:var(--text-muted);">Corporate Clients</div></div>
      <div><div style="font-family:var(--font-display); font-size:2.2rem; color:var(--gold);">12+</div><div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; color:var(--text-muted);">Years Experience</div></div>
      <div><div style="font-family:var(--font-display); font-size:2.2rem; color:var(--gold);">50+</div><div style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; color:var(--text-muted);">Projects Delivered</div></div>
    </div>
  </section>

  <!-- SERVICE PILLARS -->
  <section style="padding: 100px 0; background: var(--bg-main);">
    <div class="container">
      <div style="text-align:center; margin-bottom:64px;">
        <h2 style="font-size: 2.5rem; margin-bottom: 16px;">Our Core Pillars</h2>
        <div style="width: 60px; height: 2px; background: var(--gold); margin: 0 auto;"></div>
      </div>
      
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:32px;">
        <div style="background:var(--bg-surface); padding:48px 32px; border:1px solid var(--line-light); border-radius:var(--r-md);">
          <div style="font-size: 32px; margin-bottom: 24px;">✈️</div>
          <h3 style="font-size: 1.5rem; margin-bottom: 16px;">Travel & Tours</h3>
          <p style="color:var(--text-muted); font-size: 0.95rem; line-height:1.8; margin-bottom:24px;">Corporate ticketing, luxury hospitality, visa procurement, and protocol services with 24/7 traveler care.</p>
          <a href="/travel" style="color: var(--gold); font-size:0.85rem; font-weight:600; letter-spacing:1px; text-transform:uppercase;">Explore &rarr;</a>
        </div>
        <div style="background:var(--bg-surface); padding:48px 32px; border:1px solid var(--line-light); border-radius:var(--r-md);">
          <div style="font-size: 32px; margin-bottom: 24px;">🚢</div>
          <h3 style="font-size: 1.5rem; margin-bottom: 16px;">Global Logistics</h3>
          <p style="color:var(--text-muted); font-size: 0.95rem; line-height:1.8; margin-bottom:24px;">End-to-end freight forwarding, customs clearance, and secure delivery with real-time tracking and global coverage.</p>
          <a href="/logistics" style="color: var(--gold); font-size:0.85rem; font-weight:600; letter-spacing:1px; text-transform:uppercase;">Explore &rarr;</a>
        </div>
        <div style="background:var(--bg-surface); padding:48px 32px; border:1px solid var(--line-light); border-radius:var(--r-md);">
          <div style="font-size: 32px; margin-bottom: 24px;">🏗️</div>
          <h3 style="font-size: 1.5rem; margin-bottom: 16px;">Construction</h3>
          <p style="color:var(--text-muted); font-size: 0.95rem; line-height:1.8; margin-bottom:24px;">Premium residential and commercial builds, from architectural design to project handover, with 10-year structural backing.</p>
          <a href="/construction" style="color: var(--gold); font-size:0.85rem; font-weight:600; letter-spacing:1px; text-transform:uppercase;">Explore &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED PACKAGES (Airbnb Style) -->
  <section style="padding: 100px 0; background: #050914; border-top: 1px solid var(--line-light); border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom: 48px;">
        <div>
          <h2 style="font-size: 2.2rem; margin-bottom: 12px;">Featured Packages</h2>
          <p style="color:var(--text-muted);">Curated travel and logistics solutions with transparent pricing.</p>
        </div>
        <a href="/services" style="color: var(--gold); font-weight: 600; font-size: 0.9rem; letter-spacing: 1px; text-transform: uppercase;">View All &rarr;</a>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:24px;">
        {packages?.map(pkg => (
          <a href={`/services/${pkg.id}`} style="display:flex; flex-direction:column; background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px; transition:0.3s;" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--line-light)'">
            <div style="font-size:0.7rem; text-transform:uppercase; letter-spacing:1.5px; color:var(--gold); margin-bottom:16px;">{pkg.category}</div>
            <h3 style="font-size:1.3rem; margin-bottom:12px; color:var(--white);">{pkg.title}</h3>
            <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:20px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">{pkg.description}</p>
            <div style="margin-top:auto; padding-top:16px; border-top:1px solid var(--line-light); display:flex; justify-content:space-between; align-items:center;">
              <span style="font-weight:600; color:var(--gold); font-size:1.1rem;">₦{Number(pkg.price).toLocaleString()}</span>
              <span style="font-size:0.8rem; color:var(--text-muted); border:1px solid var(--gold); padding:4px 12px; border-radius:var(--r-sm);">Book Now</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONSTRUCTION PORTFOLIO (Royal Craft Style) -->
  <section style="padding: 100px 0; background: var(--bg-main);">
    <div class="container">
      <div style="text-align:center; margin-bottom:64px;">
        <h2 style="font-size: 2.5rem; margin-bottom: 16px;">Construction Portfolio</h2>
        <p style="color:var(--text-muted); max-width:600px; margin:0 auto;">From luxury residential remodels to commercial infrastructure, we deliver with certified craftsmanship and a 10-year installation guarantee.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:24px;">
        <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
          <div style="height:240px; background: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
          <div style="padding:24px; background:var(--bg-card);">
            <div style="font-size:0.75rem; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Residential Remodel</div>
            <h3 style="font-size:1.2rem; margin-bottom:8px;">Lekki Penthouse Renovation</h3>
            <p style="color:var(--text-muted); font-size:0.85rem;">Full structural remodel with premium finishes. Budget: ₦45M.</p>
          </div>
        </div>
        <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
          <div style="height:240px; background: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
          <div style="padding:24px; background:var(--bg-card);">
            <div style="font-size:0.75rem; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Commercial Build</div>
            <h3 style="font-size:1.2rem; margin-bottom:8px;">Abuja Corporate HQ</h3>
            <p style="color:var(--text-muted); font-size:0.85rem;">5-storey office complex with LEED certification. Budget: ₦320M.</p>
          </div>
        </div>
        <div style="border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
          <div style="height:240px; background: url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=2070&auto=format&fit=crop') center/cover;"></div>
          <div style="padding:24px; background:var(--bg-card);">
            <div style="font-size:0.75rem; color:var(--gold); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Infrastructure</div>
            <h3 style="font-size:1.2rem; margin-bottom:8px;">Kano Logistics Warehouse</h3>
            <p style="color:var(--text-muted); font-size:0.85rem;">10,000 sqm cold-storage facility. Budget: ₦180M.</p>
          </div>
        </div>
      </div>
      <div style="text-align:center; margin-top:48px;">
        <a href="/portfolio" class="btn btn-outline" style="padding:14px 40px;">View Full Portfolio &rarr;</a>
      </div>
    </div>
  </section>

  <!-- CORPORATE TRAVEL FEATURES (Amex GBT Style) -->
    <!-- MILEAGEMALL PROMO -->
  <section style="padding: 80px 0; background: #f0f2f8; border-top: 1px solid var(--line-light); text-align: center;">
    <div class="container">
      <div style="background: white; border-radius: 24px; padding: 60px 40px; box-shadow: 0 20px 40px rgba(0,0,0,0.05); max-width: 900px; margin: 0 auto; border: 1px solid #e3eaf2;">
        <h2 style="font-family: 'Inter', sans-serif; font-size: 2.5rem; color: #0b1e3a; margin-bottom: 16px; font-weight: 800;">
          <span style="color: #1e5f9e;">✈️</span> MileageMall Rewards Hub
        </h2>
        <p style="color: #4a6a8a; font-size: 1.1rem; max-width: 600px; margin: 0 auto 32px; font-family: 'Inter', sans-serif;">
          One Hub. Every Airline. Max Rewards. Track your corporate loyalty miles, find shopping multipliers, and offset your carbon footprint — all in one dashboard.
        </p>
        <a href="/rewards" style="background: #0b1e3a; color: white; padding: 16px 48px; border-radius: 40px; font-weight: 700; text-decoration: none; font-size: 1rem; display: inline-block; transition: 0.2s;">
          Launch Rewards Dashboard
        </a>
      </div>
    </div>
  </section>

  <section style="padding: 100px 0; background: var(--bg-surface); border-top: 1px solid var(--line-light); border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:64px; align-items:center;">
        <div>
          <div style="font-size:0.8rem; text-transform:uppercase; letter-spacing:2px; color:var(--gold); margin-bottom:16px;">For Travel Managers & Executives</div>
          <h2 style="font-size: 2.8rem; margin-bottom:24px;">Corporate Travel, Simplified.</h2>
          <p style="color:var(--text-muted); font-size:1rem; line-height:1.9; margin-bottom:32px;">Manage policy compliance, traveler preferences, and expense reporting from one unified platform. Our AI-powered booking tool ensures your team gets the best available rates while staying within budget.</p>
          <ul style="list-style:none; color:var(--text-light); font-size:0.95rem; line-height:2.2;">
            <li>✓ Centralized policy management</li>
            <li>✓ Real-time booking transparency</li>
            <li>✓ 24/7 traveler care & crisis response</li>
            <li>✓ Automated expense integration</li>
          </ul>
        </div>
        <div style="background: var(--bg-card); border: 1px solid var(--line); padding: 40px; border-radius: var(--r-md);">
          <div style="font-family: var(--font-display); font-size: 1.3rem; margin-bottom: 24px; color: var(--gold);">Client Dashboard Preview</div>
          <div style="display:flex; flex-direction:column; gap:16px;">
            <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line-light); padding-bottom:12px;"><span style="color:var(--text-muted);">Upcoming Trip</span><span style="color:var(--white); font-weight:600;">Lagos → London (Oct 24)</span></div>
            <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line-light); padding-bottom:12px;"><span style="color:var(--text-muted);">Policy Status</span><span style="color:var(--green); font-weight:600;">Compliant</span></div>
            <div style="display:flex; justify-content:space-between; border-bottom:1px solid var(--line-light); padding-bottom:12px;"><span style="color:var(--text-muted);">Expense Sync</span><span style="color:var(--white); font-weight:600;">Auto-Integrated</span></div>
            <div style="margin-top:16px;"><a href="/contact" class="btn btn-primary" style="width:100%; text-align:center;">Request Corporate Access</a></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 100px 0; background: var(--bg-main); text-align:center;">
    <div class="container">
      <h2 style="font-size: 2.8rem; margin-bottom: 20px;">Ready to Plan Your Next Move?</h2>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px; margin:0 auto 40px;">Whether it's a boardroom in London, a container in Lagos, or a foundation in Abuja — ABSL delivers.</p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
        <a href="/services" class="btn btn-primary" style="padding:16px 48px;">Book a Service</a>
        <a href="/contact" class="btn btn-outline" style="padding:16px 48px;">Speak to an Expert</a>
      </div>
    </div>
  </section>

</Layout>