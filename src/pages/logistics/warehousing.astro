---
import Layout from '../../layouts/Layout.astro';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Automated Warehousing - ABSL">
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <a href="/logistics" style="color: var(--gold); font-family: var(--mono); font-size: 12px; text-decoration: none; margin-bottom: 16px; display: inline-block;">&larr; Back to Logistics</a>
      <h1 style="font-size:2.5rem; margin-bottom:8px;">Warehouse Management System</h1>
      <p style="color:var(--text-muted); max-width: 600px;">Monitor your stock levels, track fulfillment, and receive automated reorder alerts across our 140,000 SQM facilities.</p>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px; max-width: 1000px;">
    
    <!-- Top Features -->
    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:24px; margin-bottom:48px;">
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
        <div style="font-size:24px; margin-bottom:12px;">📊</div>
        <h3 style="font-size:1.1rem; color:var(--white); margin-bottom:8px;">Real-Time Inventory</h3>
        <p style="font-size:0.85rem; color:var(--text-muted);">Live SKU tracking synced directly from the warehouse floor.</p>
      </div>
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
        <div style="font-size:24px; margin-bottom:12px;">🔔</div>
        <h3 style="font-size:1.1rem; color:var(--white); margin-bottom:8px;">Automated Alerts</h3>
        <p style="font-size:0.85rem; color:var(--text-muted);">Get notified when stock hits the reorder level before you run out.</p>
      </div>
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
        <div style="font-size:24px; margin-bottom:12px;">📦</div>
        <h3 style="font-size:1.1rem; color:var(--white); margin-bottom:8px;">Smart Fulfillment</h3>
        <p style="font-size:0.85rem; color:var(--text-muted);">Trigger pick-and-pack operations with a single click.</p>
      </div>
    </div>

    <!-- Add Inventory Form -->
    <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; margin-bottom:32px;">
      <h2 style="font-size:1.2rem; color:var(--gold); margin-bottom:20px;">Add Inbound Stock</h2>
      <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr; gap:16px;">
        <input id="f-client" type="text" placeholder="Client Name" style="padding:12px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        <input id="f-sku" type="text" placeholder="SKU (e.g. SKU-001)" style="padding:12px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        <input id="f-name" type="text" placeholder="Product Name" style="padding:12px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        <input id="f-qty" type="number" placeholder="Quantity" style="padding:12px; background:var(--bg-card); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        <button id="add-btn" class="btn btn-primary">Add Stock</button>
      </div>
    </div>

    <!-- Inventory Table -->
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      <table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="background:var(--bg-surface); text-align:left;">
            <th style="padding:16px; color:var(--gold);">SKU</th>
            <th style="padding:16px; color:var(--gold);">Product</th>
            <th style="padding:16px; color:var(--gold);">Client</th>
            <th style="padding:16px; color:var(--gold); text-align:center;">Stock Level</th>
            <th style="padding:16px; color:var(--gold); text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody id="inventory-body">
          <tr><td colspan="5" style="padding:32px; text-align:center; color:var(--text-muted);">Loading inventory...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" style="position:fixed; bottom:24px; right:24px; z-index:9999; display:flex; flex-direction:column; gap:10px;"></div>

  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    let supabaseClient = null;

    async function getSupabase() {
      if (supabaseClient) return supabaseClient;
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      supabaseClient = createClient(supabaseUrl, supabaseAnonKey);
      return supabaseClient;
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const bgColor = type === 'success' ? 'var(--green)' : (type === 'error' ? '#ef4444' : 'var(--gold)');
      const icon = type === 'success' ? '✓' : (type === 'error' ? '✕' : 'ℹ');
      
      toast.style.cssText = `background: var(--bg-card); border: 1px solid ${bgColor}; color: var(--white); padding: 16px 24px; border-radius: var(--r-md); font-family: var(--font-body); font-weight: 600; box-shadow: 0 10px 30px rgba(0,0,0,0.5); display: flex; align-items: center; gap: 12px; transform: translateY(100%); opacity: 0; transition: all 0.3s ease;`;
      toast.innerHTML = `<span style="color:${bgColor}; font-size:1.2rem;">${icon}</span> ${message}`;
      container.appendChild(toast);
      setTimeout(() => { toast.style.transform = 'translateY(0)'; toast.style.opacity = '1'; }, 10);
      setTimeout(() => { toast.style.transform = 'translateY(100%)'; toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
    }

    async function loadInventory() {
      const tbody = document.getElementById('inventory-body');
      const supabase = await getSupabase();
      const { data, error } = await supabase.from('absl_warehouse_inventory').select('*').order('created_at', { ascending: false });

      if (error) {
        tbody.innerHTML = `<tr><td colspan="5" style="padding:32px; text-align:center; color:#ef4444;">Error loading inventory.</td></tr>`;
        return;
      }

      if (data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="padding:32px; text-align:center; color:var(--text-muted);">No inventory found. Add some stock above.</td></tr>`;
        return;
      }

      tbody.innerHTML = data.map(item => {
        const isLowStock = item.quantity <= item.reorder_level;
        const stockBadge = isLowStock 
          ? `<span style="background:#ef4444; color:white; padding:4px 8px; border-radius:4px; font-size:10px;">LOW: ${item.quantity}</span>`
          : `<span style="background:var(--bg-surface); color:var(--white); padding:4px 8px; border-radius:4px;">${item.quantity}</span>`;

        return `
          <tr style="border-top:1px solid var(--line-light);">
            <td style="padding:16px; color:var(--gold); font-weight:600;">${item.sku}</td>
            <td style="padding:16px; color:var(--white);">${item.product_name}</td>
            <td style="padding:16px; color:var(--text-muted);">${item.client_name}</td>
            <td style="padding:16px; text-align:center;">
              ${stockBadge}
              ${isLowStock ? '<div style="font-size:10px; color:#ef4444; margin-top:4px;">Reorder Alert</div>' : ''}
            </td>
            <td style="padding:16px; text-align:right;">
              <button data-id="${item.id}" data-qty="${item.quantity}" class="fulfill-btn" style="background:transparent; border:1px solid var(--gold); color:var(--gold); padding:4px 12px; border-radius:4px; cursor:pointer; font-size:11px;">Fulfill 5 Units</button>
            </td>
          </tr>
        `;
      }).join('');

      // Attach Fulfill Logic
      document.querySelectorAll('.fulfill-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = e.target.dataset.id;
          const currentQty = Number(e.target.dataset.qty);
          
          if (currentQty < 5) return showToast('Not enough stock to fulfill 5 units.', 'error');

          e.target.textContent = 'Processing...';
          e.target.disabled = true;

          const supabase = await getSupabase();
          const { error } = await supabase.from('absl_warehouse_inventory').update({ quantity: currentQty - 5 }).eq('id', id);

          if (error) {
            showToast('Failed to fulfill order.', 'error');
            e.target.textContent = 'Fulfill 5 Units';
            e.target.disabled = false;
          } else {
            showToast('Order fulfilled! Stock updated.', 'success');
            loadInventory(); // Reload table
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadInventory();

      document.getElementById('add-btn').addEventListener('click', async () => {
        const client = document.getElementById('f-client').value.trim();
        const sku = document.getElementById('f-sku').value.trim();
        const name = document.getElementById('f-name').value.trim();
        const qty = Number(document.getElementById('f-qty').value);

        if (!client || !sku || !name || !qty) return showToast('Please fill all fields.', 'error');

        const btn = document.getElementById('add-btn');
        btn.textContent = 'Adding...'; btn.disabled = true;

        const supabase = await getSupabase();
        const { error } = await supabase.from('absl_warehouse_inventory').insert({
          client_name: client, sku: sku, product_name: name, quantity: qty, reorder_level: 10
        });

        if (error) {
          showToast(error.message, 'error');
          btn.textContent = 'Add Stock'; btn.disabled = false;
        } else {
          showToast('Stock added successfully!', 'success');
          document.getElementById('f-client').value = '';
          document.getElementById('f-sku').value = '';
          document.getElementById('f-name').value = '';
          document.getElementById('f-qty').value = '';
          btn.textContent = 'Add Stock'; btn.disabled = false;
          loadInventory();
        }
      });
    });
  </script>
</Layout>