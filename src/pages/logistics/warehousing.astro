---
import Layout from '../../layouts/Layout.astro';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Client Inventory Dashboard - ABSL">
  <div style="background: var(--bg-surface); padding: 60px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <a href="/logistics" style="color: var(--gold); font-family: var(--mono); font-size: 12px; text-decoration: none; margin-bottom: 16px; display: inline-block;">&larr; Back to Logistics</a>
      <h1 style="font-size:2.5rem; margin-bottom:8px;">Your Inventory Dashboard</h1>
      <p style="color:var(--text-muted); max-width: 600px;">Monitor your real-time stock levels and automated reorder alerts across our 140,000 SQM facilities.</p>
    </div>
  </div>

  <div class="container" style="padding: 60px 24px; max-width: 1000px;">
    
    <!-- Top Features -->
    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:24px; margin-bottom:48px;">
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
        <div style="font-size:24px; margin-bottom:12px;">📊</div>
        <h3 style="font-size:1.1rem; color:var(--white); margin-bottom:8px;">Real-Time Inventory</h3>
        <p style="font-size:0.85rem; color:var(--text-muted);">Live SKU tracking synced directly from the warehouse floor.</p>
      </div>
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
        <div style="font-size:24px; margin-bottom:12px;">🔔</div>
        <h3 style="font-size:1.1rem; color:var(--white); margin-bottom:8px;">Automated Alerts</h3>
        <p style="font-size:0.85rem; color:var(--text-muted);">Get notified when stock hits the reorder level before you run out.</p>
      </div>
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:24px;">
        <div style="font-size:24px; margin-bottom:12px;">📦</div>
        <h3 style="font-size:1.1rem; color:var(--white); margin-bottom:8px;">Smart Fulfillment</h3>
        <p style="font-size:0.85rem; color:var(--text-muted);">Contact your account manager to trigger pick-and-pack operations.</p>
      </div>
    </div>

    <!-- Read-Only Inventory Table -->
    <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); overflow:hidden;">
      <div style="padding:20px; background:var(--bg-surface); border-bottom:1px solid var(--line-light);">
        <h2 style="font-size:1.1rem; color:var(--gold); margin:0;">Current Stock Levels</h2>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:48px;">
  <a href="/account" class="btn btn-primary" style="padding:16px; text-align:center; text-decoration:none;">Request Warehouse Space &rarr;</a>
  <a href="/account" class="btn btn-outline" style="padding:16px; text-align:center; text-decoration:none;">Contact Support &rarr;</a>
</div>
<table style="width:100%; border-collapse:collapse; font-family:var(--mono); font-size:12.5px;">
        <thead>
          <tr style="text-align:left;">
            <th style="padding:16px; color:var(--text-muted); font-weight:normal;">SKU</th>
            <th style="padding:16px; color:var(--text-muted); font-weight:normal;">Product</th>
            <th style="padding:16px; color:var(--text-muted); font-weight:normal;">Client</th>
            <th style="padding:16px; color:var(--text-muted); font-weight:normal; text-align:center;">Stock Level</th>
          </tr>
        </thead>
        <tbody id="inventory-body">
          <tr><td colspan="4" style="padding:32px; text-align:center; color:var(--text-muted);">Loading inventory...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    document.addEventListener('DOMContentLoaded', async () => {
      const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm');
      const supabase = createClient(supabaseUrl, supabaseAnonKey);

      const tbody = document.getElementById('inventory-body');
      const { data, error } = await supabase.from('absl_warehouse_inventory').select('*').order('created_at', { ascending: false });

      if (error || data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" style="padding:32px; text-align:center; color:var(--text-muted);">No inventory found.</td></tr>`;
        return;
      }

      tbody.innerHTML = data.map(item => {
        const isLowStock = item.quantity <= item.reorder_level;
        const stockBadge = isLowStock 
          ? `<span style="background:rgba(239,68,68,0.15); color:#ef4444; padding:4px 8px; border-radius:4px; font-size:10px; font-weight:bold;">LOW STOCK</span>`
          : `<span style="background:rgba(15,123,74,0.15); color:var(--green); padding:4px 8px; border-radius:4px; font-size:10px; font-weight:bold;">HEALTHY</span>`;

        return `
          <tr style="border-top:1px solid var(--line-light);">
            <td style="padding:16px; color:var(--gold); font-weight:600;">${item.sku}</td>
            <td style="padding:16px; color:var(--white);">${item.product_name}</td>
            <td style="padding:16px; color:var(--text-muted);">${item.client_name}</td>
            <td style="padding:16px; text-align:center;">
              <div style="font-size:1.1rem; color:var(--white); margin-bottom:4px;">${item.quantity} units</div>
              ${stockBadge}
            </td>
          </tr>
        `;
      }).join('');
    });
  </script>
</Layout>