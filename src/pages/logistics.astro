---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: settings } = await supabase.from('absl_settings').select('*');
const getVal = (key, defaultVal) => settings?.find(s => s.key === key)?.value || defaultVal;

const baseRate = Number(getVal('logistics_base_rate', 15000));
const domMulti = Number(getVal('logistics_domestic_multiplier', 1.2));
const intMulti = Number(getVal('logistics_international_multiplier', 2.5));
const domCitiesString = getVal('logistics_domestic_cities', 'lagos, abuja, kano, kaduna, sokoto, katsina, borno, port harcourt');
const domCities = domCitiesString.split(',').map(c => c.trim().toLowerCase());
const distRate = Number(getVal('logistics_distance_rate', 5));

const settingsJson = JSON.stringify({ baseRate, domMulti, intMulti, domCities, distRate });
---

<Layout title="Global Logistics - ABSL">
  <div style="background: var(--bg-surface); padding: 80px 0; border-bottom: 1px solid var(--line-light);">
    <div class="container">
      <h1 style="font-size:3rem; margin-bottom:16px;">Global Logistics</h1>
      <p style="color:var(--text-muted); font-size:1.1rem; max-width:600px;">End-to-end freight forwarding, customs clearance, and secure delivery with real-time tracking and global coverage.</p>
    </div>
  </div>

  <div class="container" style="padding: 80px 0;">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap:40px;">
      
      <!-- LEFT COLUMN: FORM -->
      <div style="background:var(--bg-card); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px;">
        <h3 style="font-size:1.5rem; color:var(--gold); margin-bottom:24px; font-family:var(--font-display);">Shipment Details</h3>
        
        <div style="margin-bottom:20px;">
          <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">FREIGHT TYPE</label>
          <select id="freight-type" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;">
            <option value="Ground / Road Freight">Ground / Road Freight</option>
            <option value="Air Freight (Express)">Air Freight (Express)</option>
            <option value="Sea Freight">Sea Freight</option>
          </select>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:20px;">
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">ORIGIN</label>
            <input id="origin" type="text" value="kano" placeholder="e.g. Kano" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-bottom:6px;">DESTINATION</label>
            <input id="dest" type="text" value="lagos" placeholder="e.g. Lagos" style="width:100%; padding:12px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
        </div>

        <h4 style="font-size:1.2rem; color:var(--white); margin-bottom:16px; margin-top:32px;">Package Dimensions</h4>
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; margin-bottom:16px;">
          <div>
            <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--text-muted); margin-bottom:4px;">LENGTH (cm)</label>
            <input id="length" type="number" value="5" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--text-muted); margin-bottom:4px;">WIDTH (cm)</label>
            <input id="width" type="number" value="5" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
          <div>
            <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--text-muted); margin-bottom:4px;">HEIGHT (cm)</label>
            <input id="height" type="number" value="5" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
          </div>
        </div>
        <div style="margin-bottom:32px;">
          <label style="display:block; font-family:var(--mono); font-size:10px; color:var(--gold); margin-bottom:4px;">ACTUAL KG</label>
          <input id="weight" type="number" value="5" style="width:100%; padding:10px; background:var(--bg-surface); border:1px solid var(--line-light); color:var(--white); border-radius:4px;" />
        </div>

        <button id="calc-btn" class="btn btn-primary" style="width:100%;">Calculate Estimate</button>
      </div>

      <!-- RIGHT COLUMN: RESULTS -->
      <div style="background:var(--bg-surface); border:1px solid var(--line-light); border-radius:var(--r-md); padding:32px; display:flex; flex-direction:column;">
        <div style="text-align:center; margin-bottom:24px;">
          <div id="res-route" style="color:var(--text-muted); font-size:0.9rem; margin-bottom:8px;">kano &rarr; lagos</div>
          <div style="font-family:var(--mono); font-size:11px; color:var(--gold); text-transform:uppercase; letter-spacing:1px;">Estimated Cost</div>
          <div id="res-total" style="font-family:var(--font-display); font-size:2.5rem; font-weight:700; color:var(--white); margin:12px 0;">₦0</div>
          <div style="font-size:0.85rem; color:var(--text-muted);">2 - 4 Business Days (Domestic)</div>
        </div>

        <div style="border-top:1px solid var(--line-light); padding-top:24px; display:flex; flex-direction:column; gap:12px; font-size:0.95rem;">
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-muted);">Actual Weight:</span>
            <span id="res-actual" style="color:var(--white);">0 kg</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-muted);">Volumetric Weight:</span>
            <span id="res-volume" style="color:var(--white);">0.00 kg</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--gold);">Chargeable Weight:</span>
            <span id="res-chargeable" style="color:var(--gold); font-weight:600;">0 kg</span>
          </div>
          
          <div style="display:flex; justify-content:space-between; border-top:1px dashed var(--line-light); padding-top:12px; margin-top:8px;">
            <span style="color:var(--text-muted);">Calculated Distance:</span>
            <span id="res-distance" style="color:var(--white); font-weight:600;">0 km</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-muted);">Base Rate:</span>
            <span id="res-base-rate" style="color:var(--white); font-weight:600;">₦0</span>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-muted);">Distance Charge:</span>
            <span id="res-dist-charge" style="color:var(--white); font-weight:600;">₦0</span>
          </div>
        </div>

        <div style="margin-top:auto; padding-top:32px;">
          <a href="/contact" class="btn btn-outline" style="width:100%; text-align:center;">Book This Shipment</a>
        </div>
      </div>

    </div>
  </div>

  <!-- Hidden JSON for Settings -->
  <script type="application/json" id="calc-settings" set:html={settingsJson}></script>

    <script>
    const locations = {
      // Nigeria
      "kano": [12.0022, 8.5920], "lagos": [6.5244, 3.3792], "abuja": [9.0765, 7.3986], "kaduna": [10.5105, 7.4165], "katsina": [12.9908, 7.6018], "borno": [11.8333, 13.1500], "maiduguri": [11.8333, 13.1500], "port harcourt": [4.8156, 7.0498], "ibadan": [7.3775, 3.9470], "enugu": [6.4584, 7.5464], "jos": [9.8965, 8.8583], "benin city": [6.3350, 5.6037], "sokoto": [13.0059, 5.2476], "yola": [9.2035, 12.4954], "owerri": [5.4836, 7.0333], "uyo": [5.0378, 7.9128], "calabar": [4.9757, 8.3417], "makurdi": [7.7337, 8.5133], "lokoja": [7.8023, 6.7333], "asaba": [6.1980, 6.7240], "akure": [7.2571, 5.2058], "abeokuta": [7.1475, 3.3619], "osogbo": [7.7827, 4.5418], "ilorin": [8.4966, 4.5421], "minna": [9.6139, 6.5569], "bauchi": [10.3103, 9.8438], "gombe": [10.2897, 11.1673], "damaturu": [11.7479, 11.9608], "dutse": [11.7566, 9.3386], "gusau": [12.1628, 6.6614], "birnin kebbi": [12.4539, 4.1975], "awka": [6.2109, 7.0740], "umuahia": [5.5333, 7.4833], "yenagoa": [4.9247, 6.2642], "jalingo": [8.8921, 11.3771], "lafia": [8.4939, 8.5155],
      // International
      "london": [51.5074, -0.1278], "dubai": [25.2048, 55.2708], "germany": [50.1109, 8.6821], "usa": [40.7128, -74.0060], "new york": [40.7128, -74.0060], "uk": [51.5074, -0.1278], "canada": [43.6510, -79.3470], "china": [31.2304, 121.4737], "india": [28.7041, 77.1025], "south africa": [-26.2041, 28.0473], "france": [48.8566, 2.3522], "italy": [41.9028, 12.4964], "spain": [40.4168, -3.7038], "brazil": [-23.5505, -46.6333], "australia": [-33.8688, 151.2093], "japan": [35.6762, 139.6503], "russia": [55.7558, 37.6173], "turkey": [41.0082, 28.9784], "egypt": [30.0444, 31.2357], "kenya": [-1.2921, 36.8219], "ghana": [5.6037, -0.1870]
    };

    function getDistanceFromLatLonInKm(lat1, lon1, lat2, lon2) {
      var R = 6371; 
      var dLat = (lat2-lat1) * (Math.PI/180);
      var dLon = (lon2-lon1) * (Math.PI/180); 
      var a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(lat1 * (Math.PI/180)) * Math.cos(lat2 * (Math.PI/180)) * Math.sin(dLon/2) * Math.sin(dLon/2); 
      var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); 
      return R * c;
    }

    const settings = JSON.parse(document.getElementById('calc-settings').textContent);

    document.getElementById('calc-btn').addEventListener('click', () => {
      const freightType = document.getElementById('freight-type').value;
      const weight = Number(document.getElementById('weight').value);
      const length = Number(document.getElementById('length').value);
      const width = Number(document.getElementById('width').value);
      const height = Number(document.getElementById('height').value);
      let origin = document.getElementById('origin').value.toLowerCase().trim();
      let dest = document.getElementById('dest').value.toLowerCase().trim();

      if (!weight || !length || !width || !height || !dest) {
        alert('Please fill in all fields.');
        return;
      }

      const volumetricWeight = (length * width * height) / 5000;
      const chargeableWeight = Math.max(weight, volumetricWeight);

      let originCoords = locations[origin] || locations['kano'];
      let destCoords = locations[dest];

      if (!destCoords) {
        alert(`We could not find coordinates for "${dest}". Please check spelling.`);
        return;
      }

      const distance = getDistanceFromLatLonInKm(originCoords[0], originCoords[1], destCoords[0], destCoords[1]);

      let isDomestic = settings.domCities.includes(dest) || (destCoords[0] > 4 && destCoords[0] < 14 && destCoords[1] > 2 && destCoords[1] < 15);
      let regionalMultiplier = isDomestic ? Number(settings.domMulti) : Number(settings.intMulti);

      // NEW: Freight Type Multipliers
      let freightMultiplier = 1.0;
      if (freightType.includes('Air')) freightMultiplier = 3.5; // Air is 3.5x more expensive
      else if (freightType.includes('Sea')) freightMultiplier = 0.8; // Sea is 20% cheaper (but slow)

      // Math (ensure all Numbers)
      const baseWeightCost = chargeableWeight * Number(settings.baseRate);
      const distanceCost = distance * Number(settings.distRate);
      
      // Final Formula: (Weight Cost + Distance Cost) * Regional * Freight Type
      const finalCost = Math.round((baseWeightCost + distanceCost) * regionalMultiplier * freightMultiplier);

      // Update UI
      document.getElementById('res-route').innerHTML = `${origin} &rarr; ${dest}`;
      document.getElementById('res-actual').textContent = weight + ' kg';
      document.getElementById('res-volume').textContent = volumetricWeight.toFixed(2) + ' kg';
      document.getElementById('res-chargeable').textContent = chargeableWeight.toFixed(2) + ' kg';
      
      document.getElementById('res-distance').textContent = Math.round(distance).toLocaleString() + ' km';
      document.getElementById('res-base-rate').textContent = '₦' + Math.round(baseWeightCost).toLocaleString();
      document.getElementById('res-dist-charge').textContent = '₦' + Math.round(distanceCost).toLocaleString();
      document.getElementById('res-total').textContent = '₦' + finalCost.toLocaleString();
    });
  </script>
<section style="padding: 80px 0; background: var(--bg-main);">
    <div class="container">
        <div style="text-align: center; margin-bottom: 48px;">
            <h2 style="font-size: 2rem; margin-bottom: 12px;">Related Logistics Services</h2>
            <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">Get a formal quote or explore our warehousing solutions.</p>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <a href="/logistics/quote" style="background: var(--bg-card); border: 1px solid var(--line); padding: 32px; border-radius: var(--r-md); text-decoration: none;">
                <div style="font-size: 32px; margin-bottom: 16px;">&#128203;</div>
                <h3 style="color: var(--white); font-size: 1.3rem; margin-bottom: 8px; font-family: var(--font-display);">Request a Freight Quote</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Get detailed pricing for any shipment size or destination.</p>
            </a>
            <a href="/logistics/warehousing" style="background: var(--bg-card); border: 1px solid var(--line); padding: 32px; border-radius: var(--r-md); text-decoration: none;">
                <div style="font-size: 32px; margin-bottom: 16px;">&#127981;</div>
                <h3 style="color: var(--white); font-size: 1.3rem; margin-bottom: 8px; font-family: var(--font-display);">Warehousing &amp; Storage</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Secure, climate-controlled storage for goods in transit.</p>
            </a>
        </div>
    </div>
</section>
</Layout>